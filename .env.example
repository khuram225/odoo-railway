# ---------------------------------------------------------------------------
# odoo service  (build from ./odoo)
# ---------------------------------------------------------------------------

# Master password guarding the database-manager screens. Generate one:
#   openssl rand -hex 24
# Required -- the entrypoint refuses to start without it.
ODOO_ADMIN_PASSWD=replace-me-with-a-random-48-char-hex-string

# PostgreSQL connection. These are libpq variable names on purpose: the base
# image's entrypoint reads $PORT as the *PostgreSQL* port, so using its own
# HOST/PORT/USER/PASSWORD variables would collide with Railway's $PORT.
PGHOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432

# Must NOT be `postgres`: Odoo 19 exits at startup if the role is named that,
# and Railway's managed PostgreSQL hands out exactly that superuser.
PGUSER=odoo
PGPASSWORD=replace-me-with-a-random-48-char-hex-string

# Superuser connection used ONCE per boot to create/refresh the scoped role
# above, because a one-click deploy has no chance to run SQL by hand. On
# Railway set this to ${{Postgres.DATABASE_URL}}.
#
# The entrypoint runs, idempotently:
#   CREATE ROLE <PGUSER> WITH LOGIN CREATEDB NOSUPERUSER NOCREATEROLE
#     NOREPLICATION PASSWORD '<PGPASSWORD>';
# (ALTER on later boots, so rotating PGPASSWORD is enough.) CREATEDB is
# required: Odoo needs it to create, duplicate and restore databases, and to
# bootstrap the database named by db_name on first boot.
#
# Leave it unset if you provisioned the role yourself. You may also remove it
# after the first successful boot if you would rather the app never hold
# superuser credentials — but then remember to re-add it if you rotate
# PGPASSWORD.
BOOTSTRAP_DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Port Railway health-checks and routes to for this service.
PORT=8069

# ---------------------------------------------------------------------------
# odoo-proxy service  (build from ./proxy)
# ---------------------------------------------------------------------------

PORT=8080

# Private hostname of the Odoo service. Use a Railway reference rather than
# hardcoding it, so renaming the Odoo service cannot silently break the proxy.
# The entrypoint falls back to odoo.railway.internal if this is unset.
ODOO_UPSTREAM_HOST=${{odoo.RAILWAY_PRIVATE_DOMAIN}}
