<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_factor_group_list" model="ir.ui.view">
        <field name="name">print.factor.group.list</field>
        <field name="model">print.factor.group</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="calc_method"/></list>
        </field>
    </record>
    <record id="view_print_factor_group_form" model="ir.ui.view">
        <field name="name">print.factor.group.form</field>
        <field name="model">print.factor.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="code"/><field name="name"/></group>
                        <group><field name="calc_method"/><field name="active"/></group>
                    </group>
                    <notebook>
                        <page string="Config lines">
                            <field name="factor_ids" context="{'default_group_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/><field name="name"/><field name="input_variable"/>
                                    <field name="initial_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Used by work centres">
                            <field name="workcenter_ids" readonly="1">
                                <list><field name="code"/><field name="name"/><field name="workcenter_type"/></list>
                            </field>
                        </page>
                    </notebook>
                    <div class="text-muted">Min takes the lowest value any line allows (as in DynamicsPrint), Max the highest,
                        Average the mean, Multiply the product of all lines.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_factor_form" model="ir.ui.view">
        <field name="name">print.factor.form</field>
        <field name="model">print.factor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="group_id"/><field name="code"/><field name="name"/></group>
                        <group><field name="input_variable"/><field name="initial_value"/><field name="use_initial"/></group>
                    </group>
                    <group>
                        <group string="Diagram">
                            <field name="point_ids" nolabel="1" colspan="2">
                                <list editable="bottom"><field name="input_value"/><field name="output_value"/></list>
                            </field>
                        </group>
                        <group string="Chart">
                            <field name="diagram_svg" nolabel="1" colspan="2" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">Between points the output is interpolated in a straight line; below the first and above the last point it stays flat.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_print_factor_group" model="ir.actions.act_window">
        <field name="name">Factor groups</field>
        <field name="res_model">print.factor.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
