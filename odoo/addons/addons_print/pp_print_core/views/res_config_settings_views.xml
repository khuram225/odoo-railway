<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_print" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pp_print_core</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Print Production" string="Print Production" name="pp_print_core" groups="pp_print_core.group_print_manager">
                    <block title="Imposition" name="pp_print_imposition">
                        <setting id="pp_print_colour_strip" string="Colour strip depth" help="Depth of the colour bar printed on each sheet, in inches. It reduces the usable sheet height.">
                            <field name="print_colour_strip_in"/>
                        </setting>
                        <setting id="pp_print_gap" string="Gap between groups" help="Space between column and row groups on the sheet, in inches (trim or bleed).">
                            <field name="print_gap_in"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_print_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'pp_print_core', 'bin_size': False}</field>
    </record>
</odoo>
