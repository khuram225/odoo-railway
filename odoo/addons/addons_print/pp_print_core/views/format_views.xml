<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_format_list" model="ir.ui.view">
        <field name="name">print.format.list</field>
        <field name="model">print.format</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/><field name="name"/><field name="width_in"/><field name="height_in"/><field name="orientation"/>
            </list>
        </field>
    </record>
    <record id="action_print_format" model="ir.actions.act_window">
        <field name="name">Standard formats</field>
        <field name="res_model">print.format</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
