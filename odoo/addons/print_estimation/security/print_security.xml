<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_print" model="ir.module.category">
        <field name="name">Print Production</field>
        <field name="sequence">60</field>
    </record>
    <record id="res_groups_privilege_print" model="res.groups.privilege">
        <field name="name">Print Production</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_print"/>
    </record>
    <record id="group_print_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_print"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_print_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_print"/>
        <field name="implied_ids" eval="[(4, ref('group_print_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
