<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_product_group_list" model="ir.ui.view">
        <field name="name">print.product.group.list</field>
        <field name="model">print.product.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_print_product_group_form" model="ir.ui.view">
        <field name="name">print.product.group.form</field>
        <field name="model">print.product.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="code"/><field name="name"/></group>
                        <group><field name="sequence"/><field name="active"/></group>
                    </group>
                    <notebook>
                        <page string="Base products (L2)">
                            <field name="base_product_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="template_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_print_product_group" model="ir.actions.act_window">
        <field name="name">Product groups (L1)</field>
        <field name="res_model">print.product.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_print_base_product_list" model="ir.ui.view">
        <field name="name">print.base.product.list</field>
        <field name="model">print.base.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="group_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="template_type"/>
            </list>
        </field>
    </record>
    <record id="view_print_base_product_form" model="ir.ui.view">
        <field name="name">print.base.product.form</field>
        <field name="model">print.base.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="group_id"/><field name="code"/><field name="name"/></group>
                        <group><field name="template_type"/><field name="sequence"/><field name="active"/></group>
                    </group>
                    <field name="description" placeholder="What this base product covers"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_base_product_search" model="ir.ui.view">
        <field name="name">print.base.product.search</field>
        <field name="model">print.base.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="code"/><field name="group_id"/>
                <group>
                    <filter name="by_group" string="Product group" context="{'group_by': 'group_id'}"/>
                    <filter name="by_template" string="Template" context="{'group_by': 'template_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_print_base_product" model="ir.actions.act_window">
        <field name="name">Base products (L2)</field>
        <field name="res_model">print.base.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_group': 1}</field>
    </record>
</odoo>
