<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_cost_group_list" model="ir.ui.view">
        <field name="name">print.cost.group.list</field>
        <field name="model">print.cost.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/><field name="name"/>
                <field name="time_markup_pct"/><field name="material_markup_pct"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_print_cost_group" model="ir.actions.act_window">
        <field name="name">Cost groups</field>
        <field name="res_model">print.cost.group</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the cost groups (DynamicsPrint base groups)</p>
            <p>For example Prepress, Paper, Offset print, Digital print, Finishing, Binding, Packing, Delivery.
               Each has its own markup on time cost and on material.</p>
        </field>
    </record>
</odoo>
