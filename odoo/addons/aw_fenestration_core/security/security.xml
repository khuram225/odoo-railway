<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fenestration_privilege" model="res.groups.privilege">
        <field name="name">Fenestration</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- Loads and changes vendor rates. Everyone else only reads them. -->
    <record id="group_rates_manager" model="res.groups">
        <field name="name">Fenestration / Rates manager</field>
        <field name="privilege_id" ref="fenestration_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- The Manager includes it, so nobody who could load rates before
         loses the right. -->
    <record id="group_fenestration_manager" model="res.groups">
        <field name="name">Fenestration / Manager</field>
        <field name="privilege_id" ref="fenestration_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),
                                         (4, ref('group_rates_manager'))]"/>
    </record>

</odoo>
