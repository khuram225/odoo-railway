<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="window_kind_sliding" model="aw.window.kind">
            <field name="name">Sliding</field>
            <field name="code">SLIDING</field>
            <field name="sequence">10</field>
            <field name="allow_fixed" eval="True"/>
            <field name="allow_slider" eval="True"/>
            <field name="allow_casement" eval="False"/>
            <field name="allow_awning" eval="False"/>
            <field name="allow_hopper" eval="False"/>
            <field name="allow_mesh" eval="True"/>
            <field name="allow_tiltturn" eval="False"/>
        </record>

        <record id="window_kind_hinged" model="aw.window.kind">
            <field name="name">Hinged / Casement</field>
            <field name="code">HINGED</field>
            <field name="sequence">20</field>
            <field name="allow_fixed" eval="True"/>
            <field name="allow_slider" eval="False"/>
            <field name="allow_casement" eval="True"/>
            <field name="allow_awning" eval="True"/>
            <field name="allow_hopper" eval="True"/>
            <field name="allow_mesh" eval="True"/>
            <field name="allow_tiltturn" eval="False"/>
        </record>

        <record id="window_kind_fixed" model="aw.window.kind">
            <field name="name">Fixed only</field>
            <field name="code">FIXED</field>
            <field name="sequence">30</field>
            <field name="allow_fixed" eval="True"/>
            <field name="allow_slider" eval="False"/>
            <field name="allow_casement" eval="False"/>
            <field name="allow_awning" eval="False"/>
            <field name="allow_hopper" eval="False"/>
            <field name="allow_mesh" eval="False"/>
            <field name="allow_tiltturn" eval="False"/>
        </record>

        <record id="window_kind_tiltturn" model="aw.window.kind">
            <field name="name">Tilt &amp; Turn</field>
            <field name="code">TILTTURN</field>
            <field name="sequence">40</field>
            <field name="allow_fixed" eval="True"/>
            <field name="allow_slider" eval="False"/>
            <field name="allow_casement" eval="False"/>
            <field name="allow_awning" eval="False"/>
            <field name="allow_hopper" eval="False"/>
            <field name="allow_mesh" eval="False"/>
            <field name="allow_tiltturn" eval="True"/>
        </record>

    </data>
</odoo>
