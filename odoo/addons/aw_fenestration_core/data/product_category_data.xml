<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Root: no parent_id, a top-level category on its own. product.category
             has no mandatory single "All" root in this Odoo version, product's
             own seed data (product_category_goods, _expenses, _services) creates
             several independent top-level categories the same way. -->
        <record id="product_category_fenestration" model="product.category">
            <field name="name">Fenestration</field>
        </record>

        <!-- Profiles branch: one child per Window Series -->
        <record id="product_category_profiles" model="product.category">
            <field name="name">Profiles</field>
            <field name="parent_id" ref="product_category_fenestration"/>
        </record>
        <record id="product_category_profiles_box" model="product.category">
            <field name="name">Box Series</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>
        <record id="product_category_profiles_round" model="product.category">
            <field name="name">Round Series</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>
        <record id="product_category_profiles_collar" model="product.category">
            <field name="name">Collar Box Series</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>
        <record id="product_category_profiles_gsl" model="product.category">
            <field name="name">GSL Slim</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>
        <record id="product_category_profiles_hinged" model="product.category">
            <field name="name">Hinged / Casement</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>
        <record id="product_category_profiles_curtain" model="product.category">
            <field name="name">Curtain Wall</field>
            <field name="parent_id" ref="product_category_profiles"/>
        </record>

        <!-- Hardware branch: functional grouping, not per Window Type -->
        <record id="product_category_hardware" model="product.category">
            <field name="name">Hardware</field>
            <field name="parent_id" ref="product_category_fenestration"/>
        </record>
        <record id="product_category_hardware_rollers" model="product.category">
            <field name="name">Rollers &amp; Tracks</field>
            <field name="parent_id" ref="product_category_hardware"/>
        </record>
        <record id="product_category_hardware_locks" model="product.category">
            <field name="name">Locks &amp; Handles</field>
            <field name="parent_id" ref="product_category_hardware"/>
        </record>
        <record id="product_category_hardware_hinges" model="product.category">
            <field name="name">Hinges &amp; Stays</field>
            <field name="parent_id" ref="product_category_hardware"/>
        </record>
        <record id="product_category_hardware_mesh" model="product.category">
            <field name="name">Mesh Hardware</field>
            <field name="parent_id" ref="product_category_hardware"/>
        </record>
        <record id="product_category_hardware_gaskets" model="product.category">
            <field name="name">Gaskets &amp; Seals</field>
            <field name="parent_id" ref="product_category_hardware"/>
        </record>

        <!-- Glass branch -->
        <record id="product_category_glass" model="product.category">
            <field name="name">Glass</field>
            <field name="parent_id" ref="product_category_fenestration"/>
        </record>
        <record id="product_category_glass_toughened" model="product.category">
            <field name="name">Toughened</field>
            <field name="parent_id" ref="product_category_glass"/>
        </record>
        <record id="product_category_glass_dgu" model="product.category">
            <field name="name">DGU</field>
            <field name="parent_id" ref="product_category_glass"/>
        </record>

        <!-- Seed the six Window Series, linked to their Profile category and
             their Window Type. Series/Type mapping flagged for confirmation,
             not silently assumed; see chat reply. -->
        <record id="window_series_box" model="aw.window.series">
            <field name="name">Box Series</field>
            <field name="code">BOX</field>
            <field name="window_type_id" ref="window_type_sliding"/>
            <field name="sequence">10</field>
            <field name="product_category_id" ref="product_category_profiles_box"/>
        </record>
        <record id="window_series_round" model="aw.window.series">
            <field name="name">Round Series</field>
            <field name="code">ROUND</field>
            <field name="window_type_id" ref="window_type_sliding"/>
            <field name="sequence">20</field>
            <field name="product_category_id" ref="product_category_profiles_round"/>
        </record>
        <record id="window_series_collar" model="aw.window.series">
            <field name="name">Collar Box Series</field>
            <field name="code">COLLAR</field>
            <field name="window_type_id" ref="window_type_sliding"/>
            <field name="sequence">30</field>
            <field name="product_category_id" ref="product_category_profiles_collar"/>
        </record>
        <record id="window_series_gsl" model="aw.window.series">
            <field name="name">Double Glaze Slim (GSL)</field>
            <field name="code">GSL</field>
            <field name="window_type_id" ref="window_type_sliding"/>
            <field name="sequence">40</field>
            <field name="product_category_id" ref="product_category_profiles_gsl"/>
        </record>
        <record id="window_series_hinged" model="aw.window.series">
            <field name="name">Hinged / Casement Window</field>
            <field name="code">HINGED</field>
            <field name="window_type_id" ref="window_type_openable"/>
            <field name="sequence">50</field>
            <field name="product_category_id" ref="product_category_profiles_hinged"/>
        </record>
        <record id="window_series_curtain" model="aw.window.series">
            <field name="name">Curtain Wall</field>
            <field name="code">CURTAIN</field>
            <field name="window_type_id" ref="window_type_curtain_wall_fix"/>
            <field name="sequence">60</field>
            <field name="product_category_id" ref="product_category_profiles_curtain"/>
        </record>

    </data>
</odoo>
