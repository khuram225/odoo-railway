<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Replaces an earlier record-based file that set leaf_type_ids on all 8
    Series directly. That file re-asserted the full mapping on every
    upgrade, so any change made in the UI was silently reverted, which
    defeats the point of leaf types being data-driven at all.

    This calls a method that fills leaf_type_ids ONLY for a Series that
    has none, so it applies once per Series and never touches one that
    has been configured. The block is intentionally updatable rather than
    noupdate="1": convert.py's _tag_function skips a function inside a
    noupdate block unless the module is being installed for the first
    time, which would mean a Series added to the mapping later never got
    populated on existing databases. Running every upgrade is harmless
    given the guard.
    -->
    <data>
        <function model="aw.window.family" name="_seed_families"/>
        <function model="aw.window.series" name="_seed_default_leaf_types"/>
        <function model="aw.window.series" name="_seed_family_and_names"/>
        <function model="aw.profile.section" name="_seed_dg_openable_section"/>
        <!-- After the seed, so a database seeing both for the first
             time gets the corrected thicknesses either way: the seed
             now picks them itself, and this finds nothing to fix. -->
        <function model="aw.profile.section" name="_fix_dg_openable_thickness"/>
        <!-- Runs BEFORE _seed_bom_defaults so the Palay Bead xmlids
             already point at the surviving records when it looks them
             up. -->
        <function model="aw.profile.position" name="_seed_palay_bead_positions"/>
        <!-- Once: the three unused "Palay Bead" positions the seed above
             used to make after the catalog had renamed the real ones. -->
        <function model="aw.profile.position" name="_retire_palay_bead_duplicates"/>
        <function model="aw.profile.position" name="_seed_bom_defaults"/>
        <function model="aw.profile.position" name="_seed_required_flags"/>
        <function model="aw.profile.position" name="_seed_part_groups"/>
        <!-- After _seed_bom_defaults, which is what gives pos_lock_bar
             its scope and formula, and after the section exists. -->
        <function model="aw.profile.section" name="_seed_lock_bar_line"/>
        <function model="aw.profile.section" name="_seed_dg_openable_spec"/>
        <!-- Lake City glass, then the RE spec's default. After the spec
             seed so a fresh database has the spec to point at. -->
        <!-- Phase 7d, LAST: every section and spec must exist before
             the lines are re-pointed onto them. -->
        <function model="aw.window.template" name="_migrate_lines_to_specs"/>
        <!-- Sections, after every spec line exists: seed them, then put
             each existing line in the one its position and system say. -->
        <function model="aw.spec.section" name="_seed_spec_sections"/>
        <function model="aw.spec.section" name="_migrate_line_sections"/>
        <function model="aw.window.template" name="_migrate_deductions_to_specs"/>
        <!-- Phase 7e -->
        <function model="aw.window.template" name="_rename_seeded_spec"/>
        <function model="aw.hardware.set.line" name="_seed_qty_formulas"/>
        <function model="aw.price.structure" name="_seed_default_structure"/>
        <function model="aw.price.structure" name="_add_missing_lines"/>
        <function model="aw.vendor.rate.list" name="_migrate_steps"/>
        <function model="aw.profile.rate" name="_backfill_date_to"/>
        <function model="aw.profile.rate" name="_backfill_rate_list_ids"/>
        <!-- One time: Chawla into CHAWLA ALUMINIUM. After the backfills, so
             the chains it rebuilds are already complete. -->
        <function model="aw.profile.rate" name="_merge_chawla_vendor"/>
        <function model="product.attribute" name="_seed_finish_colours"/>
        <!-- Glass types of the first supplier list and the supplier; fill-only. -->
        <function model="aw.glass.type" name="_seed_glass_types"/>
        <function model="aw.glass.option" name="_seed_glass_options"/>
        <!-- Names for every vendor column, Premium's mapping, Wood, and the two
             unused strays. Once; never fails the upgrade. -->
        <function model="product.attribute.value" name="_migrate_finish_names"/>
        <!-- The position catalog, LAST: rename and add positions, then
             give every spec a row for every position (unused where it
             is not mapped). After every migration above, which re-point
             lines and would clash with these rows. -->
        <function model="aw.profile.position" name="_seed_catalog"/>
        <function model="res.config.settings" name="_migrate_length_uom"/>
        <function model="aw.window.template" name="_sync_all_catalog_lines"/>
        <!-- Fixed and Mesh panels need no hardware; once, then editable. -->
        <function model="aw.leaf.type" name="_seed_needs_hardware"/>
        <!-- The old flat glass (11 specs, 11 products), once and last, in
             SQL: verified first, never fails the upgrade. -->
        <function model="aw.glass.type" name="_retire_flat_glass"/>
    </data>
</odoo>
