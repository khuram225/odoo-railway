<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    The leaf_type_ids mapping for the 8 seeded Series, listed as a known
    gap in CLAUDE.md until it was specified.

    NOT in product_category_data.xml with the Series records themselves,
    and NOT noupdate: that file is noupdate="1", which means Odoo skips
    records that already exist, so adding the field there would change
    nothing on any database where the Series are already installed, which
    is all of them. A plain (updatable) data file is the only form that
    actually reaches existing records on upgrade.

    The trade-off, deliberate: this re-applies on every upgrade, so
    editing a Series' leaf types in the UI will be reverted the next time
    the module is upgraded. That is the right default while this is the
    authoritative mapping. If these ever need to be tuned per database,
    this file should be dropped in favour of a one-shot migration.
    -->
    <data>

        <record id="window_series_dg_sliding" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_slider'),
                ref('leaf_type_mesh')])]"/>
        </record>

        <record id="window_series_sg_sliding" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_slider'),
                ref('leaf_type_mesh')])]"/>
        </record>

        <record id="window_series_dg_fix" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed')])]"/>
        </record>

        <record id="window_series_sg_fix" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed')])]"/>
        </record>

        <record id="window_series_curtain_wall_fix" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_casement'),
                ref('leaf_type_awning'),
                ref('leaf_type_hopper')])]"/>
        </record>

        <record id="window_series_tiltturn" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_tiltturn')])]"/>
        </record>

        <record id="window_series_casement_sg" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_casement'),
                ref('leaf_type_mesh')])]"/>
        </record>

        <record id="window_series_casement_dg" model="aw.window.series">
            <field name="leaf_type_ids" eval="[(6, 0, [
                ref('leaf_type_fixed'),
                ref('leaf_type_casement'),
                ref('leaf_type_mesh')])]"/>
        </record>

    </data>
</odoo>
