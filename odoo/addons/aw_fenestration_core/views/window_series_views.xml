<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_window_series_list" model="ir.ui.view">
        <field name="name">aw.window.series.list</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="window_type_id"/>
                <field name="kind_id"/>
                <field name="profile_section_count" string="Sections"/>
                <field name="hardware_set_count" string="Hardware Sets"/>
                <field name="template_count" string="Templates"/>
            </list>
        </field>
    </record>

    <record id="view_aw_window_series_form" model="ir.ui.view">
        <field name="name">aw.window.series.form</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_profile_sections"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="profile_section_count" widget="statinfo" string="Sections"/>
                        </button>
                        <button type="object" name="action_view_hardware_sets"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="hardware_set_count" widget="statinfo" string="Hardware Sets"/>
                        </button>
                        <button type="object" name="action_view_templates"
                                class="oe_stat_button" icon="fa-th-large">
                            <field name="template_count" widget="statinfo" string="Templates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="window_type_id"/>
                            <field name="kind_id"/>
                        </group>
                        <group>
                            <field name="product_category_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aw_window_series" model="ir.actions.act_window">
        <field name="name">Window Series</field>
        <field name="res_model">aw.window.series</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Window Series</p>
            <p>A Window Series is a specific product family within a Window Type —
               Box Series, Collar Box, Round Series, GSL Slim, Hinged/Casement,
               Curtain Wall. Its Kind (which leaf types it can host) is inherited
               from its Window Type.</p>
        </field>
    </record>

</odoo>
