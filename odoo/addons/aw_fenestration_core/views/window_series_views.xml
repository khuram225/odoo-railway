<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    Phase 7d. The system form is General + its Specifications; the
    Deductions and Limits pages moved onto the SPECIFICATION, because
    two specs of one system can use different beads and so different
    deductions. The system keeps what is true of the system: family,
    role, which leaf types it can host, and its product category.

    The system's own deduction fields are still on the model and are
    still what a design with no spec falls back to, but they are off
    this form: editing them there would look like it changed something
    and would not, since every spec carries its own copy.
    -->

    <record id="view_aw_window_series_list" model="ir.ui.view">
        <field name="name">aw.window.series.list</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="family_id"/>
                <field name="system_role"/>
                <field name="leaf_type_ids" widget="many2many_tags"/>
                <field name="template_count" string="Specifications"/>
            </list>
        </field>
    </record>

    <record id="view_aw_window_series_kanban" model="ir.ui.view">
        <field name="name">aw.window.series.kanban</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <kanban default_group_by="family_id">
                <field name="family_id"/>
                <field name="system_role"/>
                <field name="template_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="system_role"/>
                            </div>
                            <div class="mt-1">
                                <field name="leaf_type_ids" widget="many2many_tags"/>
                            </div>
                            <div class="mt-1 small">
                                <field name="template_count"/> specification(s)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_aw_window_series_search" model="ir.ui.view">
        <field name="name">aw.window.series.search</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="family_id"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_family" string="Glazing Family"
                            context="{'group_by': 'family_id'}"/>
                    <filter name="group_role" string="Role"
                            context="{'group_by': 'system_role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_aw_window_series_form" model="ir.ui.view">
        <field name="name">aw.window.series.form</field>
        <field name="model">aw.window.series</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Double Glaze - Openable"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="code"/>
                            <field name="family_id"/>
                            <field name="system_role"/>
                            <field name="leaf_type_ids" widget="many2many_tags"
                                   string="Panel types it can host"/>
                        </group>
                        <group>
                            <field name="product_category_id"/>
                            <field name="default_glass_spec_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Specifications" name="specs">
                            <p class="text-muted">
                                What a window in this system is made of. A
                                spec owns its own profile and hardware
                                lines; one of them is the default a new
                                design starts from.
                            </p>
                            <field name="template_ids" context="{'default_window_type_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_default" widget="boolean_toggle"/>
                                    <field name="profile_line_count" string="Profiles"/>
                                    <field name="hardware_line_count" string="Hardware"/>
                                    <field name="glass_spec_id"/>
                                    <field name="design_count" string="Used in"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aw_window_series" model="ir.actions.act_window">
        <field name="name">Window Systems</field>
        <field name="res_model">aw.window.series</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_aw_window_series_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Window System</p>
            <p>A Window System is a profile system — Double Glaze Sliding, Single
               Glaze Fix, Curtain Wall Fix, Tilt &amp; Turn, Casement, etc. It says
               which panel types it can host; its Specifications say what a window
               built in it is actually made of.</p>
        </field>
    </record>

</odoo>
