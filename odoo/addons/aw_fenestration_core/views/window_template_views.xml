<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The model is aw.window.template and stays that way; everything
         the user reads says "Specification" / "Spec". Renaming a model
         rewrites every stored reference and every xmlid for a label.

         Phase 7d: the spec OWNS its profile and hardware lines, and
         carries the glass/mesh deductions and panel limits that used to
         sit on the system. The Profile Section and Hardware Set links
         survive, hidden on the last tab, until they are dropped. -->

    <record id="view_aw_window_template_list" model="ir.ui.view">
        <field name="name">aw.window.template.list</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="window_type_id" string="Window System"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="profile_line_count" string="Profiles"/>
                <field name="hardware_line_count" string="Hardware"/>
                <field name="glass_spec_id"/>
                <field name="design_count" string="Used in"/>
            </list>
        </field>
    </record>

    <record id="view_aw_window_template_form" model="ir.ui.view">
        <field name="name">aw.window.template.form</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_duplicate_spec"
                            string="Duplicate spec" class="btn-secondary"
                            invisible="not id"
                            help="A copy of this spec, its profile and hardware lines and its deductions."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Default" bg_color="text-bg-success"
                            invisible="not is_default"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. RE"/></h1>
                        <div class="text-muted">
                            <field name="full_name"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group>
                                    <field name="window_type_id" string="Window System"/>
                                    <field name="code"/>
                                    <field name="is_default"/>
                                    <field name="sequence"/>
                                </group>
                                <group>
                                    <field name="glass_spec_id"/>
                                    <field name="active" invisible="1"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1"
                                       placeholder="e.g. Standard / Heavy Duty / Economy..."/>
                            </group>
                        </page>

                        <page string="Profiles" name="profiles">
                            <p class="text-muted">
                                ONE line per position: the profile it
                                normally uses, plus any Alternates a
                                design may switch a divider to. A profile's
                                span rating lives on the profile itself,
                                under Inventory.
                                <br/>
                                No finish here: the colour belongs to the
                                window being quoted, so each design picks
                                its own and the BOM resolves every
                                profile's variant from it.
                            </p>
                            <separator string="Outer frame"/>
                            <field name="profile_line_outer_frame_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'outer_frame')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Sashes"/>
                            <field name="profile_line_sashes_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'sashes')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Beads"/>
                            <field name="profile_line_beads_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'beads')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Dividers"/>
                            <field name="profile_line_dividers_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'dividers')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Interlock &amp; meeting"/>
                            <field name="profile_line_interlock_meeting_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'interlock_meeting')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Lock"/>
                            <field name="profile_line_lock_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'lock')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Fly screen"/>
                            <field name="profile_line_fly_screen_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', 'fly_screen')]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Other"/>
                            <field name="profile_line_other_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id"
                                           domain="[('part_group', '=', False)]"/>
                                    <field name="product_tmpl_id" string="Profile"/>
                                    <field name="section_dims"/>
                                    <field name="thickness_attribute_value_ids"
                                           column_invisible="1"/>
                                    <field name="thickness_id"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="hide"/>
                                    <field name="length_formula_h" optional="hide"/>
                                    <field name="cut_angle" optional="hide"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Hardware" name="hardware">
                            <p class="text-muted">
                                Leave empty until a hardware list exists. A
                                design built to a spec with no hardware is
                                warned that its hardware cost is missing,
                                which is more honest than a placeholder
                                that prices hardware at zero.
                            </p>
                            <field name="hardware_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="scope"/>
                                    <field name="leaf_type_id"/>
                                    <field name="qty"/>
                                    <field name="qty_formula" optional="show"/>
                                    <field name="condition_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Deductions &amp; limits" name="deductions">
                            <p class="text-muted">
                                How much smaller than its panel each infill
                                is cut. Variables: PW PH (the panel),
                                CW CH (its container), W H (the design),
                                N T, LS (the sash length on a lock side).
                            </p>
                            <group>
                                <group string="Glass, fixed panel">
                                    <field name="glass_fixed_w"/>
                                    <field name="glass_fixed_h"/>
                                </group>
                                <group string="Glass, opening panel">
                                    <field name="glass_sash_w"/>
                                    <field name="glass_sash_h"/>
                                </group>
                                <group string="Mesh">
                                    <field name="mesh_w"/>
                                    <field name="mesh_h"/>
                                </group>
                                <group string="Panel limits">
                                    <field name="max_panel_w"/>
                                    <field name="max_panel_h"/>
                                    <field name="max_panel_kg"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Exceeding a limit is reported as a check on
                                the design, never a hard block. Zero means
                                the limit is not checked at all.
                            </p>
                        </page>

                        <page string="Used in" name="used_in">
                            <p class="text-muted">
                                Editing this spec affects these designs the
                                next time each one is saved. A confirmed or
                                sent quote is never re-exploded on its own.
                            </p>
                            <button type="object" name="action_view_designs"
                                    string="Open the designs" class="btn-link"
                                    invisible="not design_count"/>
                            <group>
                                <field name="design_count" string="Designs"/>
                            </group>
                            <group string="Legacy links" name="legacy"
                                   invisible="not profile_section_id and not hardware_set_id">
                                <field name="profile_section_id" readonly="1"/>
                                <field name="hardware_set_id" readonly="1"/>
                            </group>
                            <p class="text-muted"
                               invisible="not profile_section_id and not hardware_set_id">
                                The Profile Section and Hardware Set this
                                spec was assembled from before its lines
                                moved onto it. Kept so the shop drawing can
                                go on naming them; they no longer decide
                                anything, and will be dropped.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aw_window_template_search" model="ir.ui.view">
        <field name="name">aw.window.template.search</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="window_type_id" string="Window System"/>
                <filter name="filter_default" string="Default"
                        domain="[('is_default', '=', True)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_system" string="Window System"
                            context="{'group_by': 'window_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aw_window_template" model="ir.actions.act_window">
        <field name="name">Specifications</field>
        <field name="res_model">aw.window.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_aw_window_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Specification</p>
            <p>A Spec says what a window in one Window System is made of: its
               profile lines, its hardware lines, its glass, optionally a default
               finish, and how much smaller than each panel the glass and mesh are
               cut. A design starts from its system's default spec, and anything
               changed on one window afterwards is recorded against that window
               alone.</p>
        </field>
    </record>

</odoo>
