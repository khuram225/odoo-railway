<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The model is aw.window.template and stays that way; everything
         the user reads says "Specification" / "Spec". Renaming a model
         rewrites every stored reference and every xmlid for a label.

         Phase 7d: the spec OWNS its profile and hardware lines, and
         carries the glass/mesh deductions and panel limits that used to
         sit on the system. The Profile Section and Hardware Set links
         survive, hidden on the last tab, until they are dropped. -->

    <record id="view_aw_window_template_list" model="ir.ui.view">
        <field name="name">aw.window.template.list</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="window_type_id" string="Type"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="profile_line_count" string="Profiles"/>
                <field name="hardware_line_count" string="Hardware"/>
                <field name="glass_spec_id"/>
                <field name="design_count" string="Used in"/>
            </list>
        </field>
    </record>

    <record id="view_aw_window_template_form" model="ir.ui.view">
        <field name="name">aw.window.template.form</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_copy_from_series"
                            string="Copy from series" class="btn-secondary"
                            invisible="not id or profile_line_count"/>
                    <button type="object" name="action_duplicate_spec"
                            string="Duplicate spec" class="btn-secondary"
                            invisible="not id"
                            help="A copy of this spec, its profile and hardware lines and its deductions."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Default" bg_color="text-bg-success"
                            invisible="not is_default"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. RE"/></h1>
                        <div class="text-muted">
                            <field name="full_name"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group>
                                    <field name="window_type_id" string="Type"/>
                                    <field name="code"/>
                                    <field name="is_default"/>
                                    <field name="sequence"/>
                                </group>
                                <group>
                                    <field name="glass_spec_id"/>
                                    <field name="active" invisible="1"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1"
                                       placeholder="e.g. Standard / Heavy Duty / Economy..."/>
                            </group>
                        </page>

                        <page string="Profiles" name="profiles">
                            <p class="text-muted">
                                ONE line per position: the profile it
                                normally uses, plus any Alternates a
                                design may switch a divider to. A profile's
                                span rating lives on the profile itself,
                                under Inventory.
                                <br/>
                                No finish here: the colour belongs to the
                                window being quoted, so each design picks
                                its own and the BOM resolves every
                                profile's variant from it.
                            </p>
                            <field name="system_role" invisible="1"/>
                            <div class="o_aw_tree">
                            <div class="o_aw_tree_scope">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">Outer frame</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_outer" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_part" invisible="n_outer == 0">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">Frame</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_outer" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_part o_aw_tree_muted" invisible="n_outer != 0">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">Frame</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_outer" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_listwrap">
                            <field name="profile_line_s_outer_ids" nolabel="1">
                                <list editable="bottom" decoration-muted="not is_used">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="is_used" string="Used" widget="boolean_toggle"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id" domain="[('scope', '=', 'frame')]"/>
                                    <field name="spec_section_id" string="Section"/>
                                    <field name="product_tmpl_id" string="Profile" required="is_used"/>
                                    <field name="section_dims"/>
                                    <!-- Every thickness the profile is sold
                                         in. Which one a window uses is its
                                         own choice, made in the configurator. -->
                                    <field name="thickness_attribute_value_ids"
                                           string="Thicknesses"
                                           widget="many2many_tags"
                                           readonly="1"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="show"/>
                                    <field name="length_formula_h" optional="show"/>
                                    <field name="cut_angle" optional="show"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                    <field name="cut_on_site" optional="show"/>
                                    <field name="note" optional="hide"/>
