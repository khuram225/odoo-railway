                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id" domain="[('scope', '=', 'mesh_attachment')]"/>
                                    <field name="spec_section_id" string="Section"/>
                                    <field name="product_tmpl_id" string="Profile" required="is_used"/>
                                    <field name="section_dims"/>
                                    <!-- Every thickness the profile is sold
                                         in. Which one a window uses is its
                                         own choice, made in the configurator. -->
                                    <field name="thickness_attribute_value_ids"
                                           string="Thicknesses"
                                           widget="many2many_tags"
                                           readonly="1"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="show"/>
                                    <field name="length_formula_h" optional="show"/>
                                    <field name="cut_angle" optional="show"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                    <field name="cut_on_site" optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            </div>
                            <div class="o_aw_tree_scope">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">No scope (the engine ignores these)</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_other" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_part" invisible="n_other == 0">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">Unmapped</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_other" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_part o_aw_tree_muted" invisible="n_other != 0">
                                <span class="o_aw_tree_chev"/>
                                <span class="o_aw_tree_title">Unmapped</span>
                                <span class="o_aw_tree_count badge text-bg-light border"><field name="n_other" nolabel="1" readonly="1"/></span>
                            </div>
                            <div class="o_aw_tree_listwrap">
                            <field name="profile_line_s_other_ids" nolabel="1">
                                <list editable="bottom" decoration-muted="not is_used">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="is_used" string="Used" widget="boolean_toggle"/>
                                    <field name="picture_tmpl_id" string="Picture"
                                           widget="image" nolabel="1"
                                           options="{'size': [48, 48], 'preview_image': 'image_512', 'zoom': true, 'zoom_delay': 200}"/>
                                    <field name="position_id" domain="[('scope', '=', False)]"/>
                                    <field name="spec_section_id" string="Section"/>
                                    <field name="product_tmpl_id" string="Profile" required="is_used"/>
                                    <field name="section_dims"/>
                                    <!-- Every thickness the profile is sold
                                         in. Which one a window uses is its
                                         own choice, made in the configurator. -->
                                    <field name="thickness_attribute_value_ids"
                                           string="Thicknesses"
                                           widget="many2many_tags"
                                           readonly="1"/>
                                    <field name="alternate_product_ids"
                                           widget="many2many_tags"
                                           optional="hide"/>
                                    <field name="length_formula" optional="show"/>
                                    <field name="length_formula_h" optional="show"/>
                                    <field name="cut_angle" optional="show"/>
                                    <field name="qty_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                    <field name="cut_on_site" optional="show"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            </div>
                            </div>
                        </page>

                        <page string="Hardware" name="hardware">
                            <p class="text-muted">
                                Leave empty until a hardware list exists. A
                                design built to a spec with no hardware is
                                warned that its hardware cost is missing,
                                which is more honest than a placeholder
                                that prices hardware at zero.
                            </p>
                            <field name="hardware_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="scope"/>
                                    <field name="leaf_type_id"/>
                                    <field name="qty"/>
                                    <field name="qty_formula" optional="show"/>
                                    <field name="condition_formula" optional="hide"/>
                                    <field name="is_optional" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Deductions &amp; limits" name="deductions">
                            <p class="text-muted">
                                How much smaller than its panel each infill
                                is cut. Variables: PW PH (the panel),
                                CW CH (its container), W H (the design),
                                N T, LS (the sash length on a lock side).
                            </p>
                            <group>
                                <group string="Opening (OW / OH)">
                                    <field name="panel_count"/>
                                    <field name="divider_count"/>
                                    <field name="frame_deduction_w_text"/>
                                    <field name="frame_deduction_h_text"/>
                                    <field name="divider_body_text"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                On a panel, OW = panel width less half of
                                what is on each side, OH likewise for
                                height: half the frame deduction on the
                                window's outer edge, half the divider
                                body on any other edge. For the frame and
                                dividers, OW = (W - frame deduction W -
                                dividers x divider body) / panels and
                                OH = H - frame deduction H. Typed in inches and soot
                                (3, 1 1/2, 33-6, 3s) or mm. The panel and
                                divider counts only apply to a window with
                                no drawn layout.
                            </p>
                            <group>
                                <group string="Glass, fixed panel">
                                    <field name="glass_fixed_w"/>
                                    <field name="glass_fixed_h"/>
                                </group>
                                <group string="Glass, opening panel">
                                    <field name="glass_sash_w"/>
                                    <field name="glass_sash_h"/>
                                </group>
                                <group string="Mesh">
                                    <field name="mesh_w"/>
                                    <field name="mesh_h"/>
                                </group>
                                <group string="Panel limits">
                                    <field name="max_panel_w"/>
                                    <field name="max_panel_h"/>
                                    <field name="max_panel_kg"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Exceeding a limit is reported as a check on
                                the design, never a hard block. Zero means
                                the limit is not checked at all.
                            </p>
                        </page>

                        <page string="Used in" name="used_in">
                            <p class="text-muted">
                                Editing this spec affects these designs the
                                next time each one is saved. A confirmed or
                                sent quote is never re-exploded on its own.
                            </p>
                            <button type="object" name="action_view_designs"
                                    string="Open the designs" class="btn-link"
                                    invisible="not design_count"/>
                            <group>
                                <field name="design_count" string="Designs"/>
                            </group>
                            <group string="Legacy links" name="legacy"
                                   invisible="not profile_section_id and not hardware_set_id">
                                <field name="profile_section_id" readonly="1"/>
                                <field name="hardware_set_id" readonly="1"/>
                            </group>
                            <p class="text-muted"
                               invisible="not profile_section_id and not hardware_set_id">
                                The Profile Section and Hardware Set this
                                spec was assembled from before its lines
                                moved onto it. Kept so the shop drawing can
                                go on naming them; they no longer decide
                                anything, and will be dropped.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aw_window_template_search" model="ir.ui.view">
        <field name="name">aw.window.template.search</field>
        <field name="model">aw.window.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="window_type_id" string="Type"/>
                <filter name="filter_default" string="Default"
                        domain="[('is_default', '=', True)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_system" string="Type"
                            context="{'group_by': 'window_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aw_window_template" model="ir.actions.act_window">
        <field name="name">Series</field>
        <field name="res_model">aw.window.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_aw_window_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Series</p>
            <p>A Spec says what a window in one Type is made of: its
               profile lines, its hardware lines, its glass, optionally a default
               finish, and how much smaller than each panel the glass and mesh are
               cut. A design starts from its system's default spec, and anything
               changed on one window afterwards is recorded against that window
               alone.</p>
        </field>
    </record>

    <record id="view_aw_template_copy_wizard_form" model="ir.ui.view">
        <field name="name">aw.window.template.copy.wizard.form</field>
        <field name="model">aw.window.template.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy from series">
                <p class="text-muted">
                    A one-time copy of another series' mapping: profiles,
                    sections, length rules and cut ends. Nothing stays
                    linked afterwards. Thickness and finish are chosen
                    per window and are not copied.
                </p>
                <group>
                    <field name="target_id"/>
                    <field name="source_id"/>
                </group>
                <footer>
                    <button type="object" name="action_copy"
                            string="Copy" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
