<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    Same story as the Profile Section beside it: phase 7d moved the lines
    onto the Specification, so `line_ids` is empty on every migrated
    hardware set and a form offering it for editing would show an empty
    table where the hardware used to be. Read-only, kept for the reports
    and for the spec's legacy link; the menu is already gone.
    -->

    <record id="view_aw_hardware_set_list" model="ir.ui.view">
        <field name="name">aw.hardware.set.list</field>
        <field name="model">aw.hardware.set</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="window_type_id" string="Window System"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_aw_hardware_set_form" model="ir.ui.view">
        <field name="name">aw.hardware.set.form</field>
        <field name="model">aw.hardware.set</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="alert alert-info" role="status">
                        The hardware that was here now belongs to the
                        <b>Specification</b> built from this set, under
                        Window Systems.
                    </div>
                    <group>
                        <group>
                            <field name="window_type_id" string="Window System"/>
                            <field name="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aw_hardware_set" model="ir.actions.act_window">
        <field name="name">Hardware Sets</field>
        <field name="res_model">aw.hardware.set</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Hardware Sets</p>
            <p>Hardware Sets were replaced by Specifications, which own their own
               hardware lines. These records are kept only for the reports and for
               the legacy link on a Specification.</p>
        </field>
    </record>

</odoo>
