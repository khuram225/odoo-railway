<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== aw.profile.rate ===== -->
    <record id="view_aw_profile_rate_list" model="ir.ui.view">
        <field name="name">aw.profile.rate.list</field>
        <field name="model">aw.profile.rate</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-muted="status in ('superseded', 'expired')"
                  decoration-info="status == 'future'"
                  decoration-danger="status == 'expired'">
                <field name="date_from" string="Effective from"/>
                <field name="date_to" string="Effective to"/>
                <field name="status"/>
                <field name="product_tmpl_id"/>
                <field name="thickness_id"/>
                <field name="finish_id"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="vendor_id"/>
                <field name="vendor_series" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="source_note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aw_profile_rate_search" model="ir.ui.view">
        <field name="name">aw.profile.rate.search</field>
        <field name="model">aw.profile.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id" string="Profile"/>
                <field name="vendor_id"/>
                <field name="finish_id"/>
                <field name="thickness_id"/>
                <field name="date_from"/>
                <!-- Date domains, not a domain on `status`: status is
                     computed from today's date and is not stored, so it
                     cannot be searched. Expressing the same thing in
                     dates keeps the filters working without a
                     search= method whose only job would be to rebuild
                     these very domains. -->
                <filter name="current" string="In force today"
                        domain="['&amp;', ('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')), '|', ('date_to', '=', False), ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="future" string="Future"
                        domain="[('date_from', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="closed" string="Superseded or expired"
                        domain="[('date_to', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <!-- A bare <group>, as core's own v19 search views
                     use. Neither expand= nor string= is allowed here any
                     more: base/rng/common.rng permits only colspan,
                     rowspan, fill, height, width, name, color and
                     invisible. Both were valid in older Odoo, which is
                     exactly what makes them easy to carry over
                     unnoticed. The web client labels the section
                     itself. -->
                <group>
                    <filter name="group_date" string="Effective From"
                            context="{'group_by': 'date_from'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_profile" string="Profile"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_finish" string="Finish"
                            context="{'group_by': 'finish_id'}"/>
                    <filter name="group_thickness" string="Thickness"
                            context="{'group_by': 'thickness_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_aw_profile_rate_form" model="ir.ui.view">
        <field name="name">aw.profile.rate.form</field>
        <field name="model">aw.profile.rate</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id" string="Profile"/>
                            <field name="thickness_id"/>
                            <field name="finish_id"/>
                            <field name="vendor_id"/>
                            <field name="vendor_series"/>
                        </group>
                        <group>
                            <field name="price" string="PKR / ft"/>
                            <field name="date_from" string="Effective from"/>
                            <field name="date_to" string="Effective to"/>
                            <field name="status"/>
                            <field name="source_note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aw_profile_rate" model="ir.actions.act_window">
        <field name="name">Rates in force</field>
        <field name="res_model">aw.profile.rate</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
        <field name="context">{'search_default_current': 1, 'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No rates yet</p>
            <p>Rates come from a Rate List: paste or type a vendor's
               prices and apply it. They are never edited in place, so an
               old quote keeps the price it was quoted at.</p>
        </field>
    </record>

    <!-- ===== aw.price.structure ===== -->
    <record id="view_aw_price_structure_list" model="ir.ui.view">
        <field name="name">aw.price.structure.list</field>
        <field name="model">aw.price.structure</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_aw_price_structure_form" model="ir.ui.view">
        <field name="name">aw.price.structure.form</field>
        <field name="model">aw.price.structure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="value"/>
                            <field name="unit"/>
                            <field name="show_on_quote"/>
                        </list>
                    </field>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aw_price_structure" model="ir.actions.act_window">
        <field name="name">Price Structures</field>
        <field name="res_model">aw.price.structure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Price Structure</p>
            <p>Wastage, labour and profit, as editable rows. The seeded
               values are placeholders — confirm each with the shop before
               quoting from them.</p>
        </field>
    </record>

</odoo>
