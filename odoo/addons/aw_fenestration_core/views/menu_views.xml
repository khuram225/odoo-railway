<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    Phase 7d reorganisation. Two groups, and the rule dividing them is
    "would a quote be wrong if this were wrong?":

      Window Systems   what a window is MADE OF. One menu, because a
                       system's Specifications now live inside it, and
                       a spec owns its own profile and hardware lines.
                       Profile Sections, Hardware Sets and a top-level
                       Specifications menu are GONE from the menu (the
                       models and their actions survive, so a bookmark
                       and the migration still work).
      Configuration    the lists a system is assembled FROM, plus rates
                       and imports.
    -->

    <menuitem id="menu_aw_fenestration_root"
              name="Fenestration"
              sequence="45"
              web_icon="aw_fenestration_core,static/description/icon.png"/>

    <menuitem id="menu_aw_window_series"
              name="Window Systems"
              parent="menu_aw_fenestration_root"
              action="action_aw_window_series"
              sequence="10"/>

    <menuitem id="menu_aw_fenestration_config"
              name="Configuration"
              parent="menu_aw_fenestration_root"
              sequence="100"
              groups="group_fenestration_manager"/>

    <menuitem id="menu_aw_fenestration_settings"
              name="Settings"
              parent="menu_aw_fenestration_config"
              action="action_aw_fenestration_config_settings"
              sequence="0"
              groups="group_fenestration_manager"/>

    <menuitem id="menu_aw_window_family"
              name="Glazing Families"
              parent="menu_aw_fenestration_config"
              action="action_aw_window_family"
              sequence="2"/>

    <menuitem id="menu_aw_spec_section"
              name="Spec Sections"
              parent="menu_aw_fenestration_config"
              action="action_aw_spec_section"
              sequence="4"/>

    <menuitem id="menu_aw_profile_position"
              name="Profile Positions"
              parent="menu_aw_fenestration_config"
              action="action_aw_profile_position"
              sequence="3"/>

    <!-- "Panel Types" is what the configurator and every drawing call
         them; aw.leaf.type keeps its model name. The leaf type Mesh
         stays "Mesh panel": a sliding mesh on its own track, which is
         a PANEL. A fly screen fitted to a panel is a Panel Option. -->
    <menuitem id="menu_aw_leaf_type"
              name="Panel Types"
              parent="menu_aw_fenestration_config"
              action="action_aw_leaf_type"
              sequence="4"/>

    <menuitem id="menu_aw_glass_spec"
              name="Glass Types"
              parent="menu_aw_fenestration_config"
              action="action_aw_glass_spec"
              sequence="5"/>

    <menuitem id="menu_aw_profile_rate"
              name="Profile Rates"
              parent="menu_aw_fenestration_config"
              action="action_aw_profile_rate"
              sequence="50"/>

    <menuitem id="menu_aw_profile_rate_import"
              name="Import Price List"
              parent="menu_aw_fenestration_config"
              action="action_aw_profile_rate_import"
              sequence="55"/>

    <menuitem id="menu_aw_catalogue_import"
              name="Import Catalogue"
              parent="menu_aw_fenestration_config"
              action="action_aw_catalogue_import"
              sequence="57"/>

    <menuitem id="menu_aw_price_structure"
              name="Price Structures"
              parent="menu_aw_fenestration_config"
              action="action_aw_price_structure"
              sequence="60"/>

</odoo>
