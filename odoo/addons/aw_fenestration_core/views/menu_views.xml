<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    Five groups under Fenestration, by what you do there:

      Designs   the windows being quoted.
      Library   the layouts and panel options you build a window from.
      Rates     what things cost: the lists that put a rate in force, the
                rates in force, glass extras and how each vendor's sheet
                is read.
      Setup     the lists a window is assembled FROM, set once and left.
      Admin     one-off imports.

    Menu ids are unchanged wherever a menu survives, so a bookmark still
    works. Only parents, names and order moved. The groups are declared
    first because every menuitem resolves its parent at parse time.
    -->

    <menuitem id="menu_aw_fenestration_root"
              name="Fenestration"
              sequence="45"
              web_icon="aw_fenestration_core,static/description/icon.png"/>

    <menuitem id="menu_aw_group_designs"
              name="Designs"
              parent="menu_aw_fenestration_root"
              sequence="10"/>

    <menuitem id="menu_aw_group_library"
              name="Library"
              parent="menu_aw_fenestration_root"
              sequence="20"/>

    <!-- Rates keeps the id it had as "Vendor Rates". -->
    <menuitem id="menu_aw_vendor_rates"
              name="Rates"
              parent="menu_aw_fenestration_root"
              sequence="30"
              groups="group_fenestration_manager"/>

    <!-- Setup keeps the id it had as "Configuration". -->
    <menuitem id="menu_aw_fenestration_config"
              name="Setup"
              parent="menu_aw_fenestration_root"
              sequence="40"
              groups="group_fenestration_manager"/>

    <menuitem id="menu_aw_group_admin"
              name="Admin"
              parent="menu_aw_fenestration_root"
              sequence="50"
              groups="group_fenestration_manager"/>

    <!-- Rates -->
    <menuitem id="menu_aw_vendor_rate_list"
              name="Rate Lists"
              parent="menu_aw_vendor_rates"
              action="action_aw_vendor_rate_list"
              sequence="10"/>

    <menuitem id="menu_aw_profile_rate"
              name="Profile rates in force"
              parent="menu_aw_vendor_rates"
              action="action_aw_profile_rate"
              sequence="20"/>

    <menuitem id="menu_aw_glass_rate"
              name="Glass rates in force"
              parent="menu_aw_vendor_rates"
              action="action_aw_glass_rate"
              sequence="30"/>

    <menuitem id="menu_aw_glass_extra"
              name="Glass Extras"
              parent="menu_aw_vendor_rates"
              action="action_aw_glass_extra"
              sequence="40"/>

    <menuitem id="menu_aw_vendor_layout"
              name="Vendor Layouts"
              parent="menu_aw_vendor_rates"
              action="action_aw_vendor_layout"
              sequence="50"/>

    <!-- Setup. "Panel Types" is what the configurator and every drawing
         call them; aw.leaf.type keeps its model name. The leaf type Mesh
         stays "Mesh panel": a sliding mesh on its own track, which is a
         PANEL. A fly screen fitted to a panel is a Panel Option. -->
    <menuitem id="menu_aw_window_series"
              name="Window Types"
              parent="menu_aw_fenestration_config"
              action="action_aw_window_series"
              sequence="10"/>

    <menuitem id="menu_aw_window_family"
              name="Families"
              parent="menu_aw_fenestration_config"
              action="action_aw_window_family"
              sequence="15"/>

    <menuitem id="menu_aw_leaf_type"
              name="Panel Types"
              parent="menu_aw_fenestration_config"
              action="action_aw_leaf_type"
              sequence="20"/>

    <menuitem id="menu_aw_spec_section"
              name="Sections"
              parent="menu_aw_fenestration_config"
              action="action_aw_spec_section"
              sequence="30"/>

    <menuitem id="menu_aw_profile_position"
              name="Profile Positions"
              parent="menu_aw_fenestration_config"
              action="action_aw_profile_position"
              sequence="40"/>

    <menuitem id="menu_aw_finish"
              name="Finishes"
              parent="menu_aw_fenestration_config"
              action="action_aw_finish"
              sequence="50"/>

    <menuitem id="menu_aw_glass_type"
              name="Glass Types"
              parent="menu_aw_fenestration_config"
              action="action_aw_glass_type"
              sequence="60"/>

    <menuitem id="menu_aw_glass_option"
              name="Glass Options"
              parent="menu_aw_fenestration_config"
              action="action_aw_glass_option"
              sequence="70"/>

    <menuitem id="menu_aw_price_structure"
              name="Price Structures"
              parent="menu_aw_fenestration_config"
              action="action_aw_price_structure"
              sequence="80"/>

    <menuitem id="menu_aw_fenestration_settings"
              name="Settings"
              parent="menu_aw_fenestration_config"
              action="action_aw_fenestration_config_settings"
              sequence="90"
              groups="group_fenestration_manager"/>

    <!-- Admin -->
    <menuitem id="menu_aw_catalogue_import"
              name="Import Catalogue"
              parent="menu_aw_group_admin"
              action="action_aw_catalogue_import"
              sequence="10"/>

</odoo>
