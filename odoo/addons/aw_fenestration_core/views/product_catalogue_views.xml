<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_fenestration" model="ir.ui.view">
        <field name="name">product.template.form.inherit.aw_fenestration_core</field>
        <field name="model">product.template</field>
        <!-- The BASE product form: product_template_only_form_view is
             itself a primary inheriting this one, and the notebook
             lives here. -->
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Profiles are priced by rates, never typed: the table of
                 current rates goes first, and the price, cost and
                 "Can be Sold" controls go. Taxes stay. -->
            <xpath expr="//page[@name='general_information']/group" position="before">
                <field name="aw_is_profile" invisible="1"/>
                <field name="aw_rates_table" widget="aw_rates_table" nolabel="1"
                       invisible="not aw_is_profile"/>
            </xpath>
            <xpath expr="//span[@name='sale_option']" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </xpath>
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </xpath>
            <xpath expr="//div[@name='list_price_uom']" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </xpath>
            <xpath expr="//label[@id='standard_price_label']" position="attributes">
                <attribute name="invisible" add="aw_is_profile" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible" add="aw_is_profile" separator=" or "/>
            </xpath>
            <xpath expr="//page[@name='sales_price']" position="attributes">
                <attribute name="invisible" add="aw_is_profile" separator=" or "/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <!-- Only shown once a product has been matched to the
                     catalogue, so it stays out of the way on every other
                     product in the database. -->
                <page string="Fenestration" name="aw_fenestration"
                      invisible="not aw_catalogue_code and not aw_catalogue_page">
                    <group string="As a divider or transom">
                        <field name="aw_max_span_mm"/>
                    </group>
                    <group string="Catalogue">
                        <group>
                            <field name="aw_catalogue_code"/>
                            <field name="aw_catalogue_category"/>
                            <field name="aw_catalogue_page"/>
                        </group>
                        <group>
                            <field name="aw_section_dims"/>
                            <!-- Kept but hidden: its values are merged
                                 into the real Thickness attribute, and
                                 showing both invites someone to trust
                                 the catalogue's wording over the
                                 variants that actually exist. -->
                            <field name="aw_catalogue_thickness" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="aw_cost_sync_allowed" invisible="1"/>
                <button name="action_aw_update_costs_from_rates"
                        type="object" class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="not aw_cost_sync_allowed or (not aw_catalogue_code and not aw_catalogue_page)">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Update costs</span>
                        <span class="o_stat_text">from rates</span>
                    </div>
                </button>
                <button name="action_aw_update_costs_from_rates"
                        type="object" class="oe_stat_button"
                        icon="fa-ban" disabled="1"
                        title="Cost is owned by stock valuation under AVCO and FIFO. Writing it from a supplier rate would revalue your stock."
                        invisible="aw_cost_sync_allowed or (not aw_catalogue_code and not aw_catalogue_page)">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Cost owned by</span>
                        <span class="o_stat_text">stock valuation</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_list_fenestration" model="ir.ui.view">
        <field name="name">product.product.list.inherit.aw_fenestration_core</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="before">
                <field name="aw_is_profile" column_invisible="1"/>
                <field name="aw_rate_per_ft" string="Rate, default vendor" optional="show"/>
                <field name="aw_rate_date" string="Rate of" optional="hide"/>
            </field>
            <field name="lst_price" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </field>
        </field>
    </record>

    <record id="view_product_product_form_fenestration" model="ir.ui.view">
        <field name="name">product.product.form.inherit.aw_fenestration_core</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- ONE Fenestration tab. The template's page is inherited
                 into this form, so the variant's own figures go into
                 that page instead of a second tab of the same name. -->
            <xpath expr="//page[@name='aw_fenestration']" position="attributes">
                <attribute name="invisible">not aw_catalogue_code and not aw_catalogue_page and not aw_rate_per_ft and not aw_rate_date</attribute>
            </xpath>
            <xpath expr="//group[@name='pricing']" position="attributes">
                <attribute name="invisible">aw_is_profile</attribute>
            </xpath>
            <xpath expr="//page[@name='aw_fenestration']" position="inside">
                <group string="This variant">
                    <field name="aw_thickness_name"/>
                    <field name="aw_finish_name"/>
                    <field name="aw_rate_per_ft" string="PKR / ft"/>
                    <field name="aw_rate_date" string="Effective from"/>
                    <field name="aw_rate_basis"/>
                    <field name="aw_cost_from_rate"
                           string="Cost / ft from rate"/>
                    <field name="aw_has_rate" invisible="1"/>
                    <div class="text-muted" colspan="2"
                         invisible="aw_cost_sync_allowed">
                        Cost is not written from the rate here: under
                        AVCO and FIFO it belongs to stock valuation.
                        The figure above is for reference.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_attr_tags_fenestration" model="ir.ui.view">
        <field name="name">product.template.form.attr.tags.aw_fenestration_core</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Paint attribute-value tags with their own html_color
                 instead of Odoo's 12-colour index, which reads as
                 random for Finish. Falls back to the normal tag for any
                 value with no colour. -->
            <field name="value_ids" position="attributes">
                <attribute name="widget">aw_attribute_color_tags</attribute>
            </field>
        </field>
    </record>

    <!-- ===== import wizard ===== -->
    <record id="view_aw_catalogue_import_form" model="ir.ui.view">
        <field name="name">aw.catalogue.import.form</field>
        <field name="model">aw.catalogue.import</field>
        <field name="arch" type="xml">
            <form string="Import Catalogue">
                <group invisible="state == 'done'">
                    <field name="state" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="overwrite_images"/>
                </group>
                <div invisible="state == 'done'" class="text-muted">
                    The catalogue export zip: existing_products.csv,
                    new_products.csv and their image folders. Existing
                    products are only updated, never created; new ones are
                    skipped if a product of that name already exists.
                </div>
                <field name="summary" invisible="state != 'done'"
                       readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aw_catalogue_import" model="ir.actions.act_window">
        <field name="name">Import Catalogue</field>
        <field name="res_model">aw.catalogue.import</field>
        <field name="view_mode">form</field>
        <field name="views" eval="[(False, 'form')]"/>
        <field name="target">new</field>
    </record>

</odoo>
