<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== aw.leaf.type ===== -->
    <record id="view_aw_leaf_type_list" model="ir.ui.view">
        <field name="name">aw.leaf.type.list</field>
        <field name="model">aw.leaf.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="has_hinge_side" widget="boolean_toggle"/>
                <field name="has_slide_dir" widget="boolean_toggle"/>
                <field name="is_glazed" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_aw_leaf_type" model="ir.actions.act_window">
        <field name="name">Leaf Types</field>
        <field name="res_model">aw.leaf.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Leaf Type</p>
            <p>The single list of leaf mechanisms — Fixed, Slider, Casement,
               Awning, Hopper, Mesh, Tilt &amp; Turn. Used by Window Series
               (which types it allows), Design Leaves (which type a leaf
               is), and Hardware Set lines (which type triggers a hardware
               item). Add a new one here and it's available everywhere at
               once.</p>
        </field>
    </record>

    <!-- ===== aw.spec.section ===== -->
    <record id="view_aw_spec_section_list" model="ir.ui.view">
        <field name="name">aw.spec.section.list</field>
        <field name="model">aw.spec.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="leaf_type_ids" widget="many2many_tags"
                       invisible="applies_to != 'panel'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_aw_spec_section" model="ir.actions.act_window">
        <field name="name">Spec Sections</field>
        <field name="res_model">aw.spec.section</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Spec Section</p>
            <p>A specification is read the way a window is described:
               the Frame, then one section per panel type, then mesh
               add-ons, then joints. Add your own, for example a Sill.</p>
        </field>
    </record>

    <!-- ===== aw.profile.position ===== -->
    <record id="view_aw_profile_position_list" model="ir.ui.view">
        <field name="name">aw.profile.position.list</field>
        <field name="model">aw.profile.position</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="part_group"/>
                <field name="scope"/>
                <field name="is_required"/>
                <field name="edge"/>
                <field name="default_length"/>
                <!-- Only meaningful for Edge = All four, but shown always:
                     hiding it per row would leave no hint that the second
                     formula exists at all. -->
                <field name="default_length_h"/>
                <field name="default_angle"/>
                <field name="default_qty"/>
            </list>
        </field>
    </record>
    <record id="action_aw_profile_position" model="ir.actions.act_window">
        <field name="name">Profile Positions</field>
        <field name="res_model">aw.profile.position</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Profile Position</p>
            <p>Where a profile sits in the frame — Outer Frame Top/Bottom/
               Sides, Palay (leaf) Top/Bottom/Sides, Mesh, Dividers, Fixed
               Bead. Open-ended: add a new position any time without a
               schema change.</p>
        </field>
    </record>

</odoo>
