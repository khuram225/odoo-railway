<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_window_type_list" model="ir.ui.view">
        <field name="name">aw.window.type.list</field>
        <field name="model">aw.window.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind_id"/>
                <field name="window_series_count" string="Series"/>
            </list>
        </field>
    </record>

    <record id="view_aw_window_type_form" model="ir.ui.view">
        <field name="name">aw.window.type.form</field>
        <field name="model">aw.window.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" name="%(action_aw_window_series)d"
                                class="oe_stat_button" icon="fa-th-large"
                                context="{'search_default_window_type_id': id}">
                            <field name="window_series_count" widget="statinfo" string="Series"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="kind_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aw_window_type" model="ir.actions.act_window">
        <field name="name">Window Types</field>
        <field name="res_model">aw.window.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Window Type</p>
            <p>A Window Type is the broad category a Series belongs to — Sliding
               Window, Fix Window, Curtain Wall Fix Window, Open-able Window,
               Tilt &amp; Turn Window, Door. Kind is optional here: some Types
               (like Door) don't have a leaf-type rule set yet.</p>
        </field>
    </record>

</odoo>
