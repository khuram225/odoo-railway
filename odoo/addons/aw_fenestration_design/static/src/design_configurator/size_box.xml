<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="aw_fenestration_design.SizeBox">
        <input t-if="state.editing" t-ref="input" type="text"
               t-att-class="props.class" t-att-style="props.style"
               t-att-inputmode="props.inputmode"
               t-att-data-aw-size="props.size" t-att-data-aw-kind="props.kind"
               t-att-value="state.initial"
               t-on-input="onInput" t-on-blur="commit" t-on-keydown="onKeydown"/>
        <div t-else="" tabindex="0" role="textbox"
             t-att-class="(props.class || '') + ' o_aw_sizebox'"
             t-att-style="props.style"
             t-att-data-aw-size="props.size" t-att-data-aw-kind="props.kind"
             t-on-focus="start" t-on-click="start">
            <t t-if="props.value" t-esc="props.value"/>
            <span t-else="" class="text-muted"><t t-esc="props.placeholder || ''"/></span>
        </div>
    </t>

</templates>
