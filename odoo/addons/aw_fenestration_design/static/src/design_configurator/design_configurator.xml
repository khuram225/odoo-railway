<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="aw_fenestration_design.DesignConfigurator">
        <!-- overflow-hidden + min-height:0 on every flex child is what keeps
             the whole thing inside the viewport. A flex item defaults to
             min-height:auto, i.e. it refuses to shrink below its content,
             which is what pushes a tall drawing past the bottom of the page
             instead of letting the canvas scroll internally. -->
        <div class="o_aw_configurator d-flex flex-column h-100 overflow-hidden">

            <div t-if="state.loading" class="d-flex h-100 align-items-center justify-content-center text-muted">
                Loading design...
            </div>

            <t t-else="">
                <!-- Header -->
                <div class="o_aw_cfg_header border-bottom bg-view p-3 flex-shrink-0">
                    <div class="d-flex flex-wrap gap-3 align-items-end">
                        <div>
                            <label class="form-label small text-muted mb-0">Position</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.data.header.name"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('name', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Qty</label>
                            <input type="number" min="1" class="form-control form-control-sm"
                                   style="width: 5rem;"
                                   t-att-value="state.data.header.qty"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('qty', parseInt(ev.target.value) || 1)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Location</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.data.header.location"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('location', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">
                                Width (<t t-esc="uomLabel"/>)
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   style="width: 9rem;"
                                   t-att-value="formatLength(state.data.header.width_mm)"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onDimensionChange('width_mm', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">
                                Height (<t t-esc="uomLabel"/>)
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   style="width: 9rem;"
                                   t-att-value="formatLength(state.data.header.height_mm)"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onDimensionChange('height_mm', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Series</label>
                            <select class="form-select form-select-sm"
                                    t-on-change="(ev) => this.onSeriesChange(ev.target.value)">
                                <t t-foreach="seriesOptions" t-as="opt" t-key="opt.id">
                                    <option t-att-value="opt.id"
                                            t-att-selected="opt.id === state.data.header.window_series_id">
                                        <t t-esc="opt.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button class="btn btn-sm btn-secondary" t-on-click="openForm">
                                Open Form
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="save"
                                    t-att-disabled="!state.dirty">
                                Save
                            </button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-grow-1 overflow-hidden" style="min-height: 0;">

                    <!-- LEFT: preset library, collapsible -->
                    <div class="o_aw_cfg_library border-end bg-view d-flex flex-column flex-shrink-0"
                         t-att-style="state.libraryOpen ? 'width: 220px; min-height: 0;' : 'width: 2.25rem; min-height: 0;'">
                        <button class="btn btn-sm btn-light border-0 rounded-0 text-start d-flex align-items-center gap-1 flex-shrink-0"
                                t-on-click="toggleLibrary"
                                t-att-title="state.libraryOpen ? 'Hide preset library' : 'Show preset library'">
                            <i t-att-class="state.libraryOpen ? 'fa fa-chevron-left' : 'fa fa-chevron-right'"/>
                            <span t-if="state.libraryOpen" class="small text-muted">Layouts</span>
                        </button>

                        <div t-if="state.libraryOpen" class="overflow-auto p-2" style="min-height: 0;">
                            <t t-foreach="presetsByCategory" t-as="group" t-key="group.category">
                                <div class="o_aw_cfg_cat small text-muted text-uppercase fw-bold mt-2 mb-1">
                                    <t t-esc="group.category"/>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <t t-foreach="group.presets" t-as="preset" t-key="preset.id">
                                        <button class="o_aw_cfg_preset btn btn-sm btn-light border p-1 text-center"
                                                t-att-title="preset.name"
                                                t-on-click="() => this.applyPreset(preset)">
                                            <t t-set="thumb" t-value="presetThumb(preset.layout)"/>
                                            <svg t-att-viewBox="thumb.viewBox"
                                                 preserveAspectRatio="xMidYMid meet">
                                                <defs>
                                                    <pattern id="aw_mesh_thumb" width="3" height="3" patternUnits="userSpaceOnUse">
                                                        <rect width="3" height="3" fill="#c3dce3" fill-opacity="0.35"/>
                                                        <path d="M0,3 L3,0" stroke="#6a7075" stroke-width="0.5"/>
                                                    </pattern>
                                                </defs>
                                                <rect x="0" y="0"
                                                      t-att-width="thumb.frame.W" t-att-height="thumb.frame.H"
                                                      fill="#8a9095" stroke="#6a7075" stroke-width="0.8"/>
                                                <t t-foreach="thumb.rects" t-as="r" t-key="r.key">
                                                    <rect t-att-x="r.x" t-att-y="r.y"
                                                          t-att-width="r.w" t-att-height="r.h"
                                                          t-att-fill="r.isMesh ? 'url(#aw_mesh_thumb)' : '#c3dce3'"
                                                          stroke="#9dbfc9" stroke-width="0.5"/>
                                                </t>
                                            </svg>
                                            <div class="o_aw_cfg_preset_name text-muted mt-1">
                                                <t t-esc="preset.name"/>
                                            </div>
                                        </button>
                                    </t>
                                </div>
                            </t>

                            <!-- Empty states are stated rather than rendered as an
                                 empty strip: an invisible cause looks like a broken
                                 screen, which is exactly how the Series leaf-type
                                 mapping went unnoticed. -->
                            <div t-if="!state.data.presets.length" class="small text-warning mt-2">
                                <t t-if="!state.data.leaf_types.length">
                                    No presets can be offered:
                                    <b><t t-esc="state.data.header.window_series_name"/></b>
                                    has no leaf types configured.
                                </t>
                                <t t-else="">
                                    No preset matches the leaf types allowed by
                                    <b><t t-esc="state.data.header.window_series_name"/></b>
                                    (<t t-esc="state.data.leaf_types.map(t => t.name).join(', ')"/>).
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- CENTER: drawing, full height -->
                    <div class="flex-grow-1 d-flex flex-column p-3" style="min-width: 0; min-height: 0;">
                        <div class="o_aw_cfg_canvas_wrap position-relative flex-grow-1"
                             style="min-height: 0;">

                            <!-- Zoom controls, floating over the canvas -->
                            <div t-if="scene"
                                 class="position-absolute top-0 end-0 m-2 d-flex align-items-center gap-1 bg-view border rounded shadow-sm px-1 py-1"
                                 style="z-index: 2;">
                                <button class="btn btn-sm btn-light px-2" title="Zoom out"
                                        t-on-click="zoomOut"
                                        t-att-disabled="state.zoom &lt;= 0.25">&#8722;</button>
                                <span class="small text-muted font-monospace"
                                      style="min-width: 3.2rem; text-align: center;">
                                    <t t-esc="zoomPercent"/>%
                                </span>
                                <button class="btn btn-sm btn-light px-2" title="Zoom in"
                                        t-on-click="zoomIn"
                                        t-att-disabled="state.zoom >= 4">+</button>
                                <button class="btn btn-sm btn-light px-2" title="Fit to screen"
                                        t-on-click="zoomFit">Fit</button>
                            </div>

                            <!-- Floating toolbar. Child of the NON-scrolling
                                 wrapper, positioned from screen coordinates, so
                                 it tracks the selection through zoom and scroll
                                 instead of drifting with the content. -->
                            <div t-if="state.toolbar.show and selectionMode !== 'none'"
                                 t-ref="toolbar"
                                 class="o_aw_cfg_floating d-flex gap-1"
                                 t-attf-style="left: {{state.toolbar.left}}px; top: {{state.toolbar.top}}px;">

                                <t t-if="selectionMode === 'panel'">
                                    <button class="btn btn-sm btn-light" title="Split into two side by side"
                                            t-att-disabled="!canSplit"
                                            t-on-click="() => this.splitPanel('vertical')">
                                        <i class="fa fa-columns"/>
                                    </button>
                                    <button class="btn btn-sm btn-light" title="Split into two stacked"
                                            t-att-disabled="!canSplit"
                                            t-on-click="() => this.splitPanel('horizontal')">
                                        <i class="fa fa-bars"/>
                                    </button>
                                    <button class="btn btn-sm btn-light text-danger" title="Remove this panel"
                                            t-att-disabled="!canRemove"
                                            t-on-click="removePanel">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </t>

                                <t t-else="">
                                    <t t-foreach="junctionOptions" t-as="opt" t-key="opt.value">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedDividerEntry.junction === opt.value ? 'btn-primary' : 'btn-light'"
                                                t-att-disabled="!opt.enabled"
                                                t-att-title="opt.title"
                                                t-on-click="() => this.setJunction(opt.value)">
                                            <t t-esc="opt.label"/>
                                        </button>
                                    </t>
                                </t>
                            </div>

                            <!-- The scrolling viewport. Its pixel size is what
                                 the fitted scale is computed from, so the
                                 ResizeObserver watches exactly this element. -->
                            <div class="o_aw_cfg_canvas h-100 w-100 overflow-auto border rounded bg-white"
                                 t-ref="canvas"
                                 t-on-wheel="onWheel"
                                 t-on-scroll="onCanvasScroll"
                                 t-on-pointerdown="onCanvasPointerDown"
                                 t-on-pointermove="onPointerMove"
                                 t-on-pointerup="onPointerUp">

                                <div t-if="!scene"
                                     class="text-muted text-center d-flex flex-column justify-content-center align-items-center h-100 p-4">
                                    <div class="fs-5 mb-1">No drawing yet</div>
                                    <div class="small">Set a width and a height above to draw this position.</div>
                                </div>

                                <!-- Sized in CSS pixels to fitScale * zoom. At
                                     zoom 1 that's exactly the canvas, so
                                     nothing scrolls; above it the wrapper
                                     overflows and the container scrolls, which
                                     is what makes panning work. margin:auto
                                     keeps it centred while it still fits. -->
                                <div t-else=""
                                     t-attf-style="width: {{renderedSize.w}}px; height: {{renderedSize.h}}px; margin: auto;">

                                    <svg class="o_aw_cfg_svg"
                                         t-ref="svg"
                                         style="display: block; width: 100%; height: 100%;"
                                         t-att-viewBox="scene.viewBox"
                                         preserveAspectRatio="xMidYMid meet">
                                <defs>
                                    <pattern id="aw_mesh" width="5" height="5" patternUnits="userSpaceOnUse">
                                        <rect width="5" height="5" fill="#c3dce3" fill-opacity="0.35"/>
                                        <path d="M0,5 L5,0" stroke="#6a7075" stroke-width="0.7"/>
                                    </pattern>
                                </defs>

                                <!-- outer frame -->
                                <rect t-att-x="scene.frame.x" t-att-y="scene.frame.y"
                                      t-att-width="scene.frame.w" t-att-height="scene.frame.h"
                                      fill="#8a9095" stroke="#6a7075" stroke-width="1"/>

                                <!-- leaves -->
                                <t t-foreach="scene.leaves" t-as="leaf" t-key="leaf.key">
                                    <g style="cursor: pointer"
                                       t-on-click="(ev) => this.selectLeaf(leaf.path, ev)">
                                        <rect t-att-x="leaf.x" t-att-y="leaf.y"
                                              t-att-width="leaf.w" t-att-height="leaf.h"
                                              fill="#8a9095" fill-opacity="0.55"
                                              stroke="#6a7075" stroke-width="0.7"/>
                                        <rect t-att-x="leaf.glassX" t-att-y="leaf.glassY"
                                              t-att-width="leaf.glassW" t-att-height="leaf.glassH"
                                              t-att-fill="leaf.isMesh ? 'url(#aw_mesh)' : '#c3dce3'"
                                              stroke="#9dbfc9" stroke-width="0.6"/>

                                        <path t-if="leaf.glyph.arrow" t-att-d="leaf.glyph.arrow"
                                              stroke="#4a5358" fill="none"
                                              t-att-stroke-width="adornments.arrowStroke"/>

                                        <!-- Opening symbol: apex at the hinge
                                             side, base at the two corners
                                             opposite it. Tilt &amp; turn draws
                                             two, one per opening direction. -->
                                        <t t-foreach="leaf.glyph.triangles or []" t-as="tri" t-key="tri.key">
                                            <polyline t-att-points="tri.points"
                                                      fill="none" stroke="#4a5358"
                                                      t-att-stroke-width="adornments.glyphStroke"
                                                      t-att-stroke-dasharray="adornments.glyphDash"/>
                                        </t>
                                        <text t-if="leaf.glyph.fan"
                                              t-att-x="leaf.glyph.fan.tagX" t-att-y="leaf.glyph.fan.tagY"
                                              fill="#4a5358" text-anchor="middle"
                                              t-att-font-size="adornments.glyphFont"
                                              font-family="monospace">
                                            <t t-esc="leaf.glyph.fan.tag"/>
                                        </text>

                                        <text t-if="leaf.glyph.label"
                                              t-att-x="leaf.glyph.label.x" t-att-y="leaf.glyph.label.y"
                                              fill="#4a5358" text-anchor="middle"
                                              t-att-font-size="adornments.glyphFont"
                                              font-family="monospace">
                                            <t t-esc="leaf.glyph.label.text"/>
                                        </text>

                                        <rect t-if="leaf.selected"
                                              t-att-x="leaf.x + 1" t-att-y="leaf.y + 1"
                                              t-att-width="leaf.w - 2" t-att-height="leaf.h - 2"
                                              fill="none" stroke="#6b4a63" stroke-width="1.8"
                                              stroke-dasharray="4 3"/>

                                        <!-- Panel number. Drawn last so it sits
                                             above the slide arrow rather than
                                             being crossed by it. Radius and font
                                             are in viewBox units derived from
                                             unitsPerPixel, so the badge stays the
                                             same physical size at any zoom. -->
                                        <circle class="o_aw_panel_badge"
                                                t-att-cx="leaf.badge.cx" t-att-cy="leaf.badge.cy"
                                                t-att-r="adornments.badgeR"
                                                t-att-fill="leaf.selected ? '#6b4a63' : '#ffffff'"
                                                t-att-stroke="leaf.selected ? '#6b4a63' : '#6a7075'"
                                                t-att-stroke-width="adornments.badgeR * 0.12"/>
                                        <text class="o_aw_panel_badge_text"
                                              t-att-x="leaf.badge.cx" t-att-y="leaf.badge.cy"
                                              t-att-font-size="adornments.badgeFont"
                                              t-att-fill="leaf.selected ? '#ffffff' : '#14181b'"
                                              text-anchor="middle" dominant-baseline="central">
                                            <t t-esc="leaf.badge.label"/>
                                        </text>
                                    </g>
                                </t>

                                <!-- Draggable dividers. Rendered AFTER the leaves
                                     so they paint on top and win the pointer;
                                     stroke width and hit area come from
                                     the adornments layer, which converts a
                                     constant CSS pixel size into viewBox units,
                                     so neither thins to a sliver when the
                                     drawing is scaled down. -->
                                <t t-foreach="adornments.dividers" t-as="divider" t-key="divider.key">
                                    <g t-attf-class="o_aw_divider o_aw_divider_{{divider.kind}}{{divider.selected ? ' o_aw_divider_selected' : ''}}">
                                        <!-- Junction is drawn, not just stored.
                                             The shapes come from
                                             adornments.junctionShape, so each
                                             type looks different: mullion a
                                             solid bar, meeting two thin lines
                                             with a gap and NO bar, interlock two
                                             bars overlapping. -->
                                        <t t-foreach="divider.shape.bars" t-as="bar" t-key="bar.key">
                                            <rect t-attf-class="o_aw_junction o_aw_junction_{{divider.shape.kind}}"
                                                  t-att-x="bar.x" t-att-y="bar.y"
                                                  t-att-width="bar.w" t-att-height="bar.h"/>
                                        </t>
                                        <t t-foreach="divider.shape.lines" t-as="ln" t-key="ln.key">
                                            <line class="o_aw_divider_line"
                                                  t-att-x1="ln.x" t-att-y1="ln.y1"
                                                  t-att-x2="ln.x" t-att-y2="ln.y2"
                                                  t-att-stroke-width="ln.w"/>
                                        </t>
                                        <rect class="o_aw_divider_hit"
                                              t-att-x="divider.hitX" t-att-y="divider.hitY"
                                              t-att-width="divider.hitW" t-att-height="divider.hitH"
                                              t-on-pointerdown="(ev) => this.onDividerPointerDown(divider, ev)"/>
                                    </g>
                                </t>

                                <!-- dimension lines -->
                                <t t-foreach="scene.dims" t-as="dim" t-key="dim.key">
                                    <line t-att-x1="dim.x1" t-att-y1="dim.y1"
                                          t-att-x2="dim.x2" t-att-y2="dim.y2"
                                          stroke="#4a5358" stroke-width="0.8"/>
                                    <t t-foreach="dim.ticks" t-as="tick" t-key="tick.key">
                                        <line t-att-x1="tick.x1" t-att-y1="tick.y1"
                                              t-att-x2="tick.x2" t-att-y2="tick.y2"
                                              stroke="#4a5358" stroke-width="0.8"/>
                                    </t>
                                    <rect t-att-x="dim.boxX" t-att-y="dim.boxY"
                                          t-att-width="dim.boxW" t-att-height="dim.boxH"
                                          fill="#ffffff"/>
                                    <text t-att-x="dim.textX" t-att-y="dim.textY"
                                          t-att-transform="dim.transform"
                                          fill="#14181b" font-size="10" font-family="monospace"
                                          text-anchor="middle" dominant-baseline="middle">
                                        <t t-esc="dim.text"/>
                                    </text>
                                </t>

                                <line t-att-x1="scene.baseline.x1" t-att-y1="scene.baseline.y1"
                                      t-att-x2="scene.baseline.x2" t-att-y2="scene.baseline.y2"
                                          stroke="#727c82" stroke-width="1"/>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <div t-if="scene" class="text-center text-muted small mt-2 flex-shrink-0">
                            View from inside &#183; triangle points to hinge
                        </div>
                    </div>

                    <!-- RIGHT: selected-leaf properties -->
                    <div class="o_aw_cfg_side border-start bg-view d-flex flex-column flex-shrink-0"
                         style="width: 260px; min-height: 0;">
                        <div class="overflow-auto p-3 flex-grow-1" style="min-height: 0;">
                            <div class="o_aw_cfg_cat small text-muted text-uppercase fw-bold mb-2">
                                <t t-if="selectionMode === 'panel'"><t t-esc="selectedPanelLabel"/></t>
                                <t t-elif="selectionMode === 'divider'">Junction</t>
                                <t t-else="">Selection</t>
                            </div>

                            <!-- Exactly three states, branched on one getter.
                                 Nothing here reads state.selected: it is a
                                 path now, and the old deep reads rendered NaN
                                 for a panel and threw for a divider. -->
                            <t t-if="selectionMode === 'none'">
                                <div class="small text-muted">
                                    Click a panel to edit it, or a vertical
                                    divider to set its junction.
                                </div>
                            </t>

                            <t t-elif="selectionMode === 'divider'">
                                <div class="small text-muted mb-1">
                                    Boundary between two panels
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    <t t-foreach="junctionOptions" t-as="opt" t-key="opt.value">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedDividerEntry.junction === opt.value ? 'btn-primary' : 'btn-outline-secondary'"
                                                t-att-disabled="!opt.enabled"
                                                t-att-title="opt.title"
                                                t-on-click="() => this.setJunction(opt.value)">
                                            <t t-esc="opt.label"/>
                                        </button>
                                    </t>
                                </div>
                            </t>

                            <t t-else="">
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-0">
                                            Width (<t t-esc="uomLabel"/>)
                                        </label>
                                        <input type="text" class="form-control form-control-sm"
                                               t-att-value="selectedPanelWidthText"
                                               t-on-change="(ev) => this.setPanelWidth(ev.target.value)"/>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-0">
                                            Height (<t t-esc="uomLabel"/>)
                                        </label>
                                        <input type="text" class="form-control form-control-sm"
                                               t-att-value="selectedPanelHeightText"
                                               t-on-change="(ev) => this.setPanelHeight(ev.target.value)"/>
                                    </div>
                                </div>

                                <!-- Panel toolbar -->
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            title="Split into two side by side"
                                            t-att-disabled="!canSplit"
                                            t-on-click="() => this.splitPanel('vertical')">
                                        <i class="fa fa-columns"/> Split V
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            title="Split into two stacked"
                                            t-att-disabled="!canSplit"
                                            t-on-click="() => this.splitPanel('horizontal')">
                                        <i class="fa fa-bars"/> Split H
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Remove this panel"
                                            t-att-disabled="!canRemove"
                                            t-on-click="removePanel">
                                        <i class="fa fa-trash"/>
                                    </button>
                                </div>
                                <div t-if="!canSplit" class="small text-muted mb-2">
                                    Maximum subdivision depth reached.
                                </div>

                                <div class="small text-muted mb-1">Leaf type</div>
                                <div t-if="!state.data.leaf_types.length" class="small text-warning mb-2">
                                    <b><t t-esc="state.data.header.window_series_name"/></b>
                                    has no leaf types configured, so none can be
                                    offered. Set them on the Window Series.
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    <!-- NOT t-as="lt": OWL rewrites lt/gt/lte/gte/and/or
                                         into < > <= >= &amp;&amp; || before parsing the
                                         expression, so the loop variable would compile
                                         to `const key1 = <.id;`. -->
                                    <t t-foreach="state.data.leaf_types" t-as="leafType" t-key="leafType.id">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedPanel.leaf_type_id === leafType.id ? 'btn-primary' : 'btn-outline-secondary'"
                                                t-on-click="() => this.setLeafType(leafType.id)">
                                            <t t-esc="leafType.name"/>
                                        </button>
                                    </t>
                                </div>

                                <t t-if="selectedLeafType and selectedLeafType.has_hinge_side">
                                    <div class="small text-muted mb-1">Hinge side</div>
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <t t-foreach="['left', 'right', 'top', 'bottom']" t-as="side" t-key="side">
                                            <button class="btn btn-sm text-capitalize"
                                                    t-att-class="selectedPanel.hinge_side === side ? 'btn-primary' : 'btn-outline-secondary'"
                                                    t-on-click="() => this.setDirection('hinge_side', side)">
                                                <t t-esc="side"/>
                                            </button>
                                        </t>
                                    </div>
                                    <div class="small text-muted mb-1">Swing</div>
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        <t t-foreach="['in', 'out']" t-as="sw" t-key="sw">
                                            <button class="btn btn-sm text-uppercase"
                                                    t-att-class="selectedPanel.swing === sw ? 'btn-primary' : 'btn-outline-secondary'"
                                                    t-on-click="() => this.setDirection('swing', sw)">
                                                <t t-esc="sw"/>
                                            </button>
                                        </t>
                                    </div>
                                </t>

                                <t t-if="selectedLeafType and selectedLeafType.has_slide_dir">
                                    <div class="small text-muted mb-1">Slide direction</div>
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        <t t-foreach="['left', 'right']" t-as="dir" t-key="dir">
                                            <button class="btn btn-sm text-capitalize"
                                                    t-att-class="selectedPanel.slide_dir === dir ? 'btn-primary' : 'btn-outline-secondary'"
                                                    t-on-click="() => this.setDirection('slide_dir', dir)">
                                                <t t-esc="dir"/>
                                            </button>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </div>

                        <!-- Kept clearly separate, and deliberately empty: BOM,
                             pricing, checks and the cut list are later steps. -->
                        <div class="border-top p-3 flex-shrink-0 text-muted small">
                            BOM, pricing, checks and the cut list land here later.
                        </div>
                    </div>
                </div>

            </t>
        </div>
    </t>

</templates>
