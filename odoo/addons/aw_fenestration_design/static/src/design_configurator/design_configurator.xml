<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="aw_fenestration_design.DesignConfigurator">
        <div class="o_aw_configurator d-flex flex-column h-100">

            <div t-if="state.loading" class="d-flex h-100 align-items-center justify-content-center text-muted">
                Loading design...
            </div>

            <t t-else="">
                <!-- Header -->
                <div class="o_aw_cfg_header border-bottom bg-view p-3">
                    <div class="d-flex flex-wrap gap-3 align-items-end">
                        <div>
                            <label class="form-label small text-muted mb-0">Position</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.data.header.name"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('name', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Qty</label>
                            <input type="number" min="1" class="form-control form-control-sm"
                                   style="width: 5rem;"
                                   t-att-value="state.data.header.qty"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('qty', parseInt(ev.target.value) || 1)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Location</label>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="state.data.header.location"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onHeaderChange('location', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">
                                Width (<t t-esc="uomLabel"/>)
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   style="width: 9rem;"
                                   t-att-value="formatLength(state.data.header.width_mm)"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onDimensionChange('width_mm', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">
                                Height (<t t-esc="uomLabel"/>)
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   style="width: 9rem;"
                                   t-att-value="formatLength(state.data.header.height_mm)"
                                   t-on-input="() => this.markDirty()"
                                   t-on-change="(ev) => this.onDimensionChange('height_mm', ev.target.value)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Series</label>
                            <div class="form-control form-control-sm bg-light">
                                <t t-esc="state.data.header.window_series_name"/>
                            </div>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button class="btn btn-sm btn-secondary" t-on-click="openForm">
                                Open Form
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="save"
                                    t-att-disabled="!state.dirty">
                                Save
                            </button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-grow-1 overflow-auto">
                    <!-- Drawing -->
                    <div class="flex-grow-1 d-flex flex-column p-3">
                        <!-- NOT align-items-center, and the svg is NOT h-100.
                             A flex item centred with align-items:center that
                             is taller than its container overflows equally in
                             both directions, and the overflowing TOP can't be
                             scrolled to. That, not the viewBox, is what cut
                             the top off the frame. Top-aligned with the svg
                             sized by its own aspect ratio (width 100%, height
                             auto), it can only ever overflow downwards, which
                             the ancestor's overflow-auto can reach. -->
                        <div class="o_aw_cfg_canvas flex-grow-1 d-flex flex-column justify-content-start border rounded bg-white p-2"
                             t-on-pointermove="onPointerMove" t-on-pointerup="onPointerUp">

                            <div t-if="!scene" class="text-muted text-center m-auto p-4">
                                <div class="fs-5 mb-1">No drawing yet</div>
                                <div class="small">Set a width and a height above to draw this position.</div>
                            </div>

                            <svg t-else="" class="o_aw_cfg_svg"
                                 style="display: block; width: 100%; height: auto; max-width: 100%;"
                                 t-att-viewBox="scene.viewBox"
                                 preserveAspectRatio="xMidYMid meet">
                                <defs>
                                    <pattern id="aw_mesh" width="5" height="5" patternUnits="userSpaceOnUse">
                                        <rect width="5" height="5" fill="#c3dce3" fill-opacity="0.35"/>
                                        <path d="M0,5 L5,0" stroke="#6a7075" stroke-width="0.7"/>
                                    </pattern>
                                </defs>

                                <!-- outer frame -->
                                <rect t-att-x="scene.frame.x" t-att-y="scene.frame.y"
                                      t-att-width="scene.frame.w" t-att-height="scene.frame.h"
                                      fill="#8a9095" stroke="#6a7075" stroke-width="1"/>

                                <!-- leaves -->
                                <t t-foreach="scene.leaves" t-as="leaf" t-key="leaf.key">
                                    <g style="cursor: pointer"
                                       t-on-click="() => this.selectLeaf(leaf.ri, leaf.li)">
                                        <rect t-att-x="leaf.x" t-att-y="leaf.y"
                                              t-att-width="leaf.w" t-att-height="leaf.h"
                                              fill="#8a9095" fill-opacity="0.55"
                                              stroke="#6a7075" stroke-width="0.7"/>
                                        <rect t-att-x="leaf.glassX" t-att-y="leaf.glassY"
                                              t-att-width="leaf.glassW" t-att-height="leaf.glassH"
                                              t-att-fill="leaf.isMesh ? 'url(#aw_mesh)' : '#c3dce3'"
                                              stroke="#9dbfc9" stroke-width="0.6"/>

                                        <path t-if="leaf.glyph.arrow" t-att-d="leaf.glyph.arrow"
                                              stroke="#4a5358" stroke-width="1.1" fill="none"/>

                                        <t t-if="leaf.glyph.fan">
                                            <t t-foreach="leaf.glyph.fan.lines" t-as="fl" t-key="fl.key">
                                                <line t-att-x1="fl.x1" t-att-y1="fl.y1"
                                                      t-att-x2="fl.x2" t-att-y2="fl.y2"
                                                      stroke="#4a5358" stroke-width="0.6"
                                                      stroke-dasharray="3 2"/>
                                            </t>
                                            <circle t-att-cx="leaf.glyph.fan.cx" t-att-cy="leaf.glyph.fan.cy"
                                                    r="2.6" fill="#6b4a63"/>
                                            <text t-att-x="leaf.glyph.fan.tagX" t-att-y="leaf.glyph.fan.tagY"
                                                  fill="#4a5358" font-size="8.5" text-anchor="middle"
                                                  font-family="monospace">
                                                <t t-esc="leaf.glyph.fan.tag"/>
                                            </text>
                                        </t>

                                        <text t-if="leaf.glyph.label"
                                              t-att-x="leaf.glyph.label.x" t-att-y="leaf.glyph.label.y"
                                              fill="#4a5358" font-size="9" text-anchor="middle"
                                              font-family="monospace">
                                            <t t-esc="leaf.glyph.label.text"/>
                                        </text>

                                        <rect t-if="leaf.selected"
                                              t-att-x="leaf.x + 1" t-att-y="leaf.y + 1"
                                              t-att-width="leaf.w - 2" t-att-height="leaf.h - 2"
                                              fill="none" stroke="#6b4a63" stroke-width="1.8"
                                              stroke-dasharray="4 3"/>
                                    </g>
                                </t>

                                <!-- draggable dividers -->
                                <t t-foreach="scene.dividers" t-as="divider" t-key="divider.key">
                                    <line t-att-x1="divider.x1" t-att-y1="divider.y1"
                                          t-att-x2="divider.x2" t-att-y2="divider.y2"
                                          stroke="#6b4a63" stroke-width="1.2" stroke-opacity="0.45"/>
                                    <rect t-att-x="divider.hitX" t-att-y="divider.hitY"
                                          t-att-width="divider.hitW" t-att-height="divider.hitH"
                                          fill="transparent"
                                          t-att-style="divider.kind === 'v' ? 'cursor: col-resize' : 'cursor: row-resize'"
                                          t-on-pointerdown="(ev) => this.onDividerPointerDown(divider, ev)"/>
                                </t>

                                <!-- dimension lines -->
                                <t t-foreach="scene.dims" t-as="dim" t-key="dim.key">
                                    <line t-att-x1="dim.x1" t-att-y1="dim.y1"
                                          t-att-x2="dim.x2" t-att-y2="dim.y2"
                                          stroke="#4a5358" stroke-width="0.8"/>
                                    <t t-foreach="dim.ticks" t-as="tick" t-key="tick.key">
                                        <line t-att-x1="tick.x1" t-att-y1="tick.y1"
                                              t-att-x2="tick.x2" t-att-y2="tick.y2"
                                              stroke="#4a5358" stroke-width="0.8"/>
                                    </t>
                                    <rect t-att-x="dim.boxX" t-att-y="dim.boxY"
                                          t-att-width="dim.boxW" t-att-height="dim.boxH"
                                          fill="#ffffff"/>
                                    <text t-att-x="dim.textX" t-att-y="dim.textY"
                                          t-att-transform="dim.transform"
                                          fill="#14181b" font-size="10" font-family="monospace"
                                          text-anchor="middle" dominant-baseline="middle">
                                        <t t-esc="dim.text"/>
                                    </text>
                                </t>

                                <line t-att-x1="scene.baseline.x1" t-att-y1="scene.baseline.y1"
                                      t-att-x2="scene.baseline.x2" t-att-y2="scene.baseline.y2"
                                      stroke="#727c82" stroke-width="1"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Side panel: intentionally empty, see Stage F scope note -->
                    <div class="o_aw_cfg_side border-start bg-view p-3" style="width: 18rem;">
                        <div class="small text-muted">
                            BOM, pricing, checks and the cut list land here later.
                        </div>
                    </div>
                </div>

                <!-- Chips -->
                <div class="o_aw_cfg_chips border-top bg-view p-3">
                    <t t-foreach="presetsByCategory" t-as="group" t-key="group.category">
                        <div class="mb-2">
                            <div class="small text-muted mb-1"><t t-esc="group.category"/></div>
                            <div class="d-flex flex-wrap gap-1">
                                <t t-foreach="group.presets" t-as="preset" t-key="preset.id">
                                    <button class="btn btn-sm btn-outline-primary"
                                            t-on-click="() => this.applyPreset(preset)">
                                        <t t-esc="preset.name"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                    <!-- Empty states are stated rather than rendered as an
                         empty strip: an invisible cause looks like a broken
                         screen, which is exactly how the Series leaf-type
                         mapping went unnoticed. -->
                    <div t-if="!state.data.presets.length" class="small text-warning mb-2">
                        <t t-if="!state.data.leaf_types.length">
                            No layout presets can be offered:
                            <b><t t-esc="state.data.header.window_series_name"/></b>
                            has no leaf types configured.
                        </t>
                        <t t-else="">
                            No layout preset matches
                            <b><t t-esc="state.data.header.window_series_name"/></b>'s
                            allowed leaf types
                            (<t t-esc="state.data.leaf_types.map(t => t.name).join(', ')"/>).
                        </t>
                    </div>

                    <t t-if="selectedLeaf">
                        <div class="border-top pt-2 mt-2">
                            <div class="small text-muted mb-1">Leaf type</div>
                            <div t-if="!state.data.leaf_types.length" class="small text-warning mb-2">
                                <b><t t-esc="state.data.header.window_series_name"/></b>
                                has no leaf types configured, so none can be
                                offered. Set them on the Window Series.
                            </div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <!-- NOT t-as="lt": OWL rewrites lt/gt/lte/gte/and/or
                                     into < > <= >= &amp;&amp; || before parsing the
                                     expression, so the loop variable would compile
                                     to `const key1 = <.id;`. -->
                                <t t-foreach="state.data.leaf_types" t-as="leafType" t-key="leafType.id">
                                    <button class="btn btn-sm"
                                            t-att-class="selectedLeaf.leaf_type_id === leafType.id ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => this.setLeafType(leafType.id)">
                                        <t t-esc="leafType.name"/>
                                    </button>
                                </t>
                            </div>

                            <t t-if="selectedLeafType and selectedLeafType.has_hinge_side">
                                <div class="small text-muted mb-1">Hinge / swing</div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <t t-foreach="['left', 'right', 'top', 'bottom']" t-as="side" t-key="side">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedLeaf.hinge_side === side ? 'btn-primary' : 'btn-outline-secondary'"
                                                t-on-click="() => this.setDirection('hinge_side', side)">
                                            <t t-esc="side"/>
                                        </button>
                                    </t>
                                    <span class="mx-1"/>
                                    <t t-foreach="['in', 'out']" t-as="sw" t-key="sw">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedLeaf.swing === sw ? 'btn-primary' : 'btn-outline-secondary'"
                                                t-on-click="() => this.setDirection('swing', sw)">
                                            <t t-esc="sw"/>
                                        </button>
                                    </t>
                                </div>
                            </t>

                            <t t-if="selectedLeafType and selectedLeafType.has_slide_dir">
                                <div class="small text-muted mb-1">Slide direction</div>
                                <div class="d-flex flex-wrap gap-1">
                                    <t t-foreach="['left', 'right']" t-as="dir" t-key="dir">
                                        <button class="btn btn-sm"
                                                t-att-class="selectedLeaf.slide_dir === dir ? 'btn-primary' : 'btn-outline-secondary'"
                                                t-on-click="() => this.setDirection('slide_dir', dir)">
                                            <t t-esc="dir"/>
                                        </button>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
