<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="aw_fenestration_design.RatesTable"
       t-inherit="aw_fenestration_core.RatesTable" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='cell.price !== null']" position="inside">
            <div t-if="cell.lpp" class="small text-info"
                 t-esc="lppText(cell.lpp)"/>
            <div t-if="cell.cur" class="small fw-bold"
                 t-esc="curText(cell.cur)"/>
        </xpath>
    </t>

</templates>
