<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The single generic product every design's sale.order.line
             points at. It carries no pricing and no description of its
             own on purpose: the line's name is rewritten from the design
             (position ref, location, size, series) and its price comes
             from the design's manual_rate for now, from the real cost
             cascade in Step 3. noupdate so a user renaming it or setting
             a default price isn't silently reverted on every upgrade. -->
        <record id="product_fenestration_position" model="product.template">
            <field name="name">Fenestration Position</field>
            <!-- Service, not Goods. Since Odoo 17 a consu product is
                 Goods and confirming a sale runs procurement for it,
                 which failed here with "No rule has been found to
                 replenish ... in 'Inter-warehouse transit'". There is
                 no production or installation flow for windows yet, so
                 a position is work that is quoted and invoiced, not
                 goods that are shipped. [revisit] when that flow
                 exists. Existing databases are moved by
                 _migrate_position_product_to_service(), since this
                 block is noupdate. -->
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="categ_id" ref="aw_fenestration_core.product_category_fenestration"/>
            <field name="description_sale">Configured window/door position. See the linked Design for geometry.</field>
        </record>

    </data>

    <!-- Updatable, not noupdate: the record above is noupdate so a
         renamed product is not reverted, which also means an existing
         database never sees the type change. This runs on every
         upgrade and is a no-op once done. -->
    <data>
        <function model="product.template"
                  name="_migrate_position_product_to_service"/>
    </data>
</odoo>
