<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        Ported from docs/prototype/fenestration-quote-demo.html: the ROWS
        templates (~437), PRESET_CATS (~452) and PRESETS (~458). Category
        labels are PRESET_CATS' own labels; names are PRESETS' labels.

        Leaf keys mapped to aw.leaf.type codes as specified:
        fixed->FIXED, slider->SLIDER, casement->CASEMENT, awning->AWNING,
        hopper->HOPPER, mesh->MESH.

        Every h/w is 1 because the prototype has no sizes in its templates
        at all: normaliseRows() (~474) splits each row's height and each
        leaf's width equally. Equal weights reproduce that exactly while
        leaving unequal presets expressible later.

        Deliberately NOT ported: PRESETS' "kinds" filtering. That keys off
        the prototype's series-kind concept (sliding/hinged/fixed), which
        no longer exists. Series is the only layer now, and presets are
        filtered by whether the design's Series can host every leaf type
        they need (aw.layout.preset._allowed_for_series).
        noupdate so edits and new presets survive an upgrade.
        -->

        <record id="layout_preset_fixed" model="aw.layout.preset">
            <field name="name">Fixed</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">10</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}]}</field>
        </record>

        <record id="layout_preset_casement" model="aw.layout.preset">
            <field name="name">Casement</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">20</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "CASEMENT", "hinge": "left", "swing": "out"}]}]}</field>
        </record>

        <record id="layout_preset_fix_casement" model="aw.layout.preset">
            <field name="name">Fix + Casement</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">30</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "FIXED"}, {"w": 1, "type": "CASEMENT", "hinge": "right", "swing": "out"}]}]}</field>
        </record>

        <record id="layout_preset_twin_sash" model="aw.layout.preset">
            <field name="name">Twin Sash: case+fix+case</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">40</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "CASEMENT", "hinge": "left", "swing": "in"}, {"w": 1, "type": "FIXED"}, {"w": 1, "type": "CASEMENT", "hinge": "right", "swing": "in"}]}]}</field>
        </record>

        <record id="layout_preset_hopper_over_fixed" model="aw.layout.preset">
            <field name="name">Hopper over Fixed</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">50</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "HOPPER", "hinge": "bottom", "swing": "out"}]}, {"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}]}</field>
        </record>

        <record id="layout_preset_two_across_one_below" model="aw.layout.preset">
            <field name="name">2-across / 1 below</field>
            <field name="category">Openable Designs</field>
            <field name="sequence">60</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "CASEMENT", "hinge": "left", "swing": "out"}, {"w": 1, "type": "FIXED"}]}, {"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}]}</field>
        </record>

        <record id="layout_preset_2track_fix_slide" model="aw.layout.preset">
            <field name="name">2 Track 2 Panel (Fix+Slide)</field>
            <field name="category">Sliding Designs</field>
            <field name="sequence">70</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "FIXED"}, {"w": 1, "type": "SLIDER", "slide": "left"}]}]}</field>
        </record>

        <record id="layout_preset_2track_2panel" model="aw.layout.preset">
            <field name="name">2 Track 2 Panel</field>
            <field name="category">Sliding Designs</field>
            <field name="sequence">80</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "SLIDER", "slide": "right"}, {"w": 1, "type": "SLIDER", "slide": "left"}]}]}</field>
        </record>

        <record id="layout_preset_3track_mesh" model="aw.layout.preset">
            <field name="name">3 Track + Mesh</field>
            <field name="category">Add-on Mesh Sash</field>
            <field name="sequence">90</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "SLIDER", "slide": "right"}, {"w": 1, "type": "SLIDER", "slide": "left"}, {"w": 1, "type": "MESH", "slide": "left"}]}]}</field>
        </record>

        <record id="layout_preset_stack3" model="aw.layout.preset">
            <field name="name">3-tier fixed stack</field>
            <field name="category">Stick Curtain Wall Designs</field>
            <field name="sequence">100</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}, {"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}, {"h": 1, "leaves": [{"w": 1, "type": "FIXED"}]}]}</field>
        </record>

        <record id="layout_preset_curtain_wall_vent" model="aw.layout.preset">
            <field name="name">Curtain wall + vent</field>
            <field name="category">Stick Curtain Wall Designs</field>
            <field name="sequence">110</field>
            <field name="layout_json">{"rows": [{"h": 1, "leaves": [{"w": 1, "type": "FIXED"}, {"w": 1, "type": "CASEMENT", "hinge": "right", "swing": "out"}]}]}</field>
        </record>

    </data>
</odoo>
