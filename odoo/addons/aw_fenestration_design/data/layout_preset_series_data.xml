<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Assigns the seeded presets their starting Series. Same mechanism as
    aw_fenestration_core's window_series_data.xml, for the same reason:
    the method fills ONLY a preset whose series_ids is empty, so it
    applies once per preset and a later UI edit is never overwritten.

    Separate file from layout_preset_data.xml because that one is
    noupdate="1" (so preset names and layouts survive upgrades), and
    convert.py's _tag_function skips a function inside a noupdate block
    unless the module is being installed for the first time, so the
    assignment would then never reach an existing database.

    Loads after layout_preset_data.xml so the presets it refers to exist.
    -->
    <data>
        <function model="aw.layout.family" name="_migrate_preset_categories"/>
        <function model="aw.infill.type" name="_seed_default_family"/>
        <function model="aw.layout.preset" name="_apply_preset_corrections"/>
        <function model="aw.layout.preset" name="_seed_default_series"/>
        <!-- Part 2 (revised), in this order: classify what is already
             there, archive the mechanism-based set and its families,
             then seed Shapes and Designs. Classifying first means the
             new entries are not re-examined by it. -->
        <function model="aw.layout.preset" name="_classify_existing_presets"/>
        <function model="aw.layout.preset" name="_retire_mechanism_presets"/>
        <function model="aw.layout.preset" name="_retire_layout_families"/>
        <function model="aw.layout.preset" name="_seed_layout_library"/>
    </data>
</odoo>
