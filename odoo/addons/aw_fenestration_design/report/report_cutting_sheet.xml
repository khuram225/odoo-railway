<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    For a manual mitre saw. Grouped by profile, bars in order, longest
    cut first within each bar: that is how an operator works down a
    length, and it keeps the offcut in one usable piece rather than
    scattered between cuts.
    -->
    <template id="report_cutting_sheet_document">
        <t t-call="web.external_layout">
            <div class="page">

                <h2 class="mt-0">
                    Cutting Sheet
                    <span class="float-end"
                          t-esc="doc.sale_order_id.name or ''"/>
                </h2>

                <div t-if="not doc.is_current"
                     class="alert alert-warning border border-dark p-2 mb-3">
                    <strong>⚠ Out of date — a position changed after this
                    plan was made. Regenerate before cutting.</strong>
                </div>

                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td style="width:18%"><strong>Planned</strong></td>
                        <td style="width:32%"><span t-field="doc.date"/></td>
                        <td style="width:18%"><strong>Stock lengths</strong></td>
                        <td><span t-esc="doc.stock_lengths_ft"/> ft</td>
                    </tr>
                    <tr>
                        <td><strong>Kerf</strong></td>
                        <td><span t-esc="'%g' % doc.kerf_mm"/> mm</td>
                        <td><strong>Min. offcut</strong></td>
                        <td><span t-esc="'%g' % doc.offcut_min_mm"/> mm</td>
                    </tr>
                    <tr>
                        <td><strong>Longest piece</strong></td>
                        <td><span t-esc="'%.1f' % doc.max_piece_mm"/> mm</td>
                        <td><strong>Optimality</strong></td>
                        <td><span t-esc="doc.optimality_note or ''"/></td>
                    </tr>
                </table>

                <div t-if="doc.oversize_note"
                     class="alert alert-danger p-2 mb-3">
                    <strong>These pieces are NOT on any bar:</strong>
                    <div style="white-space: pre-line;"
                         t-esc="doc.oversize_note"/>
                </div>

                <t t-foreach="doc.group_ids" t-as="group" t-key="group.id">
                    <h4 class="mt-4">
                        <span t-field="group.product_id"/>
                        <span class="float-end small text-muted">
                            <span t-esc="group.bars_summary"/>
                            · yield <span t-esc="'%.1f' % group.yield_pct"/>%
                            <t t-if="group.is_overridden"> · manual choice</t>
                        </span>
                    </h4>

                    <t t-foreach="group.bar_ids" t-as="bar" t-key="bar.id">
                        <table class="table table-sm o_main_table mb-2">
                            <thead>
                                <tr>
                                    <th colspan="5"
                                        style="background:#f0f0f0;">
                                        Bar <span t-esc="bar_index + 1"/>
                                        of <span t-esc="len(group.bar_ids)"/>
                                        — <span t-esc="bar.stock_label"/>
                                        <span class="float-end">
                                            Remainder
                                            <span t-esc="bar.remainder_label"/>
                                            <t t-if="bar.is_returnable">
                                                — return to stock
                                            </t>
                                        </span>
                                    </th>
                                </tr>
                                <tr>
                                    <th style="width:6%">#</th>
                                    <th style="width:16%">Ref</th>
                                    <th>Label</th>
                                    <th class="text-end">Length</th>
                                    <th class="text-end">Angle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bar.cut_ids" t-as="cut"
                                    t-key="cut.id">
                                    <td><span t-esc="cut_index + 1"/></td>
                                    <td>
                                        <strong t-esc="cut.piece_ref or ''"/>
                                    </td>
                                    <td><span t-esc="cut.label or ''"/></td>
                                    <td class="text-end">
                                        <strong t-esc="cut.length_label"/>
                                        <span class="text-muted small">
                                            (<span t-esc="'%.1f' % cut.length_mm"/> mm)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="cut.cut_angle or '—'"/>°
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <h4 class="mt-4">Bars to buy</h4>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Profile</th>
                            <th>Bars</th>
                            <th class="text-end">Feet bought</th>
                            <th class="text-end">Feet used</th>
                            <th class="text-end">Yield</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.group_ids" t-as="group"
                            t-key="group.id">
                            <td><span t-field="group.product_id"/></td>
                            <td><span t-esc="group.bars_summary"/></td>
                            <td class="text-end">
                                <span t-esc="'%.2f' % group.feet_bought"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="'%.2f' % group.feet_used"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="'%.1f' % group.yield_pct"/>%
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="small text-muted">
                    Measured wastage
                    <strong t-esc="'%.1f' % doc.measured_wastage_pct"/>%
                    against
                    <span t-esc="'%.1f' % doc.assumed_wastage_pct"/>%
                    assumed by the price structure.
                </p>

            </div>
        </t>
    </template>

    <template id="report_cutting_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="aw_fenestration_design.report_cutting_sheet_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_aw_cutting_sheet" model="ir.actions.report">
        <field name="name">Cutting Sheet</field>
        <field name="model">aw.cut.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aw_fenestration_design.report_cutting_sheet</field>
        <field name="report_file">aw_fenestration_design.report_cutting_sheet</field>
        <field name="print_report_name">'Cutting Sheet - %s' % (object.sale_order_id.name or '')</field>
        <field name="binding_model_id" ref="model_aw_cut_plan"/>
        <field name="binding_type">report</field>
    </record>

    <!--
    Piece stickers. Rows come from _sticker_rows() in CUTTING order
    (group, bar, cut): the operator peels them in the order the saw
    works, not in the order the BOM happened to be built.

    A TABLE, one row of two cells: QR on the left at the cell's full
    usable height, text on the right. Not flexbox. wkhtmltopdf is
    QtWebKit and does not implement flex, so display:flex silently
    degrades to block, which is exactly what went wrong: the text
    stacked ABOVE the QR, the sticker grew past its 29.7 mm cell, and
    every QR overlapped the row below. A table is the layout primitive
    QtWebKit does handle, and table-layout:fixed stops a long profile
    name widening the text cell and pushing the QR out.

    Every box is sized in mm with overflow hidden, so a sticker cannot
    spill into its neighbour whatever the content turns out to be.
    -->
    <template id="report_cut_sticker">
        <div t-attf-style="box-sizing:border-box; overflow:hidden; #{style}">
            <table style="width:100%; height:100%; table-layout:fixed; border-collapse:collapse;">
                <tr>
                    <td t-attf-style="width:#{qr_size}; vertical-align:top; padding:0;">
                        <!-- src is built in Python (_qr_src): the
                             barcode controller only accepts barLevel as
                             a query parameter, and the payload carries
                             slashes and pipes that the path form would
                             mangle. -->
                        <img t-att-src="row['qr_src']"
                             t-attf-style="width:#{qr_size}; height:#{qr_size}; display:block;"/>
                    </td>
                    <td style="vertical-align:top; padding:0 0 0 1.5mm;">
                        <div t-attf-style="overflow:hidden; #{text_box}">
                            <div t-attf-style="font-weight:bold; line-height:1.0; font-size:#{ref_size};">
                                <span t-esc="row['ref']"/>
                            </div>
                            <div t-attf-style="font-size:#{small}; line-height:1.15;">
                                <div><span t-esc="row['role']"/></div>
                                <div>
                                    <span t-esc="row['profile']"/>
                                    <t t-if="row['thickness']"> &#183; <span t-esc="row['thickness']"/></t>
                                    <t t-if="row['finish']"> &#183; <span t-esc="row['finish']"/></t>
                                </div>
                                <div style="font-weight:bold;">
                                    <span t-esc="row['length']"/>
                                    (<span t-esc="'%.1f' % row['length_mm']"/> mm)
                                    <t t-if="row['angle']">
                                        &#183; <span t-esc="row['angle']"/>&#176;/<span t-esc="row['angle']"/>&#176;
                                    </t>
                                </div>
                                <div>
                                    <span t-esc="row['position']"/>
                                    <t t-if="row['location']"> &#183; <span t-esc="row['location']"/></t>
                                </div>
                                <div>
                                    <span t-esc="row['quote']"/> &#183; bar
                                    <span t-esc="row['bar_no']"/>/<span t-esc="row['bar_total']"/>
                                    &#183; cut <span t-esc="row['cut_no']"/>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!--
    Precut A4 label stock. Each sticker is placed ABSOLUTELY on the
    sheet grid rather than flowed, because the paper is already cut and
    a flowed layout only has to be a millimetre out to spoil a sheet.
    The grid, the printer offset and the safe inner padding all come
    from settings, so a different sheet is a settings change.
    -->
    <template id="report_cut_labels_document">
        <t t-call="web.basic_layout">
            <t t-foreach="doc._sticker_pages(start_at)" t-as="page"
               t-key="page_index">
                <div class="page"
                     style="position:relative; width:210mm; height:297mm; margin:0; padding:0;">
                    <t t-foreach="page" t-as="cell" t-key="cell_index">
                        <div t-att-style="cell['box']">
                            <t t-call="aw_fenestration_design.report_cut_sticker">
                                <t t-set="row" t-value="cell['row']"/>
                                <t t-set="style" t-value="cell['inner']"/>
                                <t t-set="ref_size" t-value="cell['ref_size']"/>
                                <t t-set="small" t-value="cell['small']"/>
                                <t t-set="qr_size" t-value="cell['qr_size']"/>
                                <t t-set="text_box" t-value="cell['text_box']"/>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <template id="report_cut_labels">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="aw_fenestration_design.report_cut_labels_document"/>
            </t>
        </t>
    </template>

    <!-- Zero margins: the grid is positioned from the sheet's own
         corner, so any page margin would shift every label. -->
    <record id="paperformat_aw_label_sheet" model="report.paperformat">
        <field name="name">Fenestration Label Sheet A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <record id="action_report_aw_cut_labels" model="ir.actions.report">
        <field name="name">Piece Stickers (label sheet)</field>
        <field name="model">aw.cut.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aw_fenestration_design.report_cut_labels</field>
        <field name="report_file">aw_fenestration_design.report_cut_labels</field>
        <field name="print_report_name">'Piece Stickers - %s' % (object.sale_order_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_aw_label_sheet"/>
        <field name="binding_model_id" ref="model_aw_cut_plan"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
