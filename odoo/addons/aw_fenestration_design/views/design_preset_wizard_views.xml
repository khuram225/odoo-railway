<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_design_preset_wizard_form" model="ir.ui.view">
        <field name="name">aw.design.preset.wizard.form</field>
        <field name="model">aw.design.preset.wizard</field>
        <field name="arch" type="xml">
            <form string="Save Layout as Preset">
                <group>
                    <field name="design_id" invisible="1"/>
                    <field name="name"/>
                    <field name="code" placeholder="e.g. OPN-FRN"/>
                    <field name="family_id"/>
                    <field name="series_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="Any Series"/>
                </group>
                <div class="text-muted">
                    The current layout is saved as relative proportions, so
                    the preset works on a position of any size. Nesting,
                    junctions and tracks are all included.
                </div>
                <footer>
                    <button name="action_save" type="object"
                            string="Save Preset" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
