<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Confirmed: menu_aw_fenestration_root exists in
         aw_fenestration_core/views/menu_views.xml. A hard module
         dependency (aw_fenestration_core is in this module's depends)
         guarantees it's fully installed before this file loads, so no
         same-module load-order fix is needed here the way there was in
         design_views.xml. -->

    <menuitem id="menu_aw_design"
              name="Designs"
              parent="aw_fenestration_core.menu_aw_fenestration_root"
              action="action_aw_design"
              sequence="20"/>

    <!-- Phase 7d: the layout library is one submenu rather than four
         siblings of Profile Rates. Families, presets and the three
         attachment lists are all "what a layout can be drawn from",
         and they were crowding out the things a manager actually goes
         to Configuration for. -->
    <menuitem id="menu_aw_layout_library"
              name="Layout Library"
              parent="aw_fenestration_core.menu_aw_fenestration_config"
              sequence="10"/>

    <menuitem id="menu_aw_layout_family"
              name="Layout Families"
              parent="menu_aw_layout_library"
              action="action_aw_layout_family"
              sequence="5"/>

    <menuitem id="menu_aw_layout_preset"
              name="Layout Presets"
              parent="menu_aw_layout_library"
              action="action_aw_layout_preset"
              sequence="10"/>

    <menuitem id="menu_aw_mesh_type"
              name="Mesh Types"
              parent="menu_aw_layout_library"
              action="action_aw_mesh_type"
              sequence="20"/>

    <menuitem id="menu_aw_infill_type"
              name="Infill Types"
              parent="menu_aw_layout_library"
              action="action_aw_infill_type"
              sequence="30"/>

    <menuitem id="menu_aw_grid_pattern"
              name="Grid Patterns"
              parent="menu_aw_layout_library"
              action="action_aw_grid_pattern"
              sequence="40"/>

</odoo>
