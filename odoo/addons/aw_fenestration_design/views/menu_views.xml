<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The groups live in aw_fenestration_core/views/menu_views.xml,
         loaded before this module, so these parents resolve at parse
         time. Designs is a window being quoted; the Layout Library and
         Panel Options are screens somebody works IN, so they sit under
         Library rather than Setup. The two reports of glass migrated from
         the saved specs are no longer in the menu; their actions remain,
         so a bookmark still opens them. -->
    <menuitem id="menu_aw_design"
              name="Designs"
              parent="aw_fenestration_core.menu_aw_group_designs"
              action="action_aw_design"
              sequence="10"/>
    <menuitem id="menu_aw_layout_library"
              name="Layout Library"
              parent="aw_fenestration_core.menu_aw_group_library"
              action="action_aw_layout_preset"
              sequence="10"/>
    <menuitem id="menu_aw_panel_option"
              name="Panel Options"
              parent="aw_fenestration_core.menu_aw_group_library"
              action="action_aw_panel_option"
              sequence="20"/>
</odoo>
