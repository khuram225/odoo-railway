<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Confirmed: menu_aw_fenestration_root exists in
         aw_fenestration_core/views/menu_views.xml. A hard module
         dependency (aw_fenestration_core is in this module's depends)
         guarantees it's fully installed before this file loads, so no
         same-module load-order fix is needed here the way there was in
         design_views.xml. -->

    <menuitem id="menu_aw_design"
              name="Designs"
              parent="aw_fenestration_core.menu_aw_fenestration_root"
              action="action_aw_design"
              sequence="20"/>

    <!-- Part 2 (revised): the Layout Library and Panel Options are
         screens somebody works IN, not set-once lists, so they sit at
         the top rather than under Configuration. Configuration now
         holds only what is configured once and left alone.

         Layout Families, Layout Presets, Mesh Types, Infill Types and
         Grid Patterns are gone as separate menu items: presets ARE the
         library, and the three option lists are one screen. The
         actions survive, so bookmarks still work. -->
    <menuitem id="menu_aw_layout_library"
              name="Layout Library"
              parent="aw_fenestration_core.menu_aw_fenestration_root"
              action="action_aw_layout_preset"
              sequence="30"/>

    <menuitem id="menu_aw_panel_option"
              name="Panel Options"
              parent="aw_fenestration_core.menu_aw_fenestration_root"
              action="action_aw_panel_option"
              sequence="40"/>

</odoo>
