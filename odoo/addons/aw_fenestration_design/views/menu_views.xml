<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Confirmed: menu_aw_fenestration_root exists in
         aw_fenestration_core/views/menu_views.xml. A hard module
         dependency (aw_fenestration_core is in this module's depends)
         guarantees it's fully installed before this file loads, so no
         same-module load-order fix is needed here the way there was in
         design_views.xml. -->

    <menuitem id="menu_aw_design"
              name="Designs"
              parent="aw_fenestration_core.menu_aw_fenestration_root"
              action="action_aw_design"
              sequence="20"/>

    <!-- menu_aw_fenestration_config is core's Configuration menu, added in
         the units round. Same cross-module reasoning as above: the hard
         dependency guarantees it exists by the time this loads. -->
    <menuitem id="menu_aw_layout_family"
              name="Layout Families"
              parent="aw_fenestration_core.menu_aw_fenestration_config"
              action="action_aw_layout_family"
              sequence="5"/>

    <menuitem id="menu_aw_layout_preset"
              name="Layout Presets"
              parent="aw_fenestration_core.menu_aw_fenestration_config"
              action="action_aw_layout_preset"
              sequence="10"/>

</odoo>
