<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Confirmed against aw_fenestration_core's own views before trusting
    this: <chatter/> and the <list editable="bottom"> inline-edit pattern
    both match what's already live and working there. Two real bugs
    fixed in this file before it was committed, both matching mistakes
    already made and fixed twice before in aw_fenestration_core; see
    CLAUDE.md's load-order note: the "Rows" stat button was type="object"
    with a %(xmlid)d action reference (needs type="action"), and
    action_aw_design_row was defined AFTER the view that references it
    via %()d, which resolves eagerly at parse time, not lazily.

    Deliberately NOT built here, per the agreed scope (data model only):
      - the row/leaf "Automatic" dimension-lock recompute logic (is_auto
        exists as a field, nothing enforces or recomputes around it yet)
      - the Explode BOM button's actual behavior — action_explode() is a
        stub that raises NotImplementedError by design; the button below
        calls it so that's visibly true in testing, not silently absent
      - any Checks / manufacturability validation display
      - the visual canvas — this is plain list-based row/leaf entry only
    -->

    <record id="view_aw_design_row_form" model="ir.ui.view">
        <field name="name">aw.design.row.form</field>
        <field name="model">aw.design.row</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="length_uom" invisible="1"/>
                    <group>
                        <field name="design_id" readonly="1"/>
                        <field name="sequence"/>
                        <label for="height_ft" string="Height" invisible="length_uom != 'ftin'"/>
                        <div class="o_row" invisible="length_uom != 'ftin'">
                            <field name="height_ft"/>
                            <span>ft</span>
                            <field name="height_in"/>
                            <span>in</span>
                        </div>
                        <field name="height_inch_total" string="Height (in)" invisible="length_uom != 'in'"/>
                        <field name="height_mm" readonly="length_uom != 'mm'"/>
                        <field name="is_auto"/>
                    </group>
                    <field name="leaf_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <!-- length_uom stays in the list because the *_mm
                                 readonly= below is a per-ROW modifier and
                                 needs the row's own value. The column_invisible
                                 below must use parent.* instead: it's evaluated
                                 once per list against the parent record, never
                                 per row. Parent here is the aw.design.row. -->
                            <field name="length_uom" column_invisible="1"/>
                            <field name="width_ft" column_invisible="parent.length_uom != 'ftin'"/>
                            <field name="width_in" column_invisible="parent.length_uom != 'ftin'"/>
                            <field name="width_inch_total" string="Width (in)" column_invisible="parent.length_uom != 'in'"/>
                            <field name="width_mm" readonly="length_uom != 'mm'"/>
                            <field name="is_auto"/>
                            <field name="leaf_type_id"/>
                            <field name="leaf_has_hinge_side" column_invisible="1"/>
                            <field name="leaf_has_slide_dir" column_invisible="1"/>
                            <!-- invisible=, not column_invisible=: which
                                 direction fields apply depends on each leaf's
                                 own leaf_type_id, so this is per-row. The
                                 columns stay present; individual cells blank
                                 out. -->
                            <field name="hinge_side"
                                   invisible="not leaf_has_hinge_side"/>
                            <field name="swing"
                                   invisible="not leaf_has_hinge_side"/>
                            <field name="slide_dir"
                                   invisible="not leaf_has_slide_dir"/>
                            <!-- Per-row, like the direction columns: a
                                 lock only applies to an opening sash. -->
                            <field name="has_lock" string="Lock"
                                   invisible="not leaf_has_hinge_side"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aw_design_row" model="ir.actions.act_window">
        <field name="name">Rows</field>
        <field name="res_model">aw.design.row</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('design_id', '=', active_id)]</field>
    </record>

    <record id="view_aw_design_form" model="ir.ui.view">
        <field name="name">aw.design.form</field>
        <field name="model">aw.design</field>
        <field name="arch" type="xml">
            <form edit="false">
                <header>
                    <button name="action_open_configurator" type="object"
                            string="Open Configurator" class="btn-primary"/>
                    <button name="action_print_shop_drawing" type="object"
                            string="Shop Drawing"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="elevation_is_current" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="status"
                         invisible="elevation_is_current">
                        The stored drawing does not match this layout.
                        Open the configurator and save to refresh it; until
                        then the reports print the same warning.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" name="%(action_aw_design_row)d"
                                groups="base.group_no_one"
                                class="oe_stat_button" icon="fa-bars"
                                context="{'default_design_id': id, 'search_default_design_id': id}">
                            <field name="row_count" widget="statinfo" string="Rows"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="qty"/>
                            <field name="family_id" string="Family"/>
                            <!-- NOT an entry field: it follows from the
                                 family and the panels drawn, via
                                 _resolve_system(). Shown as Type. -->
                            <field name="window_series_id" string="Type"
                                   readonly="1"/>
                            <field name="template_id" string="Series"/>
                        </group>
                        <group>
                            <field name="length_uom" invisible="1"/>

                            <label for="width_ft" string="Width" invisible="length_uom != 'ftin'"/>
                            <div class="o_row" invisible="length_uom != 'ftin'">
                                <field name="width_ft"/>
                                <span>ft</span>
                                <field name="width_in"/>
                                <span>in</span>
                            </div>
                            <field name="width_inch_total" string="Width (in)" invisible="length_uom == 'ftin'"/>
                            <field name="width_mm"/>

                            <label for="height_ft" string="Height" invisible="length_uom != 'ftin'"/>
                            <div class="o_row" invisible="length_uom != 'ftin'">
                                <field name="height_ft"/>
                                <span>ft</span>
                                <field name="height_in"/>
                                <span>in</span>
                            </div>
                            <field name="height_inch_total" string="Height (in)" invisible="length_uom == 'ftin'"/>
                            <field name="height_mm"/>

                            <field name="area_sqm" readonly="1"/>
                            <field name="area_sqft" readonly="1"/>
                            <label for="check_error_count" string="Checks"/>
                            <div class="o_row">
                                <field name="check_error_count"/>
                                <span>errors</span>
                                <field name="check_warning_count"/>
                                <span>warnings</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Glazing / Finish">
                            <field name="glass_spec_id"/>
                            <field name="finish_id"/>
                        </group>
                        <group string="Quote">
                            <field name="sale_order_line_id"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rows" name="rows" groups="base.group_no_one">
                            <field name="row_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <!-- Same as the leaves list: length_uom
                                         stays for the per-row readonly= below,
                                         column_invisible goes through parent.*
                                         (here the aw.design). -->
                                    <field name="length_uom" column_invisible="1"/>
                                    <field name="height_ft" column_invisible="parent.length_uom != 'ftin'"/>
                                    <field name="height_in" column_invisible="parent.length_uom != 'ftin'"/>
                                    <field name="height_inch_total" string="Height (in)" column_invisible="parent.length_uom != 'in'"/>
                                    <field name="height_mm" readonly="length_uom != 'mm'"/>
                                    <field name="is_auto"/>
                                    <field name="leaf_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cut list" name="cut_list">
                            <field name="cut_list_stale" invisible="1"/>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not cut_list_stale and not orphan_count">
                                <div invisible="not cut_list_stale">
                                    The window's size changed after this cut
                                    list was made, so it still shows the old
                                    lengths. Press Recompute.
                                </div>
                                <div invisible="not orphan_count">
                                    <field name="orphan_count" class="oe_inline"
                                           readonly="1"/>
                                    manual line(s) no longer match a piece
                                    in the current layout. They are kept as
                                    typed and marked Orphan: fix or delete
                                    them.
                                </div>
                            </div>
                            <button name="action_generate_cut_list" type="object"
                                    string="Generate cut list" class="btn-primary"
                                    invisible="cut_line_ids"/>
                            <button name="action_recompute_cut_list" type="object"
                                    string="Recompute" class="btn-secondary"
                                    invisible="not cut_line_ids"
                                    title="Refreshes every line from the spec. A line edited by hand keeps what was typed, and a line added by hand is never touched."/>
                            <field name="cut_line_ids" readonly="1">
                                <list default_group_by="group_label"
                                      decoration-warning="is_manual"
                                      decoration-danger="is_orphan">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="is_free_form" column_invisible="1"/>
                                    <field name="cut_on_site" column_invisible="1"/>
                                    <field name="group_label" string="Group" readonly="1"/>
                                    <field name="label" readonly="not is_free_form"/>
                                    <field name="product_id" string="Section"/>
                                    <field name="qty"/>
                                    <field name="cut_angle" string="Cut ends"/>
                                    <field name="length_text" string="Length (in)"/>
                                    <field name="computed_length_text" string="Computed (in)"/>
                                    <field name="length_mm" string="Length (mm)"/>
                                    <field name="is_manual" string="Manual" readonly="1"/>
                                    <field name="is_orphan" string="Orphan" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Changes for this window" name="changes">
                            <field name="override_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="kind"/>
                                    <field name="position_id"
                                           readonly="kind != 'profile'"/>
                                    <field name="product_tmpl_id"
                                           readonly="kind != 'profile'"/>
                                    <field name="thickness_id"
                                           readonly="kind != 'profile'"/>
                                    <field name="hardware_line_id"
                                           readonly="kind != 'hardware'"/>
                                    <field name="product_id"
                                           readonly="kind != 'hardware'"/>
                                    <field name="qty" readonly="kind != 'hardware'"/>
                                    <field name="note"/>
                                    <field name="is_added" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="active" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aw_design_list" model="ir.ui.view">
        <field name="name">aw.design.list</field>
        <field name="model">aw.design</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
                <field name="qty"/>
                <field name="family_id" string="Family"/>
                <field name="window_series_id" string="Type"
                       optional="hide"/>
                <!-- One preformatted column rather than a unit-switching pair:
                     this list has no parent record for column_invisible to
                     read, and it's read-only anyway. size_display is a
                     non-stored compute, so no DB column. -->
                <field name="size_display"/>
                <field name="area_sqft"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="action_aw_design" model="ir.actions.act_window">
        <field name="name">Designs</field>
        <field name="res_model">aw.design</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Design</p>
            <p>A Design is one configured window/door — width,
               height, a row/leaf grid, and (once the explosion engine
               lands) a generated profile cut list.</p>
        </field>
    </record>

</odoo>
