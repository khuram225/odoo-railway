<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_cut_plan_form" model="ir.ui.view">
        <field name="name">aw.cut.plan.form</field>
        <field name="model">aw.cut.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object"
                            string="Re-plan from stock" class="btn-primary"
                            invisible="state != 'draft'"
                            title="Plans again, using the offcuts earlier Final batches left before buying a bar."/>
                    <button name="action_create_purchase_order" type="object"
                            string="Create purchase order"
                            invisible="state != 'draft' or purchase_order_id"
                            groups="aw_fenestration_core.group_fenestration_manager"/>
                    <button name="action_open_purchase_order" type="object"
                            string="Purchase order"
                            invisible="not purchase_order_id"/>
                    <button name="action_mark_bought" type="object"
                            string="Mark bars bought"
                            invisible="state != 'draft'"
                            confirm="Mark the bars bought? The batch is then locked."/>
                    <button name="action_print_cutting_sheet" type="object"
                            string="Cutting Sheet"/>
                    <button name="action_print_labels" type="object"
                            string="Labels (A4)"/>
                    <button name="action_print_thermal_labels" type="object"
                            string="Labels (50x30)"/>
                    <button name="action_reopen_batch" type="object"
                            string="Reopen batch"
                            invisible="state != 'confirmed'"
                            groups="aw_fenestration_core.group_fenestration_manager"/>
                    <button name="action_cancel_batch" type="object"
                            string="Cancel batch"
                            invisible="state != 'draft'"
                            confirm="Cancel this batch? Its windows are free for another batch."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status"
                         invisible="is_current or state != 'draft'">
                        A window changed after this plan was made.
                        <strong>Out of date — regenerate.</strong>
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="is_current or state != 'confirmed'">
                        A window changed after the bars were bought. This
                        batch is locked: the change is not in these bars.
                    </div>
                    <div class="alert alert-success" role="status"
                         invisible="state != 'confirmed'">
                        Bars bought <field name="bought_on" readonly="1"/>
                        by <field name="bought_by" readonly="1"/>.
                        This batch is locked.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="design_ids" widget="many2many_tags"
                               readonly="state != 'draft'"
                               options="{'no_create': True}"
                               domain="[('sale_order_id', '=', sale_order_id)]"/>
                        <field name="stock_bars_used" readonly="1"/>
                        <field name="plan_without_stock"
                               readonly="state != 'draft'"
                               groups="aw_fenestration_core.group_fenestration_manager"/>
                        <field name="no_stock_reason"
                               invisible="not plan_without_stock"
                               readonly="state != 'draft'"
                               placeholder="Why is this batch planned without the stock left by earlier batches?"
                               groups="aw_fenestration_core.group_fenestration_manager"/>
                    </group>
                    <group>
                        <group string="Built with">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="profile_vendor_id" readonly="1"/>
                            <field name="stock_lengths_ft" readonly="1"/>
                            <field name="solve_budget_s" readonly="1"/>
                            <field name="kerf_mm" readonly="1"/>
                            <field name="offcut_min_mm" readonly="1"/>
                            <field name="start_trim_mm" readonly="1"/>
                            <field name="safety_margin_mm" readonly="1"/>
                            <field name="max_piece_mm" readonly="1"/>
                            <field name="is_current" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Totals">
                            <field name="bar_count"/>
                            <field name="feet_bought"/>
                            <field name="feet_used"/>
                            <field name="yield_pct"/>
                            <field name="cost_total" widget="monetary"/>
                            <field name="purchase_order_id" invisible="1"/>
                            <field name="po_total" widget="monetary"
                                   invisible="not purchase_order_id"/>
                            <field name="po_vs_quote" widget="monetary"
                                   invisible="not purchase_order_id"/>
                            <!-- Side by side on purpose: the gap between
                                 what the price assumed and what the plan
                                 actually wastes is the number worth
                                 arguing about. -->
                            <field name="optimality"/>
                            <field name="optimality_note"/>
                            <field name="measured_wastage_pct"
                                   string="Measured wastage %"/>
                            <field name="assumed_wastage_pct"
                                   string="Assumed by price structure %"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert"
                         invisible="not oversize_note">
                        <field name="oversize_note" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not blocked_note">
                        <strong>Not planned:</strong>
                        <field name="blocked_note" nolabel="1" readonly="1"/>
                    </div>
                    <field name="group_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="piece_count" string="Pieces"/>
                            <field name="bars_summary"/>
                            <field name="feet_bought"/>
                            <field name="feet_used"/>
                            <field name="yield_pct"/>
                            <field name="rate_per_ft"/>
                            <field name="rate_date"/>
                            <field name="cost" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="proven_optimal" string="Proven"/>
                            <field name="is_overridden" string="Override"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="product_id" readonly="1"/>
                                        <field name="rate_per_ft" readonly="1"/>
                                        <field name="rate_date" readonly="1"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="bars_summary" readonly="1"/>
                                        <field name="yield_pct" readonly="1"/>
                                        <field name="cost" readonly="1"
                                               widget="monetary"/>
                                        <field name="is_overridden" readonly="1"/>
                                        <button name="action_clear_override"
                                                type="object"
                                                string="Use the cheapest again"
                                                invisible="not is_overridden"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Options" name="options">
                                        <field name="scenario_ids" readonly="1">
                                            <list decoration-success="is_chosen"
                                                  decoration-muted="not feasible">
                                                <field name="name"/>
                                                <field name="bars_summary"/>
                                                <field name="feet_bought"/>
                                                <field name="feet_used"/>
                                                <field name="waste_feet"/>
                                                <field name="yield_pct"/>
                                                <field name="cost" widget="monetary"/>
                                                <field name="currency_id" column_invisible="1"/>
                                                <field name="proven_optimal" string="Proven"/>
                                                <field name="is_chosen" string="In use"/>
                                                <field name="feasible" column_invisible="1"/>
                                                <field name="blocked_note"/>
                                                <button name="action_use" type="object"
                                                        icon="fa-check"
                                                        title="Use this option"
                                                        invisible="is_chosen or not feasible"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Bars" name="bars">
                                        <field name="bar_ids" readonly="1">
                                            <list decoration-info="from_bar_id">
                                                <field name="from_bar_id" column_invisible="1"/>
                                                <field name="source_label" string="From stock"/>
                                                <field name="sequence"/>
                                                <field name="stock_label" string="Stock"/>
                                                <field name="remainder_label" string="Remainder"/>
                                                <field name="is_returnable" string="Return to stock"/>
                                            </list>
                                            <form>
                                                <group>
                                                    <field name="stock_label" readonly="1"/>
                                                    <field name="remainder_label" readonly="1"/>
                                                    <field name="is_returnable" readonly="1"/>
                                                </group>
                                                <field name="cut_ids" readonly="1">
                                                    <list>
                                                        <field name="sequence"/>
                                                        <field name="piece_ref" string="Ref"/>
                                                        <field name="label"/>
                                                        <field name="length_label" string="Length"/>
                                                        <field name="length_mm" string="mm"/>
                                                        <field name="cut_angle" string="Angle"/>
                                                    </list>
                                                </field>
                                            </form>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_cut_plan_list" model="ir.ui.view">
        <field name="name">aw.cut.plan.list</field>
        <field name="model">aw.cut.plan</field>
        <field name="arch" type="xml">
            <list decoration-warning="not is_current"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="window_count"/>
                <field name="date"/>
                <field name="bar_count"/>
                <field name="yield_pct"/>
                <field name="cost_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_current" string="Up to date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_aw_cut_plan" model="ir.actions.act_window">
        <field name="name">Cutting Plans</field>
        <field name="res_model">aw.cut.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cutting plans yet</p>
            <p>Open a quote's Fenestration tab and use Cutting Plan.</p>
        </field>
    </record>

</odoo>
