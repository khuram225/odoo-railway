<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_layout_family_list" model="ir.ui.view">
        <field name="name">aw.layout.family.list</field>
        <field name="model">aw.layout.family</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="preset_count" string="Presets"/>
            </list>
        </field>
    </record>

    <record id="view_aw_layout_family_form" model="ir.ui.view">
        <field name="name">aw.layout.family.form</field>
        <field name="model">aw.layout.family</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_128" widget="image"
                           class="oe_avatar" options="{'size': [96, 96]}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        <b>Layout</b> families replace the whole design layout
                        when clicked. <b>Mesh</b> and <b>Infill</b> families
                        apply to the selected panel instead (Phase 3).
                    </div>
                    <field name="preset_ids" readonly="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="code"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_layout_family_kanban" model="ir.ui.view">
        <field name="name">aw.layout.family.kanban</field>
        <field name="model">aw.layout.family</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image_128"/>
                <field name="preview_layout_json"/>
                <templates>
                    <t t-name="card" class="p-2">
                        <div class="o_aw_family_card text-center">
                            <!-- The family's own picture when it has one,
                                 otherwise its first preset's drawing.

                                 Both branches are wrapped in <t>, not
                                 carried on the elements themselves: a
                                 kanban <field> becomes a Field COMPONENT
                                 and every attribute is passed through as
                                 attrs, so a t-else on it compiles to
                                 `attrs: {'t-else':, ...}` and the
                                 template fails to compile at all. -->
                            <t t-if="record.image_128.raw_value">
                                <img t-att-src="kanban_image('aw.layout.family', 'image_128', record.id.raw_value)"
                                     class="o_aw_family_img" alt="Family"/>
                            </t>
                            <t t-else="">
                                <field name="preview_layout_json"
                                       widget="preset_thumbnail"/>
                            </t>
                            <div class="fw-bold mt-2">
                                <field name="name"/>
                            </div>
                            <div class="text-muted small">
                                <field name="code"/> &#183;
                                <field name="kind"/>
                            </div>
                            <div class="text-muted small">
                                <field name="preset_count"/> preset(s)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_aw_layout_family" model="ir.actions.act_window">
        <field name="name">Layout Families</field>
        <field name="res_model">aw.layout.family</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
