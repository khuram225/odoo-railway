<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Read only for everyone: a Rates manager gets Delete from the
         extension below, and the access rules refuse anyone else. -->
    <record id="view_aw_profile_lpp_list" model="ir.ui.view">
        <field name="name">aw.profile.lpp.list</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" import="0"
                  decoration-danger="vs_list_pct &gt; 15 or vs_list_pct &lt; -15">
                <field name="product_tmpl_id" class="fw-bold"/>
                <field name="thickness_id"/>
                <field name="finish_label"/>
                <field name="price_ft"/>
                <field name="vs_list_pct"/>
                <field name="bar_length_ft"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="vendor_id" optional="show"/>
                <field name="list_rate" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_aw_profile_lpp_list_manager" model="ir.ui.view">
        <field name="name">aw.profile.lpp.list.manager</field>
        <field name="model">aw.profile.lpp</field>
        <field name="inherit_id" ref="view_aw_profile_lpp_list"/>
        <field name="group_ids" eval="[(4, ref('aw_fenestration_core.group_rates_manager'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="delete">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_aw_profile_lpp_form" model="ir.ui.view">
        <field name="name">aw.profile.lpp.form</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="thickness_id"/>
                            <field name="finish_label"/>
                            <field name="bar_length_ft"/>
                        </group>
                        <group>
                            <field name="price_ft"/>
                            <field name="list_rate"/>
                            <field name="vs_list_pct"/>
                            <field name="date"/>
                            <field name="order_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_profile_lpp_search" model="ir.ui.view">
        <field name="name">aw.profile.lpp.search</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id" string="Profile"/>
                <field name="thickness_id"/>
                <field name="finish_id" string="Finish"/>
                <field name="vendor_id"/>
                <field name="order_id"/>
                <group>
                    <filter name="group_profile" string="Profile"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_thickness" string="Thickness"
                            context="{'group_by': 'thickness_id'}"/>
                    <filter name="group_finish" string="Finish"
                            context="{'group_by': 'finish_id'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aw_profile_lpp" model="ir.actions.act_window">
        <field name="name">Last Prices</field>
        <field name="res_model">aw.profile.lpp</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_profile': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No last prices yet
            </p>
            <p>
                A price is recorded here when a purchase order with profile
                bars is confirmed.
            </p>
        </field>
    </record>

    <menuitem id="menu_aw_profile_lpp"
              name="Last Prices"
              parent="aw_fenestration_core.menu_aw_vendor_rates"
              action="action_aw_profile_lpp"
              sequence="70"/>

    <!-- The vendor form: a Last prices button with a count. -->
    <record id="view_partner_form_aw_lpp" model="ir.ui.view">
        <field name="name">res.partner.form.aw.lpp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_lpp" type="object"
                        class="oe_stat_button" icon="fa-tags"
                        invisible="not aw_lpp_count">
                    <field name="aw_lpp_count" widget="statinfo"
                           string="Last prices"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
