<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One list for everyone, read only. The standard Delete is off; a
         Rates manager is shown the Delete button below (groups on the
         button, which Odoo applies when it builds the view), and the access
         rules refuse anyone else. A second, group-restricted list view was
         tried and did not work: the default view is picked by priority,
         not by group. -->
    <record id="view_aw_profile_lpp_list" model="ir.ui.view">
        <field name="name">aw.profile.lpp.list</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" import="0"
                  default_order="vendor_id, date desc, id desc"
                  decoration-danger="vs_list_pct &gt; 15 or vs_list_pct &lt; -15">
                <header>
                    <button name="action_delete_selected" type="object"
                            string="Delete"
                            confirm="Delete the selected last prices?"
                            groups="aw_fenestration_core.group_rates_manager"/>
                </header>
                <field name="product_tmpl_id" class="fw-bold"/>
                <field name="thickness_id"/>
                <field name="finish_label"/>
                <field name="price_ft"/>
                <field name="vs_list_pct"/>
                <field name="bar_length_ft"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="vendor_id" optional="show"/>
                <field name="list_rate"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_aw_profile_lpp_form" model="ir.ui.view">
        <field name="name">aw.profile.lpp.form</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="thickness_id"/>
                            <field name="finish_label"/>
                            <field name="bar_length_ft"/>
                        </group>
                        <group>
                            <field name="price_ft"/>
                            <field name="list_rate"/>
                            <field name="vs_list_pct"/>
                            <field name="date"/>
                            <field name="order_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_profile_lpp_search" model="ir.ui.view">
        <field name="name">aw.profile.lpp.search</field>
        <field name="model">aw.profile.lpp</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id" string="Profile"/>
                <field name="thickness_id"/>
                <field name="finish_id" string="Finish"/>
                <field name="vendor_id"/>
                <field name="order_id"/>
                <group>
                    <filter name="group_profile" string="Profile"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_thickness" string="Thickness"
                            context="{'group_by': 'thickness_id'}"/>
                    <filter name="group_finish" string="Finish"
                            context="{'group_by': 'finish_id'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aw_profile_lpp" model="ir.actions.act_window">
        <field name="name">Last Prices</field>
        <field name="res_model">aw.profile.lpp</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_profile': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No last prices yet
            </p>
            <p>
                A price is recorded here when a purchase order with profile
                bars is confirmed.
            </p>
        </field>
    </record>

    <menuitem id="menu_aw_profile_lpp"
              name="Last Prices"
              parent="aw_fenestration_core.menu_aw_vendor_rates"
              action="action_aw_profile_lpp"
              sequence="70"/>

    <!-- The product page, Purchase tab: the same list, read only. The
         anchor group[@name='purchase'] sits in the Purchase page of
         product.product_template_form_view (checked on the composed form
         on production). An embedded list cannot be grouped, so it is
         sorted by vendor; the Last Prices menu groups. -->
    <record id="view_product_template_form_aw_lpp" model="ir.ui.view">
        <field name="name">product.template.form.aw.lpp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']//group[@name='purchase']"
                   position="before">
                <group string="Last purchase prices"
                       invisible="not aw_lpp_ids">
                    <field name="aw_lpp_ids" nolabel="1" colspan="2" readonly="1"
                           context="{'list_view_ref': 'aw_fenestration_design.view_aw_profile_lpp_list'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- The variant's current cost, under the figures core shows. -->
    <record id="view_product_product_form_aw_current_cost" model="ir.ui.view">
        <field name="name">product.product.form.aw.current.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="aw_fenestration_core.view_product_product_form_fenestration"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='aw_cost_from_rate']" position="after">
                <field name="aw_current_cost" string="Current cost / ft"/>
                <field name="aw_current_cost_source" string="Source"/>
            </xpath>
        </field>
    </record>

    <!-- A product with several variants has no single cost: the list shows
         the range instead of 0. -->
    <record id="view_product_template_list_aw_cost_range" model="ir.ui.view">
        <field name="name">product.template.list.aw.cost.range</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="attributes">
                <attribute name="invisible">product_variant_count &gt; 1</attribute>
            </field>
            <field name="standard_price" position="after">
                <field name="aw_cost_range" string="Cost" optional="show"
                       invisible="product_variant_count &lt;= 1"/>
            </field>
        </field>
    </record>

    <!-- The vendor form: a Last prices button with a count. -->
    <record id="view_partner_form_aw_lpp" model="ir.ui.view">
        <field name="name">res.partner.form.aw.lpp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_lpp" type="object"
                        class="oe_stat_button" icon="fa-tags"
                        invisible="not aw_lpp_count">
                    <field name="aw_lpp_count" widget="statinfo"
                           string="Last prices"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
