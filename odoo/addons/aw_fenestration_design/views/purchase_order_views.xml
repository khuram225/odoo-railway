<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bar length and number of bars on a purchase order line. The
         quantity stays in ft; it is read-only while bars are set. -->
    <record id="view_purchase_order_form_aw_bars" model="ir.ui.view">
        <field name="name">purchase.order.form.aw.bars</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- The stock forecast icon means nothing for a bar of a
                 profile. -->
            <xpath expr="//field[@name='order_line']/list/button[@name='action_product_forecast_report'][1]"
                   position="attributes">
                <attribute name="invisible">not id or not forecasted_issue or not is_storable or aw_is_profile</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/button[@name='action_product_forecast_report'][2]"
                   position="attributes">
                <attribute name="invisible">not id or forecasted_issue or not is_storable or aw_is_profile</attribute>
            </xpath>
            <!-- Beside 'Add a product': the bars grid for a profile. -->
            <xpath expr="//field[@name='order_line']/list/control/button[@name='action_add_from_catalog']"
                   position="after">
                <button name="action_add_profile_bars" string="Add profile (bars grid)"
                        type="object" class="px-4 btn-link"
                        context="{'order_id': parent.id}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="before">
                <field name="aw_is_profile" column_invisible="1"/>
                <field name="aw_bar_count" optional="show"/>
                <field name="aw_bar_length_ft" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="attributes">
                <attribute name="readonly">is_downpayment or aw_bar_count</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="after">
                <field name="aw_price_note" readonly="1" optional="show"
                       decoration-danger="aw_price_note"/>
            </xpath>
        </field>
    </record>

</odoo>
