<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reports to fix migrated glass one panel at a time. -->
    <record id="view_aw_glass_part_report_list" model="ir.ui.view">
        <field name="name">aw.glass.part.report.list</field>
        <field name="model">aw.glass.part</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="order_id"/>
                <field name="part_design_id"/>
                <field name="panel_no"/>
                <field name="kind"/>
                <field name="label"/>
                <field name="rate_manual"/>
                <field name="manual_rate"/>
                <field name="default_gap"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="action_aw_glass_part_migrated" model="ir.actions.act_window">
        <field name="name">Panels with migrated glass</field>
        <field name="res_model">aw.glass.part</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_aw_glass_part_report_list'), 'list')]"/>
        <field name="domain">[('migrated', '=', True), ('leaf_id', '!=', False)]</field>
    </record>

    <record id="action_aw_glass_part_remark" model="ir.actions.act_window">
        <field name="name">Panels with a migration remark</field>
        <field name="res_model">aw.glass.part</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(ref('view_aw_glass_part_report_list'), 'list')]"/>
        <field name="domain">[('remark', '!=', False), ('leaf_id', '!=', False)]</field>
    </record>

</odoo>
