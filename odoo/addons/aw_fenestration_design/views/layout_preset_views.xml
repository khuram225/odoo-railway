<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aw_layout_preset_list" model="ir.ui.view">
        <field name="name">aw.layout.preset.list</field>
        <field name="model">aw.layout.preset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
            </list>
        </field>
    </record>

    <record id="view_aw_layout_preset_form" model="ir.ui.view">
        <field name="name">aw.layout.preset.form</field>
        <field name="model">aw.layout.preset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" placeholder="e.g. OPN-CFC"/>
                            <field name="kind"/>
                            <field name="category" groups="base.group_no_one"
                                   string="Category (migrated from)"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                    </group>
                    <div class="text-muted mb-2">
                        Leave <b>Window Series</b> empty to offer this preset
                        on any Series whose leaf types it fits. Setting it
                        restricts the preset to those Series; the leaf-type
                        check still applies on top.
                    </div>
                    <separator string="Layout"/>
                    <div class="text-muted mb-2">
                        Rows top to bottom, leaves left to right.
                        <code>h</code> and <code>w</code> are relative
                        weights, not millimetres: a row with
                        <code>h: 2</code> beside one with <code>h: 1</code>
                        takes two thirds of whatever height the design has.
                        <code>type</code> is a Leaf Type code (FIXED,
                        SLIDER, CASEMENT, AWNING, HOPPER, MESH, TILTTURN).
                    </div>
                    <field name="layout_json" widget="ace"
                           options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_layout_preset_kanban" model="ir.ui.view">
        <field name="name">aw.layout.preset.kanban</field>
        <field name="model">aw.layout.preset</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="layout_json" widget="preset_thumbnail"/>
                <templates>
                    <t t-name="card" class="p-2">
                        <div class="o_aw_preset_card text-center">
                            <field name="layout_json" widget="preset_thumbnail"/>
                            <div class="fw-bold mt-2">
                                <field name="name"/>
                            </div>
                            <div class="text-muted small">
                                <field name="code"/>
                            </div>
                            <div class="text-muted small">
                                <field name="kind"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_aw_layout_preset_search" model="ir.ui.view">
        <field name="name">aw.layout.preset.search</field>
        <field name="model">aw.layout.preset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_shape" string="Shapes"
                        domain="[('kind', '=', 'shape')]"/>
                <filter name="filter_design" string="Designs"
                        domain="[('kind', '=', 'design')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_kind" string="Kind"
                            context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aw_layout_preset" model="ir.actions.act_window">
        <field name="name">Layout Library</field>
        <field name="res_model">aw.layout.preset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_aw_layout_preset_search"/>
        <field name="context">{'search_default_group_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a layout</p>
            <p>A <b>Shape</b> is geometry only — how the opening is divided,
               every panel Fixed. A <b>Design</b> is a named layout the shop
               builds, with its panel types set. Neither carries absolute
               sizes: the design's own width and height divide up according
               to the relative weights stored here.</p>
        </field>
    </record>

</odoo>
