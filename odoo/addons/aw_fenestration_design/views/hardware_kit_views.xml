<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hardware Sets saved from the configurator (aw.hardware.kit).
         Not the legacy aw.hardware.set of aw_fenestration_core. -->

    <record id="view_aw_hardware_kit_list" model="ir.ui.view">
        <field name="name">aw.hardware.kit.list</field>
        <field name="model">aw.hardware.kit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="leaf_type_id"/>
                <field name="line_count" string="Rows"/>
            </list>
        </field>
    </record>

    <record id="view_aw_hardware_kit_form" model="ir.ui.view">
        <field name="name">aw.hardware.kit.form</field>
        <field name="model">aw.hardware.kit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="leaf_type_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="rate_manual"/>
                            <field name="manual_rate" readonly="not rate_manual"/>
                        </list>
                    </field>
                    <group>
                        <field name="notes"/>
                    </group>
                    <div class="text-muted">
                        A panel gets a copy of these rows when the set is
                        picked in the configurator. Changing or deleting a
                        set later does not change a window that used it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aw_hardware_kit_search" model="ir.ui.view">
        <field name="name">aw.hardware.kit.search</field>
        <field name="model">aw.hardware.kit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="leaf_type_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_aw_hardware_kit" model="ir.actions.act_window">
        <field name="name">Hardware Sets</field>
        <field name="res_model">aw.hardware.kit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Hardware Sets yet</p>
            <p>Enter the hardware of a panel or the frame in the
               configurator and choose Save as set.</p>
        </field>
    </record>

</odoo>
