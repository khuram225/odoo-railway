#!/bin/sh
# Blocks commits that introduce "--" inside an XML comment (illegal XML,
# breaks well-formedness -- see scripts/check_xml_comments.py), a
# forward-reference in a module's data-loading order (ref=/%()d/parent=
# resolved before the target is defined -- see scripts/check_load_order.py),
# an OWL template variable named after a word OWL rewrites into an
# operator (t-as="lt" -> "<" -- see scripts/check_owl_names.py), or a
# seeded preset layout the module upgrade would reject (see
# scripts/check_preset_layouts.py), or an act_window action built
# without "views" (see scripts/check_act_window_views.py), or a
# configurator payload key the server never sends (see
# scripts/check_configurator_payload.py), or a view arch that
# Odoo's own RelaxNG schema rejects (see
# scripts/check_view_schemas.py).
#
# The cutting-plan check runs a real solve (the 169 M1 DG-26 job) and
# takes about 14s. For a quick local commit:
#     AW_SKIP_SLOW_CHECKS=1 git commit ...
# It prints a loud line when it skips, and the FULL suite must still run
# before a deploy -- a skipped check nobody notices is not a check.
#
# Not active by default: git only runs hooks from .git/hooks, which isn't
# tracked. One-time setup per clone:
#   git config core.hooksPath .githooks

staged_xml=$(git diff --cached --name-only --diff-filter=ACM -- '*.xml')
staged_js=$(git diff --cached --name-only --diff-filter=ACM -- '*.js')
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -z "$staged_xml" ] && [ -z "$staged_js" ] && [ -z "$staged_py" ]; then
    exit 0
fi

python scripts/check_xml_comments.py $staged_xml || exit 1
python scripts/check_owl_names.py || exit 1
node scripts/check_owl_getters.mjs || exit 1
python scripts/check_preset_layouts.py || exit 1
python scripts/check_act_window_views.py || exit 1
python scripts/check_configurator_payload.py || exit 1
python scripts/check_configurator_header.py || exit 1
python scripts/check_formulas.py || exit 1
python scripts/check_view_schemas.py || exit 1
python scripts/check_kanban_fields.py || exit 1
python scripts/check_rate_chain.py || exit 1
python scripts/check_cut_plan.py || exit 1
python scripts/check_load_order.py
