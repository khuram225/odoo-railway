+from odoo import fields, models
+
+
+class SaleOrder(models.Model):
+    _inherit = "sale.order"
+
+    # Not stored: no new column on a shared core table (see addons_print/CLAUDE.md rule 8).
+    print_estimate_count = fields.Integer("Print estimates", compute="_compute_print_estimate_count")
+
+    def _compute_print_estimate_count(self):
+        Estimate = self.env["print.estimate"]
+        for order in self:
+            order.print_estimate_count = Estimate.search_count([("sale_order_id", "=", order.id)]) if order.id else 0
+
+    def action_open_print_estimates(self):
+        self.ensure_one()
+        estimates = self.env["print.estimate"].search([("sale_order_id", "=", self.id)])
+        action = {"type": "ir.actions.act_window", "res_model": "print.estimate", "name": "Print estimates",
+                  "view_mode": "list,form", "views": [(False, "list"), (False, "form")],
+                  "domain": [("id", "in", estimates.ids)]}
+        if len(estimates) == 1:
+            action.update(view_mode="form", views=[(False, "form")], res_id=estimates.id)
+        return action
