diff --git a/odoo/addons/addons_print/pp_print_core/tests/test_job.py b/odoo/addons/addons_print/pp_print_core/tests/test_job.py
new file mode 100644
index 0000000..42ab60d
--- /dev/null
+++ b/odoo/addons/addons_print/pp_print_core/tests/test_job.py
@@ -0,0 +1,94 @@
+from datetime import date
+
+from odoo.exceptions import UserError
+from odoo.tests.common import TransactionCase, tagged
+
+
+@tagged("post_install", "-at_install", "pp_print_core")
+class TestPrintJob(TransactionCase):
+
+    def _confirmed_sample(self):
+        est = self.env["print.estimate"].browse(self.env["print.estimate"].action_load_sample()["res_id"])
+        est.action_set_quoted()
+        est.action_set_won()
+        return est
+
+    def test_job_from_confirmed_order(self):
+        est = self.env["print.estimate"].browse(self.env["print.estimate"].action_load_sample()["res_id"])
+        with self.assertRaises(UserError):
+            est.action_create_job()                               # not confirmed yet
+        est.action_set_quoted()
+        est.action_set_won()
+        est.action_create_job()
+        job = est.job_ids
+        self.assertEqual(len(job), 1)
+        self.assertTrue(job.name.startswith("J01-"))
+        self.assertEqual(job.qty, 350)
+        self.assertEqual(len(job.part_ids), 2)
+        # route: plates + printing for each part, then the two finishing lines
+        self.assertEqual([s.step_type for s in job.step_ids],
+                         ["plates", "printing", "plates", "printing", "operation", "operation"])
+        text = job.part_ids.filtered(lambda p: p.name.startswith("Text1"))
+        self.assertAlmostEqual(text.paper_sheets_planned, 1512.5)
+        self.assertAlmostEqual(job.planned_cost, est.cost_subtotal)
+        self.assertAlmostEqual(sum(job.step_ids.mapped("cost_planned")) + sum(job.part_ids.mapped("paper_cost_planned")),
+                               est.cost_subtotal, places=2)
+        est.action_create_job()                                   # never a second live job
+        self.assertEqual(len(est.job_ids), 1)
+
+    def test_work_and_actual_cost(self):
+        est = self._confirmed_sample()
+        est.action_create_job()
+        job = est.job_ids
+        step = job.step_ids[1]
+        with self.assertRaises(UserError):
+            step.action_start()                                   # not released
+        with self.assertRaises(UserError):
+            job.action_done()                                     # steps still open
+        job.action_release()
+        self.assertEqual(job.state, "released")
+        role = self.env["print.labour.role"].create({"name": "Machine man", "code": "T-MM"})
+        self.env["print.labour.role.rate"].create({"role_id": role.id, "date_from": date(2026, 1, 1), "rate_hr": 500})
+        worker = self.env["print.worker"].create({"name": "Ali", "role_id": role.id})
+        step.action_start()
+        self.assertEqual((step.state, job.state), ("running", "in_progress"))
+        self.env["print.job.time"].create({"step_id": step.id, "worker_id": worker.id, "hours": 3, "date": date(2026, 9, 30)})
+        self.env["print.job.time"].create({"step_id": step.id, "worker_id": worker.id, "hours": 1.5, "date": date(2026, 9, 30)})
+        self.assertEqual(step.labour_hours, 4.5)
+        self.assertAlmostEqual(step.labour_cost, 2250)
+        step.outside_cost = 100
+        self.assertAlmostEqual(step.cost_actual, 2350)
+        step.action_finish()
+        self.assertEqual((step.state, step.qty_good), ("done", step.qty_planned))
+        part = job.part_ids[0]
+        part.paper_sheets_issued = part.paper_sheets_planned + 20
+        self.assertAlmostEqual(part.paper_variance, 20)
+        self.assertAlmostEqual(part.paper_cost_actual, (part.paper_sheets_planned + 20) * part.cost_per_sheet, places=2)
+        self.assertAlmostEqual(job.actual_cost, part.paper_cost_actual + step.cost_actual, places=2)
+        # a rate changing later does not change an old entry
+        self.env["print.labour.role.rate"].create({"role_id": role.id, "date_from": date(2026, 10, 15), "rate_hr": 900})
+        self.assertAlmostEqual(step.labour_cost, 2250)
+        (job.step_ids - step).action_skip()
+        job.action_done()
+        self.assertEqual((job.state, job.qty_delivered), ("done", 350))
+        with self.assertRaises(UserError):
+            job.action_cancel()
+
+    def test_cancelled_job_can_be_remade_and_report_renders(self):
+        est = self._confirmed_sample()
+        est.action_create_job()
+        est.job_ids.action_cancel()
+        est.action_create_job()
+        self.assertEqual(len(est.job_ids), 2)
+        live = est.job_ids.filtered(lambda j: j.state != "cancelled")
+        self.assertEqual(len(live), 1)
+        html = self.env["ir.actions.report"]._render_qweb_html("pp_print_core.report_print_job", live.ids)[0]
+        self.assertIn(live.name.encode(), html)
+        with self.assertRaises(UserError):
+            live.action_done() if False else live.step_ids[0].action_start()
+
+    def test_job_needs_calculated_parts(self):
+        est = self._confirmed_sample()
+        est.page_ids[0].material_id = False
+        with self.assertRaises(UserError):
+            est.action_create_job()
