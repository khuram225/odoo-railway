@@ -0,0 +1,58 @@
+from odoo import fields, models
+
+SAMPLE_JOB = "SAMPLE Magazine 14K Model Town"
+
+
+class PrintEstimate(models.Model):
+    _inherit = "print.estimate"
+
+    def _sample_paper(self, name, mtype, gsm, price, date):
+        Product = self.env["product.template"]
+        paper = Product.search([("name", "=", name)], limit=1)
+        if not paper:
+            paper = Product.create({"name": name, "print_material_type": mtype, "print_gsm": gsm,
+                                    "print_width_in": 25, "print_height_in": 36})
+            self.env["print.material.price"].create({"product_tmpl_id": paper.id, "date_from": date, "basis": "kg",
+                                                     "price": price, "note": "Sample price"})
+        return paper
+
+    def action_load_sample(self):
+        """Create one worked example from the client's costing sheet (Magazine 14K Model Town, 350 copies) so the
+        screens can be checked against known figures: subtotal 140,262.85, with 7 % overheads 150,081.25,
+        428.80 per copy. Everything it creates is named SAMPLE and can be deleted. Running it again opens the same job."""
+        est = self.search([("job_name", "=", SAMPLE_JOB)], limit=1)
+        if not est:
+            today = fields.Date.context_today(self)
+            start = today.replace(month=1, day=1)
+            paper = self._sample_paper("SAMPLE Art paper 115 gsm 25x36", "paper", 115, 590, start)
+            card = self._sample_paper("SAMPLE Art card 128 gsm 25x36", "card", 128, 600, start)
+            ref = self.env.ref
+            est = self.create({
+                "job_name": SAMPLE_JOB, "base_product_id": ref("pp_print_core.bp_mag").id, "run_qty": 350,
+                "format_id": ref("pp_print_core.fmt_1").id, "date": today, "extra_copies": 200,
+                "overhead_pct": 7.0, "margin_pct": 0.0,
+                "remarks": "Worked example from the costing sheet. No press is chosen: ups, pages per parent sheet and "
+                           "the rates are typed on the job, the way the sheet does it.",
+                "page_ids": [
+                    fields.Command.create({
+                        "sequence": 10, "page_type_id": ref("pp_print_core.pt_text1").id, "pages": 44,
+                        "colours_front": 4, "colours_back": 4, "material_id": paper.id,
+                        "ups": 4, "per_parent": 16, "scrap_method": "copies", "scrap_value": 200,
+                        "plate_rate": 700, "print_rate": 700}),
+                    fields.Command.create({
+                        "sequence": 20, "page_type_id": ref("pp_print_core.pt_cover1").id, "pages": 4,
+                        "colours_front": 4, "colours_back": 0, "material_id": card.id,
+                        "ups": 4, "per_parent": 16, "scrap_method": "sheets", "scrap_value": 50,
+                        "plate_rate": 400, "print_rate": 500}),
+                ],
+                "operation_ids": [
+                    fields.Command.create({
+                        "sequence": 10, "operation_id": ref("pp_print_core.op_lam_shine").id, "name": "Lamination of the cover",
+                        "extra_qty": 150, "piece_width_in": 12.5, "piece_height_in": 18, "rate": 3}),
+                    fields.Command.create({
+                        "sequence": 20, "operation_id": ref("pp_print_core.op_bind_gum").id, "rate": 20}),
+                ],
+                "qty_line_ids": [fields.Command.create({"qty": 500}), fields.Command.create({"qty": 1000})],
+            })
+        return {"type": "ir.actions.act_window", "res_model": "print.estimate", "res_id": est.id,
+                "view_mode": "form", "views": [(False, "form")], "target": "current"}
