--- /dev/null
+++ b/odoo/addons/addons_print/pp_print_core/tests/test_costing.py
@@ -0,0 +1,268 @@
+from datetime import date
+
+from odoo.exceptions import UserError
+from odoo.tests import Form
+from odoo.tests.common import TransactionCase, tagged
+
+
+@tagged("post_install", "-at_install", "pp_print_core")
+class TestCosting(TransactionCase):
+    """Two jobs from the client's costing sheets, costed the way the sheet does it:
+    Model Town (350 copies): subtotal 140,262.87, with 7 % overheads 150,081.27, 428.80 per copy.
+    Zameen (4,000 copies): 7 % overheads and 20 % margin give a sales price of 224.89 per copy."""
+
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        env = cls.env
+        cls.day = date(2026, 9, 30)
+
+        def paper(name, mtype, gsm, price):
+            p = env["product.template"].create({"name": name, "print_material_type": mtype, "print_gsm": gsm,
+                                                "print_width_in": 25, "print_height_in": 36})
+            env["print.material.price"].create({"product_tmpl_id": p.id, "date_from": date(2026, 1, 1),
+                                                "basis": "kg", "price": price})
+            return p
+
+        cls.paper115 = paper("T Art 115", "paper", 115, 590)
+        cls.card128 = paper("T Card 128", "card", 128, 600)
+        cls.paper113 = paper("T Art 113", "paper", 113, 230 / 1.17)
+        cls.card210 = paper("T Card 210", "card", 210, 220 / 1.17)
+        cls.text = env.ref("pp_print_core.pt_text1")
+        cls.cover = env.ref("pp_print_core.pt_cover1")
+        cls.mag = env.ref("pp_print_core.bp_mag")
+        cls.a4 = env.ref("pp_print_core.fmt_1")
+        cls.lam = env.ref("pp_print_core.op_lam_shine")
+        cls.gum = env.ref("pp_print_core.op_bind_gum")
+
+    def _model_town(self, **kw):
+        vals = {
+            "job_name": "Magazine 14K Model Town", "base_product_id": self.mag.id, "run_qty": 350,
+            "format_id": self.a4.id, "date": self.day, "overhead_pct": 7.0, "margin_pct": 0.0,
+            "page_ids": [
+                (0, 0, {"sequence": 1, "page_type_id": self.text.id, "pages": 44, "colours_front": 4, "colours_back": 4,
+                        "material_id": self.paper115.id, "ups": 4, "per_parent": 16,
+                        "scrap_method": "copies", "scrap_value": 200, "plate_rate": 700, "print_rate": 700}),
+                (0, 0, {"sequence": 2, "page_type_id": self.cover.id, "pages": 4, "colours_front": 4, "colours_back": 0,
+                        "material_id": self.card128.id, "ups": 4, "per_parent": 16,
+                        "scrap_method": "sheets", "scrap_value": 50, "plate_rate": 400, "print_rate": 500}),
+            ],
+            "operation_ids": [
+                (0, 0, {"sequence": 1, "operation_id": self.lam.id, "extra_qty": 150,
+                        "piece_width_in": 12.5, "piece_height_in": 18, "rate": 3}),
+                (0, 0, {"sequence": 2, "operation_id": self.gum.id, "rate": 20}),
+            ],
+        }
+        vals.update(kw)
+        return self.env["print.estimate"].create(vals)
+
+    def _amount(self, est, category, part=None):
+        lines = est.cost_line_ids.filtered(lambda l: l.category == category and (not part or l.name.startswith(part)))
+        return sum(lines.mapped("amount"))
+
+    def test_model_town(self):
+        est = self._model_town()
+        text, cover = est.page_ids.sorted("sequence")
+        self.assertTrue(text.calc_ok, text.calc_error)
+        self.assertTrue(cover.calc_ok, cover.calc_error)
+        self.assertFalse(text.press_used_id)                       # no press: the typed figures are used
+        self.assertAlmostEqual(text.paper_sheets, 1512.5)
+        self.assertEqual((text.plates, text.thousands), (44, 1))
+        self.assertAlmostEqual(cover.paper_sheets, 137.5)
+        self.assertEqual((cover.plates, cover.thousands), (4, 1))
+        self.assertAlmostEqual(self._amount(est, "paper", "Text1"), 59587.62, delta=0.15)
+        self.assertAlmostEqual(self._amount(est, "plates", "Text1"), 30800, places=2)
+        self.assertAlmostEqual(self._amount(est, "printing", "Text1"), 30800, places=2)
+        self.assertAlmostEqual(self._amount(est, "paper", "Cover1"), 6131.50, delta=0.15)
+        self.assertAlmostEqual(self._amount(est, "plates", "Cover1"), 1600, places=2)
+        self.assertAlmostEqual(self._amount(est, "printing", "Cover1"), 2000, places=2)
+        self.assertAlmostEqual(self._amount(est, "finishing"), 2343.75, places=2)   # 500 pieces x 1.5625 sq ft x 3
+        self.assertAlmostEqual(self._amount(est, "binding"), 7000, places=2)
+        self.assertAlmostEqual(est.cost_subtotal, 140262.87, delta=0.15)
+        self.assertAlmostEqual(est.cost_total, 150081.27, delta=0.15)
+        self.assertAlmostEqual(est.unit_price, 428.80, places=2)
+        self.assertTrue(est.is_complete, est.cost_warning)
+        self.assertTrue(all(est.cost_line_ids.mapped("how")))
+        self.assertIn("typed", text.override_note)
+
+    def test_zameen(self):
+        est = self.env["print.estimate"].create({
+            "job_name": "Zameen magazine", "base_product_id": self.mag.id, "run_qty": 4000, "format_id": self.a4.id,
+            "date": self.day, "overhead_pct": 7.0, "margin_pct": 20.0, "tax_pct": 17.0,
+            "page_ids": [
+                (0, 0, {"sequence": 1, "page_type_id": self.text.id, "pages": 112, "colours_front": 4, "colours_back": 4,
+                        "material_id": self.paper113.id, "ups": 4, "per_parent": 16,
+                        "scrap_method": "copies", "scrap_value": 300, "plate_rate": 500, "print_rate": 400}),
+                (0, 0, {"sequence": 2, "page_type_id": self.cover.id, "pages": 4, "colours_front": 4, "colours_back": 0,
+                        "material_id": self.card210.id, "ups": 2, "per_parent": 16,
+                        "scrap_method": "sheets", "scrap_value": 100, "plate_rate": 500, "print_rate": 400}),
+            ],
+            "operation_ids": [
+                (0, 0, {"operation_id": self.lam.id, "count": 2100, "piece_width_in": 18, "piece_height_in": 25, "rate": 0.95}),
+                (0, 0, {"operation_id": self.gum.id, "count": 4050, "rate": 10}),
+            ],
+        })
+        text, cover = est.page_ids.sorted("sequence")
+        self.assertAlmostEqual(text.paper_sheets, 30100)
+        self.assertEqual((text.plates, text.thousands), (112, 4))
+        self.assertAlmostEqual(cover.paper_sheets, 1100)
+        self.assertEqual((cover.plates, cover.thousands), (4, 2))
+        self.assertAlmostEqual(self._amount(est, "printing"), 179200 + 3200, places=2)
+        # the sheet divides the price by 1.17 without rounding; a price record holds 2 decimals (196.58 / kg)
+        self.assertAlmostEqual(est.cost_subtotal, 700592.94, delta=5)
+        self.assertAlmostEqual(est.unit_price, 224.89, places=2)
+        self.assertAlmostEqual(est.unit_price_incl, 263.12, places=2)
+        self.assertTrue(est.is_complete, est.cost_warning)
+
+    def test_standard_rates_from_press_and_operation(self):
+        env = self.env
+        grp = env["print.cost.group"].create({"code": "OFFC", "name": "Offset costing test"})
+        press = env["print.workcenter"].create({
+            "code": "TC-4C", "name": "Four-colour 18x25", "workcenter_type": "offset", "cost_group_id": grp.id,
+            "max_width_in": 18, "max_height_in": 25, "colour_units": 4, "gripper_in": 0.4})
+        env["print.workcenter.rate"].create({"workcenter_id": press.id, "date_from": date(2026, 1, 1),
+                                             "plate_rate": 650, "print_rate_1000": 600})
+        env["print.workcenter.rate"].create({"workcenter_id": press.id, "date_from": date(2026, 12, 1),
+                                             "plate_rate": 999, "print_rate_1000": 999})
+        env["print.operation.rate"].create({"operation_id": self.gum.id, "date_from": date(2026, 1, 1), "rate": 18})
+        est = env["print.estimate"].create({
+            "job_name": "Standards", "base_product_id": self.mag.id, "run_qty": 2500, "format_id": self.a4.id, "date": self.day,
+            "page_ids": [(0, 0, {"page_type_id": self.text.id, "pages": 16, "colours_front": 4, "colours_back": 4,
+                                 "material_id": self.paper115.id, "press_id": press.id})],
+            "operation_ids": [(0, 0, {"operation_id": self.gum.id})],
+        })
+        part, op = est.page_ids, est.operation_ids
+        self.assertTrue(part.calc_ok, part.calc_error)
+        self.assertEqual((part.ups, part.plates, part.thousands), (4, 16, 3))      # calculated, nothing typed
+        self.assertFalse(part.ups_typed or part.plates_typed or part.plate_rate_typed)
+        self.assertEqual((part.plate_rate, part.print_rate), (650, 600))            # the rate valid on the Calcdate
+        self.assertAlmostEqual(part.plates_cost, 16 * 650)
+        self.assertAlmostEqual(part.printing_cost, 16 * 3 * 600)
+        self.assertEqual((op.count, op.rate), (2500, 18))
+        self.assertAlmostEqual(op.amount, 45000)
+        self.assertTrue(est.is_complete, est.cost_warning)
+        # a typed rate wins and is reported; unticking goes back to the standard
+        part.plate_rate = 700
+        self.assertTrue(part.plate_rate_typed)
+        self.assertIn("standard 650", part.override_note)
+        self.assertAlmostEqual(part.plates_cost, 16 * 700)
+        part.plate_rate_typed = False
+        self.assertEqual(part.plate_rate, 650)
+        # a typed ups wins; 0 goes back to calculated
+        part.ups = 8
+        self.assertEqual(part.plates, 8)
+        part.ups = 0
+        self.assertEqual((part.ups, part.ups_typed, part.plates), (4, False, 16))
+        # a later Calcdate takes the later rate
+        est.date = date(2026, 12, 15)
+        self.assertEqual(part.plate_rate, 999)
+
+    def test_missing_rates_block_the_quote(self):
+        est = self._model_town()
+        est.operation_ids.filtered(lambda o: o.operation_id == self.gum).rate_typed = False
+        self.assertFalse(est.is_complete)
+        self.assertIn("Gum binding", est.cost_warning)
+        with self.assertRaises(UserError):
+            est.action_set_quoted()
+        with self.assertRaises(UserError):
+            est.action_accept_incomplete()          # needs a reason
+        est.accept_note = "Binding quoted separately"
+        est.action_accept_incomplete()
+        self.assertTrue(est.accepted_incomplete)
+        self.assertFalse(est.quote_internal)
+        est.action_set_quoted()
+        self.assertEqual(est.state, "quoted")
+        # a new gap cancels the acceptance
+        est.page_ids[0].print_rate_typed = False
+        self.assertFalse(est.accepted_incomplete)
+        self.assertTrue(est.quote_internal)
+
+    def test_counts_and_quantities(self):
+        est = self._model_town(qty_line_ids=[(0, 0, {"qty": 700}), (0, 0, {"qty": 1000, "unit_price_typed": 250})])
+        lam = est.operation_ids.filtered(lambda o: o.operation_id == self.lam)
+        gum = est.operation_ids - lam
+        self.assertEqual((lam.count, lam.count_typed, lam.extra_qty), (350, False, 150))
+        est.run_qty = 400                               # an untyped count follows, the extra stays
+        self.assertEqual((lam.count, lam.extra_qty, gum.count), (400, 150, 400))
+        gum.count = 360                                 # a typed count survives
+        est.run_qty = 350
+        self.assertEqual((lam.count, gum.count, gum.count_typed), (350, 360, True))
+        self.assertIn("typed", gum.how)
+        gum.count = 0                                   # 0 = follow the copies ordered again
+        self.assertEqual((gum.count, gum.count_typed), (350, False))
+        q700, q1000 = est.qty_line_ids.sorted("qty")
+        self.assertTrue(q700.is_complete)
+        self.assertLess(q700.unit_price, est.unit_price)            # plates are spread over more copies
+        # 700 copies by hand: text (700+200) x 44/16 sheets, cover 700 x 4/16 + 50, lamination 850 pieces, binding 700
+        kg115, kg128 = 25 * 36 * 0.00064516 * 115 / 1000, 25 * 36 * 0.00064516 * 128 / 1000
+        expected = (2475 * kg115 * 590 + 61600 + 225 * kg128 * 600 + 3600 + 850 * 1.5625 * 3 + 14000) * 1.07
+        self.assertAlmostEqual(q700.cost_total, expected, delta=0.05)
+        self.assertEqual(q1000.unit_price, 250)
+        self.assertAlmostEqual(q1000.price_total, 250000)
+        rows = est._quote_rows()
+        self.assertEqual([r["qty"] for r in rows], [350, 700, 1000])
+        est.unit_price_typed = 450
+        self.assertEqual(est.unit_price, 450)
+        self.assertAlmostEqual(est.price_total, 157500)
+        self.assertAlmostEqual(est.margin_real_pct, (450 - est.unit_cost) / est.unit_cost * 100, places=2)
+
+    def test_operation_bases(self):
+        Op = self.env["print.operation"]
+        fold = self.env.ref("pp_print_core.op_fold")            # per 1,000, whole thousands
+        pack = self.env.ref("pp_print_core.op_pack")            # fixed
+        self.env["print.operation.rate"].create({"operation_id": fold.id, "date_from": date(2026, 1, 1),
+                                                 "rate": 300, "min_charge": 500})
+        hourly = Op.create({"code": "T-HAND", "name": "Hand work", "category": "other", "basis": "hour"})
+        est = self._model_town(operation_ids=[
+            (0, 0, {"operation_id": fold.id}),
+            (0, 0, {"operation_id": pack.id, "rate": 1500}),
+            (0, 0, {"operation_id": hourly.id, "hours": 3, "rate": 400}),
+            (0, 0, {"operation_id": self.lam.id, "rate": 3}),           # no piece size
+        ])
+        f, p, h, l = est.operation_ids.sorted("id")
+        self.assertEqual(f.basis_qty, 1)                                # 350 -> one whole thousand
+        self.assertEqual(f.amount, 500)                                 # 300 lifted to the minimum charge
+        self.assertIn("minimum charge", f.how)
+        self.assertEqual(p.amount, 1500)
+        self.assertEqual(h.amount, 1200)
+        self.assertIn("piece size", l.warning)
+        self.assertFalse(est.is_complete)
+
+    def test_form_new_part_takes_extra_copies_and_report_renders(self):
+        f = Form(self.env["print.estimate"])
+        f.job_name = "Form costing"
+        f.base_product_id = self.env.ref("pp_print_core.bp_flyer")
+        f.run_qty = 1000
+        f.extra_copies = 75
+        f.format_id = self.a4
+        est = f.save()
+        f = Form(est)
+        with f.page_ids.new() as line:
+            line.page_type_id = self.env.ref("pp_print_core.pt_sheet1")
+            line.material_id = self.paper115
+            line.ups = 8
+            line.per_parent = 16
+            line.plate_rate = 500
+            line.print_rate = 400
+        with f.operation_ids.new() as op:
+            op.operation_id = self.gum
+            op.rate = 2
+        f.save()
+        new = est.page_ids.sorted("id")[-1]
+        self.assertEqual((new.scrap_method, new.scrap_value), ("copies", 75))
+        self.assertTrue(new.ups_typed and new.plate_rate_typed)
+        self.assertTrue(est.operation_ids.rate_typed)
+        html = self.env["ir.actions.report"]._render_qweb_html("pp_print_core.report_print_quote", est.ids)[0]
+        self.assertIn(b"Form costing", html)
+        action = est.action_print_quote()
+        # the report itself, or Odoo's document-layout wizard on a company that has not chosen a layout yet
