+    basis = fields.Selection(related="operation_id.basis", string="Costed")
+    page_id = fields.Many2one("print.estimate.page", string="Part", ondelete="set null",
+                              domain="[('estimate_id', '=', estimate_id)]",
+                              help="Optional: the printed part this line works on. Fills the piece size from its print sheet.")
+    count = fields.Float("Count", digits=(12, 2),
+                         help="Pieces worked. Follows the copies ordered; type your own number to fix it, 0 to follow again.")
+    count_typed = fields.Boolean("Count typed")
+    extra_qty = fields.Float("Extra qty", digits=(12, 2), help="Extra pieces for waste. Never changed by the app.")
+    piece_width_in = fields.Float("Piece W (in)", digits=(8, 3))
+    piece_height_in = fields.Float("Piece H (in)", digits=(8, 3))
+    hours = fields.Float("Hours", digits=(8, 2), help="Per hour operations only.")
+    rate = fields.Float("Rate", digits=(12, 4), help="Standard = the operation's rate valid on the Calcdate; a typed rate wins.")
+    rate_typed = fields.Boolean("Rate typed")
+
+    # results (written by the costing)
+    rate_std = fields.Float("Standard rate", digits=(12, 4), readonly=True, copy=False)
+    basis_qty = fields.Float("Quantity", digits=(14, 3), readonly=True, copy=False)
+    basis_unit = fields.Char("Unit", readonly=True, copy=False)
+    currency_id = fields.Many2one(related="estimate_id.currency_id")
+    amount = fields.Monetary(readonly=True, copy=False)
+    how = fields.Char("How it is calculated", readonly=True, copy=False)
