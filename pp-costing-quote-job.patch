+                        </tr>
+                        <tr t-foreach="doc._quote_spec()" t-as="row">
+                            <td><strong t-esc="row['part']"/></td>
+                            <td><span t-esc="row['text']"/></td>
+                        </tr>
+                        <tr t-if="doc.operation_ids">
+                            <td><strong>Finishing</strong></td>
+                            <td><span t-esc="', '.join(doc.operation_ids.mapped('name'))"/></td>
+                        </tr>
+                    </tbody>
+                </table>
+                <table class="table table-sm mt-3">
+                    <thead>
+                        <tr>
+                            <th>Quantity</th>
+                            <th class="text-end">Price per copy</th>
+                            <th class="text-end">Total (excl. tax)</th>
+                            <th class="text-end" t-if="doc.tax_pct">Sales tax <span t-esc="'%g' % doc.tax_pct"/>%</th>
+                            <th class="text-end" t-if="doc.tax_pct">Total (incl. tax)</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        <tr t-foreach="doc._quote_rows()" t-as="row">
+                            <td><span t-esc="'{:,}'.format(row['qty'])"/></td>
+                            <td class="text-end"><span t-esc="row['unit_price']" t-options="{'widget': 'float', 'precision': 2}"/></td>
+                            <td class="text-end"><span t-esc="row['total']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
+                            <td class="text-end" t-if="doc.tax_pct"><span t-esc="row['total'] * doc.tax_pct / 100.0" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
+                            <td class="text-end" t-if="doc.tax_pct"><span t-esc="row['total'] * (1 + doc.tax_pct / 100.0)" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
+                        </tr>
+                    </tbody>
+                </table>
+                <div t-if="doc.delivery_date"><strong>Delivery:</strong> <span t-field="doc.delivery_date"/></div>
+                <div t-if="doc.quote_terms" class="mt-3">
+                    <strong>Terms</strong>
+                    <div t-field="doc.quote_terms"/>
+                </div>
+            </div>
+        </t>
+    </template>
+
+    <template id="report_print_quote">
+        <t t-call="web.html_container">
+            <t t-foreach="docs" t-as="doc">
+                <t t-call="pp_print_core.report_print_quote_document"/>
+            </t>
+        </t>
+    </template>
+</odoo>
