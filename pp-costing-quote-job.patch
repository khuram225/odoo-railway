+    ("released", "Released to production"),
+    ("in_progress", "In progress"),
+    ("done", "Done"),
+    ("cancelled", "Cancelled"),
+]
+STEP_STATES = [("pending", "Pending"), ("running", "Running"), ("done", "Done"), ("skipped", "Skipped")]
+STEP_TYPES = [("plates", "Plate making"), ("printing", "Printing"), ("operation", "Finishing / other")]
+
+
+class PrintWorker(models.Model):
+    """A person on the shop floor. Not an Odoo user: workers do not log in."""
+    _name = "print.worker"
