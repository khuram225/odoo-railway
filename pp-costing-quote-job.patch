+                    <field name="print_price_ids">
+                        <list editable="top">
+                            <field name="date_from"/>
+                            <field name="basis"/>
+                            <field name="price"/>
+                            <field name="currency_id" column_invisible="1"/>
+                            <field name="partner_id"/>
+                            <field name="note"/>
+                        </list>
+                    </field>
+                </sheet>
+            </form>
+        </field>
+    </record>
+
+    <record id="action_print_load_sample" model="ir.actions.server">
