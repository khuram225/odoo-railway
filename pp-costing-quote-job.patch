+from odoo.exceptions import UserError
+from odoo.tests.common import TransactionCase, tagged
+
+
+@tagged("post_install", "-at_install", "pp_print_core", "pp_print_sale")
+class TestPrintSale(TransactionCase):
+
+    def test_quote_to_sale_order(self):
+        est = self.env["print.estimate"].browse(self.env["print.estimate"].action_load_sample()["res_id"])
+        with self.assertRaises(UserError):
+            est.action_create_sale_order()                    # not quoted yet
+        est.action_set_quoted()
+        with self.assertRaises(UserError):
+            est.action_create_sale_order()                    # no customer
+        est.partner_id = self.env["res.partner"].create({"name": "Model Town School"})
+        est.customer_reference = "PO-77"
+        action = est.action_create_sale_order()
+        order = self.env["sale.order"].browse(action["res_id"])
+        self.assertEqual(est.state, "sales_order")
+        self.assertEqual(est.sale_order_id, order)
+        self.assertEqual(order.partner_id, est.partner_id)
+        self.assertEqual(order.client_order_ref, "PO-77")
+        line = order.order_line
+        self.assertEqual(len(line), 1)
+        self.assertEqual(line.product_uom_qty, 350)
+        self.assertAlmostEqual(line.price_unit, 428.80, places=2)
+        self.assertAlmostEqual(order.amount_untaxed, 350 * 428.80, delta=0.01)
+        self.assertIn("Model Town", line.name)
+        self.assertEqual(order.print_estimate_count, 1)
+        self.assertEqual(order.action_open_print_estimates()["res_id"], est.id)
+        self.assertEqual(est.action_create_sale_order()["res_id"], order.id)      # never a second order
+        self.assertFalse(order._fields["print_estimate_count"].store)
