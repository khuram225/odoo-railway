+class PrintJobStep(models.Model):
+    """One step of the job's route: plate making, printing a part, or a finishing / other operation."""
+    _name = "print.job.step"
+    _description = "Job step"
+    _order = "job_id, sequence, id"
+
+    job_id = fields.Many2one("print.job", required=True, ondelete="cascade")
+    sequence = fields.Integer(default=10)
+    name = fields.Char("Step", required=True)
+    step_type = fields.Selection(STEP_TYPES, required=True, default="operation")
+    part_id = fields.Many2one("print.job.part", string="Part", ondelete="set null", domain="[('job_id', '=', job_id)]")
+    operation_id = fields.Many2one("print.operation", string="Operation", ondelete="restrict")
+    workcenter_id = fields.Many2one("print.workcenter", string="Work centre")
+    state = fields.Selection(STEP_STATES, default="pending", required=True)
+    qty_planned = fields.Float("Planned qty", digits=(14, 2))
+    unit = fields.Char()
+    currency_id = fields.Many2one(related="job_id.currency_id")
+    cost_planned = fields.Monetary("Planned cost")
+    date_start = fields.Datetime("Started", readonly=True, copy=False)
+    date_end = fields.Datetime("Finished", readonly=True, copy=False)
+    qty_good = fields.Float("Good qty", digits=(14, 2))
+    qty_waste = fields.Float("Waste qty", digits=(14, 2))
+    machine_hours = fields.Float("Machine hours", digits=(8, 2))
+    outside_cost = fields.Monetary("Outside cost", help="Bill of an outside supplier for this step, if any.")
+    time_ids = fields.One2many("print.job.time", "step_id", string="Time")
+    labour_hours = fields.Float("Labour hours", digits=(8, 2), compute="_compute_actual", store=True)
+    labour_cost = fields.Monetary("Labour cost", compute="_compute_actual", store=True)
+    machine_cost = fields.Monetary("Machine cost", compute="_compute_actual", store=True)
+    cost_actual = fields.Monetary("Actual cost", compute="_compute_actual", store=True)
+    note = fields.Char("Remarks")
+
+    @api.depends("time_ids.hours", "time_ids.cost", "machine_hours", "outside_cost", "workcenter_id", "job_id.date_released")
+    def _compute_actual(self):
+        for rec in self:
+            day = rec.job_id.date_released or fields.Date.context_today(rec)
+            rate = rec.workcenter_id.rate_on(day) if rec.workcenter_id else False
+            machine_rate = (rate.direct_rate_hr + rate.indirect_rate_hr) if rate else 0.0
+            rec.labour_hours = sum(rec.time_ids.mapped("hours"))
+            rec.labour_cost = sum(rec.time_ids.mapped("cost"))
+            rec.machine_cost = rec.machine_hours * machine_rate
+            rec.cost_actual = rec.labour_cost + rec.machine_cost + rec.outside_cost
+
+    def _check_job_open(self):
+        for rec in self:
+            if rec.job_id.state not in ("released", "in_progress"):
+                raise UserError(f"{rec.job_id.name}: release the job to production before working on its steps.")
+
+    def action_start(self):
+        self._check_job_open()
+        for rec in self.filtered(lambda s: s.state == "pending"):
+            rec.write({"state": "running", "date_start": fields.Datetime.now()})
+        self.mapped("job_id").filtered(lambda j: j.state == "released").write({"state": "in_progress"})
+        return True
+
+    def action_finish(self):
+        self._check_job_open()
+        for rec in self.filtered(lambda s: s.state in ("pending", "running")):
+            rec.write({"state": "done", "date_start": rec.date_start or fields.Datetime.now(),
+                       "date_end": fields.Datetime.now(), "qty_good": rec.qty_good or rec.qty_planned})
+        self.mapped("job_id").filtered(lambda j: j.state == "released").write({"state": "in_progress"})
+        return True
+
+    def action_skip(self):
+        self.filtered(lambda s: s.state in ("pending", "running")).write({"state": "skipped"})
+        return True
+
+    def action_reopen(self):
+        for rec in self:
+            if rec.job_id.state == "done":
+                raise UserError(f"{rec.job_id.name} is finished; its steps cannot be reopened.")
+        self.write({"state": "pending", "date_end": False})
+        return True
+
+    @api.constrains("qty_good", "qty_waste", "machine_hours", "outside_cost")
+    def _check_numbers(self):
+        for rec in self:
+            if min(rec.qty_good, rec.qty_waste, rec.machine_hours, rec.outside_cost) < 0:
+                raise UserError(f"{rec.name}: quantities, hours and cost cannot be negative.")
+
+
+class PrintJobTime(models.Model):
+    """Person-wise time on a job step. The rate is the worker's role rate valid on the work date, kept on the line."""
+    _name = "print.job.time"
+    _description = "Job time entry"
+    _order = "date desc, id desc"
+
+    step_id = fields.Many2one("print.job.step", required=True, ondelete="cascade")
+    job_id = fields.Many2one(related="step_id.job_id", store=True)
+    date = fields.Date(required=True, default=fields.Date.context_today)
+    worker_id = fields.Many2one("print.worker", string="Worker", required=True, ondelete="restrict")
+    role_id = fields.Many2one("print.labour.role", string="Role", required=True, ondelete="restrict",
+                              compute="_compute_role", store=True, readonly=False)
+    hours = fields.Float(digits=(8, 2), required=True)
+    currency_id = fields.Many2one(related="step_id.currency_id")
+    rate_hr = fields.Monetary("Rate / hour", compute="_compute_cost", store=True)
+    cost = fields.Monetary(compute="_compute_cost", store=True)
+    note = fields.Char()
+
+    @api.model_create_multi
+    def create(self, vals_list):
+        """The role defaults to the worker's usual role, and is saved with the entry so an old entry keeps its role."""
+        Worker = self.env["print.worker"]
+        for vals in vals_list:
+            if not vals.get("role_id") and vals.get("worker_id"):
+                vals["role_id"] = Worker.browse(vals["worker_id"]).role_id.id
+        return super().create(vals_list)
+
+    @api.depends("worker_id")
+    def _compute_role(self):
+        for rec in self:
+            if rec.worker_id and not rec.role_id:
+                rec.role_id = rec.worker_id.role_id
+
+    @api.depends("role_id", "date", "hours")
+    def _compute_cost(self):
+        for rec in self:
+            rec.rate_hr = rec.role_id.rate_on(rec.date) if rec.role_id else 0.0
+            rec.cost = rec.hours * rec.rate_hr
+
+    @api.constrains("hours")
+    def _check_hours(self):
+        for rec in self:
+            if rec.hours <= 0:
+                raise UserError("Hours must be more than zero.")
+
+
+class PrintEstimate(models.Model):
+    _inherit = "print.estimate"
+
+    job_ids = fields.One2many("print.job", "estimate_id", string="Job tickets")
+    job_count = fields.Integer(compute="_compute_job_count")
+
+    @api.depends("job_ids")
+    def _compute_job_count(self):
+        for rec in self:
+            rec.job_count = len(rec.job_ids)
+
+    def _job_vals(self):
+        """Snapshot of the estimate for a job ticket: parts with the paper to issue, then the route:
+        plates and printing for each part, then the finishing lines in their order."""
+        self.ensure_one()
+        parts, steps, seq = [], [], 0
+        for p in self.page_ids.sorted(lambda r: (r.sequence, r.id)):
+            if not p.calc_ok:
+                raise UserError(f"{p.page_type_id.code}: {p.calc_error or 'not calculated'}. Fix the part before making a job.")
+            label = f"{p.page_type_id.code} - {p.page_type_id.name}"
+            parts.append({
+                "sequence": p.sequence, "name": label, "pages": p.pages, "colours": f"{p.colours_front}/{p.colours_back}",
+                "material_id": p.material_id.id, "paper_size": p.paper_size_text, "press_id": p.press_used_id.id,
+                "print_size": (f"{p.print_width_in:g} x {p.print_height_in:g} in" if p.print_width_in else False),
+                "ups": p.ups, "plates": p.plates, "print_sheets_net": p.print_net, "print_sheets_total": p.print_total,
+                "paper_sheets_planned": p.paper_sheets, "paper_kg_planned": p.paper_kg,
+                "cost_per_sheet": p.paper_cost_per_sheet, "paper_cost_planned": p.paper_cost,
+            })
+            if p.plates:
+                seq += 10
+                steps.append({"sequence": seq, "name": f"Plates: {p.page_type_id.code}", "step_type": "plates",
+                              "_part": len(parts) - 1, "qty_planned": p.plates, "unit": "plates", "cost_planned": p.plates_cost})
+            seq += 10
+            steps.append({"sequence": seq, "name": f"Printing: {p.page_type_id.code}", "step_type": "printing",
+                          "_part": len(parts) - 1, "workcenter_id": p.press_used_id.id, "qty_planned": p.print_total,
+                          "unit": "print sheets", "cost_planned": p.printing_cost})
+        for op in self.operation_ids.sorted(lambda r: (r.sequence, r.id)):
+            seq += 10
+            steps.append({"sequence": seq, "name": op.name or op.operation_id.name, "step_type": "operation",
+                          "operation_id": op.operation_id.id, "workcenter_id": op.operation_id.workcenter_id.id,
+                          "qty_planned": op.basis_qty, "unit": op.basis_unit, "cost_planned": op.amount})
+        return parts, steps
+
+    def action_create_job(self):
+        """Confirmed order -> job ticket. One live job per estimate; a cancelled job does not count."""
+        self.ensure_one()
+        live = self.job_ids.filtered(lambda j: j.state != "cancelled")
+        if live:
+            return self.action_open_jobs()
+        if self.state != "sales_order":
+            raise UserError("Confirm the order first (Order confirmed / Create sales order); a job is made for a confirmed order.")
+        parts, steps = self._job_vals()
+        job = self.env["print.job"].create({
+            "estimate_id": self.id, "qty": self.run_qty, "width_in": self.width_in, "height_in": self.height_in,
+            "delivery_date": self.delivery_date, "planned_cost": self.cost_subtotal, "instructions": self.remarks,
+            "part_ids": [fields.Command.create(v) for v in parts],
+        })
+        part_recs = job.part_ids.sorted(lambda r: (r.sequence, r.id))
+        for vals in steps:
+            idx = vals.pop("_part", None)
+            vals.update(job_id=job.id, part_id=part_recs[idx].id if idx is not None else False)
+        self.env["print.job.step"].create(steps)
+        job.message_post(body=f"Job made from estimate {self.name} / {self.version}: {self.run_qty:,} copies.")
+        return self.action_open_jobs()
+
+    def action_open_jobs(self):
+        self.ensure_one()
+        jobs = self.job_ids
+        action = {"type": "ir.actions.act_window", "res_model": "print.job", "name": "Job tickets",
+                  "view_mode": "list,form", "views": [(False, "list"), (False, "form")], "domain": [("estimate_id", "=", self.id)]}
+        live = jobs.filtered(lambda j: j.state != "cancelled")
+        if len(live) == 1:
+            action.update(view_mode="form", views=[(False, "form")], res_id=live.id)
+        return action
