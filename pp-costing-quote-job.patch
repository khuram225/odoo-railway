+
+    @api.depends("width_in", "height_in")
+    def _compute_size_mm_text(self):
+        for rec in self:
+            rec.size_mm_text = (f"{rec.width_in * 25.4:.0f} x {rec.height_in * 25.4:.0f} mm"
+                                if rec.width_in and rec.height_in else False)
+
+    @api.depends("is_complete", "accepted_incomplete")
+    def _compute_quote_internal(self):
+        for rec in self:
+            rec.quote_internal = not rec.is_complete and not rec.accepted_incomplete
+
+    @api.constrains("overhead_pct", "margin_pct", "tax_pct", "unit_price_typed", "extra_copies")
+    def _check_costing_inputs(self):
+        for rec in self:
+            if min(rec.overhead_pct, rec.tax_pct, rec.unit_price_typed, rec.extra_copies) < 0:
+                raise UserError("Overheads, tax, a typed price and extra copies cannot be negative.")
+
+    # ---------------------------------------------------------------- costing
+    def _costing(self, qty, store=False):
+        """Plan and cost the whole job for a quantity.
+
+        Pure unless store=True, which also writes each part's and each finishing line's results
+        (only valid for the copies ordered). Returns dict(lines, warnings, subtotal, overhead, total,
+        unit_cost, margin_unit, unit_price_calc)."""
+        self.ensure_one()
+        spine = self._spine_in()
+        lines, warnings = [], []
+
+        def add(category, name, qty_, unit, rate, amount, how):
+            lines.append({"sequence": len(lines) + 1, "category": category, "name": name, "qty": qty_, "unit": unit,
+                          "rate": rate, "amount": amount, "how": how})
+
+        for part in self.page_ids.sorted(lambda p: (p.sequence, p.id)):
+            plan = part._calculate(spine) if store else part._plan(qty, spine)
+            warnings += plan["warnings"]
+            if not plan["ok"]:
+                continue
+            v, hows, code = plan["vals"], plan["hows"], part.page_type_id.code
+            add("paper", f"{code}: {part.material_id.display_name}", v["paper_sheets"], "sheets",
+                v["paper_cost_per_sheet"], v["paper_cost"], hows["paper"])
+            if v["plates"]:
+                add("plates", f"{code}: plates", v["plates"], "plates", v["plate_rate"], v["plates_cost"], hows["plates"])
+                add("printing", f"{code}: printing", v["plates"] * v["thousands"], "plate-thousands",
+                    v["print_rate"], v["printing_cost"], hows["printing"])
+        for op in self.operation_ids.sorted(lambda o: (o.sequence, o.id)):
+            res = op._cost(qty)
+            if store:
+                op.with_context(**SKIP).write(res["vals"])
+            warnings += res["warnings"]
+            add(op.category, op.name or op.operation_id.name, res["basis_qty"], BASIS_UNIT[op.operation_id.basis],
+                res["rate"], res["amount"], res["how"])
+        if not lines:
+            warnings.append("Nothing to cost yet: add a part or a finishing line.")
+        subtotal = sum(line["amount"] for line in lines)
+        overhead = subtotal * self.overhead_pct / 100.0
+        total = subtotal + overhead
+        unit_cost = total / qty if qty else 0.0
+        margin_unit = unit_cost * self.margin_pct / 100.0
+        return {"lines": lines, "warnings": warnings, "subtotal": subtotal, "overhead": overhead, "total": total,
+                "unit_cost": unit_cost, "margin_unit": margin_unit, "unit_price_calc": unit_cost + margin_unit}
+
+    def _store_costing(self):
+        self.ensure_one()
+        qty = self.run_qty
+        res = self._costing(qty, store=True)
+        typed = self.unit_price_typed
+        unit_price = typed or res["unit_price_calc"]
+        price_total = unit_price * qty
+        tax = price_total * self.tax_pct / 100.0
+        warnings = list(res["warnings"])
+        qty_cmds = []
+        for line in self.qty_line_ids:
+            other = self._costing(line.qty)
+            price = line.unit_price_typed or other["unit_price_calc"]
+            qty_cmds.append(fields.Command.update(line.id, {
+                "cost_total": other["total"], "unit_cost": other["unit_cost"], "unit_price_calc": other["unit_price_calc"],
+                "unit_price": price, "price_total": price * line.qty, "is_complete": not other["warnings"],
+                "note": ("typed price" if line.unit_price_typed else False) if not other["warnings"]
+                        else "incomplete: " + " ".join(other["warnings"])[:200],
+            }))
+            warnings += [f"{line.qty:,} copies: {w}" for w in other["warnings"] if w not in res["warnings"]]
+        warning_text = "\n".join(dict.fromkeys(warnings)) or False
+        how = (f"({res['subtotal']:,.2f} + {self.overhead_pct:g}% overheads) / {qty:,} copies = {res['unit_cost']:,.2f} cost per copy; "
+               f"+ {self.margin_pct:g}% margin = {res['unit_price_calc']:,.2f}"
+               + (f"; typed price {typed:,.2f} is used" if typed else ""))
+        vals = {
+            "cost_line_ids": [fields.Command.clear()] + [fields.Command.create(line) for line in res["lines"]],
+            "qty_line_ids": qty_cmds,
+            "cost_subtotal": res["subtotal"], "overhead_amount": res["overhead"], "cost_total": res["total"],
+            "unit_cost": res["unit_cost"], "margin_unit": res["margin_unit"], "unit_price_calc": res["unit_price_calc"],
+            "unit_price": unit_price, "price_total": price_total, "tax_amount": tax, "price_total_incl": price_total + tax,
+            "unit_price_incl": unit_price * (1 + self.tax_pct / 100.0),
+            "margin_real_pct": ((unit_price - res["unit_cost"]) / res["unit_cost"] * 100.0) if res["unit_cost"] else 0.0,
+            "cost_how": how, "is_complete": not warnings, "cost_warning": warning_text,
+        }
+        # an acceptance covers exactly the gaps the manager saw; new gaps need a new acceptance
+        if self.accepted_incomplete and (not warnings or warning_text != self.accepted_warning):
+            vals.update(accepted_incomplete=False, accepted_by_id=False, accepted_warning=False)
+        self.with_context(**SKIP).write(vals)
+
+    def _run_calculation(self):
+        for rec in self:
+            rec._store_costing()
+
+    # ---------------------------------------------------------------- quotation
+    def _check_quotable(self):
