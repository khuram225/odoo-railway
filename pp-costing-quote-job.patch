+
+    name = fields.Char(required=True)
+    code = fields.Char("Worker no.")
+    role_id = fields.Many2one("print.labour.role", string="Usual role", required=True, ondelete="restrict",
+                              help="Gives the hourly rate used when this person's time is logged on a job.")
