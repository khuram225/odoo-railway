+class PrintEstimateOperation(models.Model):
+    """A finishing / other line of an estimate: lamination, binding, die cutting, making, packing, delivery ...
+    The count follows the copies ordered until the user types one; the extra qty is never changed by the app."""
+    _name = "print.estimate.operation"
+    _description = "Estimate finishing line"
