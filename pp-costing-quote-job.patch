@@ -0,0 +1,17 @@
+import logging
+
+from odoo import SUPERUSER_ID, api
+
+_logger = logging.getLogger(__name__)
+
+
+def migrate(cr, version):
+    """Costing step: fill the new result fields (ups, plates, rates, cost lines, totals) of the estimates
+    that already exist. Never fails the upgrade: an estimate that cannot be calculated is logged and skipped."""
+    env = api.Environment(cr, SUPERUSER_ID, {})
+    for est in env["print.estimate"].search([]):
+        try:
+            with cr.savepoint():
+                est._run_calculation()
+        except Exception:  # pylint: disable=broad-except
+            _logger.exception("pp_print_core: estimate %s could not be recalculated; open it and press Calculate", est.name)
