+class PrintJob(models.Model):
+    """Job ticket: the production order made from a confirmed estimate. It snapshots what was planned
+    (parts, paper to issue, steps with planned quantity and cost) and collects what really happened
+    (paper issued, good and waste quantities, person-wise hours, machine hours), so estimate and actual can be compared."""
+    _name = "print.job"
+    _description = "Print job ticket"
+    _inherit = ["mail.thread", "mail.activity.mixin"]
+    _order = "name desc"
+    _rec_names_search = ["name", "job_name", "partner_id.name"]
+
+    name = fields.Char("Job no.", required=True, copy=False, readonly=True, default="New", tracking=True)
+    estimate_id = fields.Many2one("print.estimate", string="Estimate", required=True, readonly=True, ondelete="restrict")
+    job_name = fields.Char(related="estimate_id.job_name", store=True)
+    partner_id = fields.Many2one(related="estimate_id.partner_id", store=True, string="Customer")
+    base_product_id = fields.Many2one(related="estimate_id.base_product_id", store=True)
+    company_id = fields.Many2one(related="estimate_id.company_id", store=True)
+    currency_id = fields.Many2one(related="estimate_id.currency_id")
+    state = fields.Selection(JOB_STATES, default="draft", required=True, tracking=True)
+    qty = fields.Integer("Copies to deliver", required=True, tracking=True)
+    width_in = fields.Float("Width (in)", digits=(8, 3), readonly=True)
+    height_in = fields.Float("Height (in)", digits=(8, 3), readonly=True)
+    date_released = fields.Date("Released on", readonly=True, copy=False)
+    date_planned_start = fields.Date("Planned start")
+    delivery_date = fields.Date("Delivery", tracking=True)
+    date_done = fields.Date("Finished on", readonly=True, copy=False)
+    qty_delivered = fields.Integer("Copies finished", tracking=True)
+    instructions = fields.Text("Instructions for production")
+    part_ids = fields.One2many("print.job.part", "job_id", string="Parts and paper")
+    step_ids = fields.One2many("print.job.step", "job_id", string="Steps")
+    time_line_ids = fields.One2many("print.job.time", "job_id", string="Time")
+    steps_done = fields.Char("Progress", compute="_compute_progress")
+
+    # estimate against actual
+    planned_cost = fields.Monetary("Planned cost", readonly=True, help="Cost subtotal of the estimate when the job was made (before overheads).")
+    planned_paper_cost = fields.Monetary("Planned paper", compute="_compute_costs")
+    actual_paper_cost = fields.Monetary("Actual paper", compute="_compute_costs")
+    planned_work_cost = fields.Monetary("Planned work", compute="_compute_costs")
+    actual_work_cost = fields.Monetary("Actual work", compute="_compute_costs")
+    actual_cost = fields.Monetary("Actual cost", compute="_compute_costs")
+    cost_variance = fields.Monetary("Over (+) / under (-) plan", compute="_compute_costs")
+    actual_note = fields.Char("How the actual cost is calculated", compute="_compute_costs")
+
+    @api.depends("step_ids.state")
+    def _compute_progress(self):
+        for rec in self:
+            steps = rec.step_ids.filtered(lambda s: s.state != "skipped")
+            rec.steps_done = f"{len(steps.filtered(lambda s: s.state == 'done'))} of {len(steps)} steps done" if steps else False
+
+    @api.depends("part_ids.paper_cost_planned", "part_ids.paper_cost_actual", "step_ids.cost_planned",
+                 "step_ids.cost_actual", "planned_cost")
+    def _compute_costs(self):
+        for rec in self:
+            rec.planned_paper_cost = sum(rec.part_ids.mapped("paper_cost_planned"))
+            rec.actual_paper_cost = sum(rec.part_ids.mapped("paper_cost_actual"))
+            rec.planned_work_cost = sum(rec.step_ids.mapped("cost_planned"))
+            rec.actual_work_cost = sum(rec.step_ids.mapped("cost_actual"))
+            rec.actual_cost = rec.actual_paper_cost + rec.actual_work_cost
+            rec.cost_variance = rec.actual_cost - rec.planned_cost if rec.actual_cost else 0.0
+            rec.actual_note = ("paper issued x cost per sheet + for each step: logged hours x role rate "
+                               "+ machine hours x machine rate + outside cost")
+
+    @api.model_create_multi
+    def create(self, vals_list):
+        for vals in vals_list:
+            if vals.get("name", "New") == "New":
+                vals["name"] = self.env["ir.sequence"].next_by_code("print.job") or "New"
+        return super().create(vals_list)
+
+    # ---------------------------------------------------------------- actions
+    def action_release(self):
+        for rec in self:
+            if rec.state != "draft":
+                raise UserError(f"{rec.name}: only a draft job can be released.")
+            if not rec.step_ids:
+                raise UserError(f"{rec.name}: the job has no steps.")
+            rec.write({"state": "released", "date_released": fields.Date.context_today(rec)})
+        return True
+
+    def action_done(self):
+        for rec in self:
+            open_steps = rec.step_ids.filtered(lambda s: s.state in ("pending", "running"))
+            if open_steps:
+                raise UserError(f"{rec.name}: finish or skip these steps first: " + ", ".join(open_steps.mapped("name")))
+            rec.write({"state": "done", "date_done": fields.Date.context_today(rec),
+                       "qty_delivered": rec.qty_delivered or rec.qty})
+        return True
+
+    def action_cancel(self):
+        for rec in self:
+            if rec.state == "done":
+                raise UserError(f"{rec.name}: a finished job cannot be cancelled.")
+        self.write({"state": "cancelled"})
+        return True
+
+    def action_reset(self):
+        self.filtered(lambda r: r.state == "cancelled").write({"state": "draft"})
+        return True
+
+    def action_print_ticket(self):
+        self.ensure_one()
+        return self.env.ref("pp_print_core.action_report_print_job").report_action(self)
+
+    def action_open_estimate(self):
+        self.ensure_one()
+        return {"type": "ir.actions.act_window", "res_model": "print.estimate", "res_id": self.estimate_id.id,
+                "view_mode": "form", "views": [(False, "form")], "target": "current"}
+
+
+class PrintJobPart(models.Model):
+    """Snapshot of one printed part of the estimate: what to print and how much paper to issue."""
+    _name = "print.job.part"
+    _description = "Job part and paper"
+    _order = "job_id, sequence, id"
+
+    job_id = fields.Many2one("print.job", required=True, ondelete="cascade")
+    sequence = fields.Integer(default=10)
+    name = fields.Char("Part", required=True)
+    pages = fields.Integer()
+    colours = fields.Char()
+    material_id = fields.Many2one("product.template", string="Paper", ondelete="restrict")
+    paper_size = fields.Char("Paper size")
+    press_id = fields.Many2one("print.workcenter", string="Press")
+    print_size = fields.Char("Print sheet")
+    ups = fields.Integer()
+    plates = fields.Integer()
+    print_sheets_net = fields.Float("Print sheets (good)", digits=(12, 2))
+    print_sheets_total = fields.Float("Print sheets (with extra)", digits=(12, 2))
+    paper_sheets_planned = fields.Float("Paper to issue", digits=(12, 2))
+    paper_kg_planned = fields.Float("Kg", digits=(12, 2))
+    cost_per_sheet = fields.Float("Cost / sheet", digits=(12, 4))
+    currency_id = fields.Many2one(related="job_id.currency_id")
+    paper_cost_planned = fields.Monetary("Planned paper cost")
+    paper_sheets_issued = fields.Float("Paper issued", digits=(12, 2), help="Sheets really issued to this job.")
+    paper_cost_actual = fields.Monetary("Actual paper cost", compute="_compute_actual", store=True)
+    paper_variance = fields.Float("Sheets over (+) / under (-)", digits=(12, 2), compute="_compute_actual", store=True)
+
+    @api.depends("paper_sheets_issued", "cost_per_sheet", "paper_sheets_planned")
+    def _compute_actual(self):
+        for rec in self:
+            rec.paper_cost_actual = rec.paper_sheets_issued * rec.cost_per_sheet
+            rec.paper_variance = (rec.paper_sheets_issued - rec.paper_sheets_planned) if rec.paper_sheets_issued else 0.0
+
+    @api.constrains("paper_sheets_issued")
+    def _check_issued(self):
+        for rec in self:
+            if rec.paper_sheets_issued < 0:
+                raise UserError("Paper issued cannot be negative.")
+
