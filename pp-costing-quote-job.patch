@@ -0,0 +1,66 @@
+from odoo import fields, models
+from odoo.exceptions import UserError
+
+PARAM_PRODUCT = "pp_print_sale.job_product_id"
+
+
+class PrintEstimate(models.Model):
+    _inherit = "print.estimate"
+
+    sale_order_id = fields.Many2one("sale.order", string="Sales order", readonly=True, copy=False, tracking=True)
+
+    def _sale_job_product(self):
+        """The service product a print job is sold as. A system parameter can point at another product,
+        so it can be replaced without code; the default is the product this module creates."""
+        Product = self.env["product.product"]
+        param = self.env["ir.config_parameter"].sudo().get_param(PARAM_PRODUCT)
+        product = Product.browse(int(param)).exists() if param and param.isdigit() else Product
+        product = product or self.env.ref("pp_print_sale.product_print_job", raise_if_not_found=False)
+        if not product:
+            raise UserError("The product 'Print job' is missing. Create a service product and put its id in the "
+                            f"system parameter {PARAM_PRODUCT}.")
+        return product
+
+    def _sale_line_name(self):
+        self.ensure_one()
+        lines = [f"{self.job_name} ({self.name} / {self.version})"]
+        if self.width_in and self.height_in:
+            lines.append(f"Size {self.width_in:g} x {self.height_in:g} in ({self.size_mm_text})")
+        lines += [f"{row['part']}: {row['text']}" for row in self._quote_spec()]
+        if self.operation_ids:
+            lines.append("Finishing: " + ", ".join(self.operation_ids.mapped("name")))
+        return "\n".join(lines)
+
+    def action_create_sale_order(self):
+        """Quoted estimate -> draft sales order with one line: the job, at the quoted price per copy."""
+        self.ensure_one()
+        if self.sale_order_id:
+            return self.action_open_sale_order()
+        if self.state != "quoted":
+            raise UserError("Mark the estimate as quoted first.")
+        if not self.partner_id:
+            raise UserError("Choose the customer on the estimate first.")
+        self._check_quotable()
+        order = self.env["sale.order"].create({
+            "partner_id": self.partner_id.id,
+            "origin": f"{self.name} / {self.version}",
+            "client_order_ref": self.customer_reference or self.requisition or False,
+            "user_id": (self.sales_rep_id or self.env.user).id,
+            "commitment_date": self.delivery_date or False,
+            "order_line": [fields.Command.create({
+                "product_id": self._sale_job_product().id,
+                "name": self._sale_line_name(),
+                "product_uom_qty": self.run_qty,
+                "price_unit": self.unit_price,
+            })],
+        })
+        self.with_context(print_skip_calc=True).write({
+            "sale_order_id": order.id, "state": "sales_order",
+            "order_date": self.order_date or fields.Date.context_today(self)})
+        self.message_post(body=f"Sales order {order.name} created at {self.unit_price:,.2f} per copy for {self.run_qty:,} copies.")
+        return self.action_open_sale_order()
+
+    def action_open_sale_order(self):
+        self.ensure_one()
+        return {"type": "ir.actions.act_window", "res_model": "sale.order", "res_id": self.sale_order_id.id,
+                "view_mode": "form", "views": [(False, "form")], "target": "current"}
