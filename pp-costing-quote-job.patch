+                    </div>
+                </div>
+                <h4><span t-field="doc.job_name"/></h4>
+                <div t-if="doc.description" t-field="doc.description"/>
+                <table class="table table-sm mt-2">
+                    <tbody>
+                        <tr>
+                            <td style="width: 30%;"><strong>Product</strong></td>
+                            <td><span t-field="doc.base_product_id.name"/></td>
+                        </tr>
+                        <tr t-if="doc.width_in and doc.height_in">
+                            <td><strong>Finished size</strong></td>
