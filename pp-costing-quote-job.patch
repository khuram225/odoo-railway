--- /dev/null
+++ b/odoo/addons/addons_print/pp_print_core/models/operation.py
@@ -0,0 +1,89 @@
+from odoo import api, fields, models
+
+OPERATION_CATEGORIES = [
+    ("prepress", "Prepress"),
+    ("finishing", "Finishing"),
+    ("binding", "Binding"),
+    ("making", "Making (boxes, bags, envelopes, pads)"),
+    ("packing", "Packing"),
+    ("delivery", "Delivery"),
+    ("outsourced", "Outsourced"),
+    ("other", "Other"),
+]
+OPERATION_BASIS = [
+    ("copy", "Per piece / copy"),
+    ("thousand", "Per 1,000 pieces"),
+    ("sqft", "Per square foot (pieces x piece size)"),
+    ("sqin", "Per square inch (pieces x piece size)"),
+    ("hour", "Per hour"),
+    ("fixed", "Fixed amount (lump sum)"),
+]
+BASIS_UNIT = {"copy": "pieces", "thousand": "thousand", "sqft": "sq ft", "sqin": "sq in", "hour": "hours", "fixed": "lump sum"}
+
+
+class PrintOperation(models.Model):
+    """Catalogue of everything that is not paper, plates or printing: lamination, binding, die cutting,
+    making, packing, delivery ... Each has a costing basis and effective-dated standard rates.
+    The job-specific numbers (count, extra, piece size, a typed rate) live on the estimate line."""
+    _name = "print.operation"
+    _description = "Finishing / other operation"
+    _order = "category, sequence, name"
+
+    code = fields.Char(required=True)
+    name = fields.Char(required=True)
+    sequence = fields.Integer(default=10)
+    active = fields.Boolean(default=True)
+    category = fields.Selection(OPERATION_CATEGORIES, required=True, default="finishing")
+    basis = fields.Selection(OPERATION_BASIS, string="Costed", required=True, default="copy")
+    round_up_thousand = fields.Boolean("Whole thousands", help="Per 1,000 only: round the quantity up to whole thousands.")
+    workcenter_id = fields.Many2one("print.workcenter", string="Work centre",
+                                    help="Optional. Per hour only: when the operation has no rate of its own, "
+                                         "the work centre's total cost per hour on the Calcdate is the standard rate.")
+    currency_id = fields.Many2one("res.currency", default=lambda s: s.env.company.currency_id, required=True)
+    rate_ids = fields.One2many("print.operation.rate", "operation_id", string="Rates")
+    current_rate = fields.Float("Current rate", digits=(12, 4), compute="_compute_current")
+    current_min_charge = fields.Monetary("Current minimum charge", compute="_compute_current")
+    note = fields.Text()
+
+    _code_uniq = models.Constraint("unique(code)", "Operation code must be unique.")
+
+    def rate_on(self, date=None):
+        """Rate record effective on a date (latest 'valid from' on or before it)."""
+        self.ensure_one()
+        date = date or fields.Date.context_today(self)
+        return self.rate_ids.filtered(lambda r: r.date_from <= date).sorted("date_from", reverse=True)[:1]
+
+    def standard_on(self, date=None):
+        """Return (rate, minimum charge, source text) valid on a date."""
+        self.ensure_one()
+        rec = self.rate_on(date)
+        if rec:
+            return rec.rate, rec.min_charge, f"standard rate valid from {rec.date_from}"
+        if self.basis == "hour" and self.workcenter_id:
+            wc = self.workcenter_id
+            wc_rate = wc.rate_on(date)
+            total = ((wc_rate.direct_rate_hr + wc_rate.indirect_rate_hr) if wc_rate else 0.0) + wc.crew_rate_on(date)
+            if total:
+                return total, 0.0, f"{wc.name}: machine + crew cost per hour"
+        return 0.0, 0.0, "no standard rate"
+
+    @api.depends("rate_ids.date_from", "rate_ids.rate", "rate_ids.min_charge", "workcenter_id", "basis")
+    def _compute_current(self):
+        for rec in self:
+            rate, min_charge, _src = rec.standard_on()
+            rec.current_rate = rate
+            rec.current_min_charge = min_charge
+
+
+class PrintOperationRate(models.Model):
+    _name = "print.operation.rate"
+    _description = "Operation rate (effective-dated)"
+    _order = "date_from desc"
+
+    operation_id = fields.Many2one("print.operation", required=True, ondelete="cascade")
+    date_from = fields.Date("Valid from", required=True, default=fields.Date.context_today)
+    currency_id = fields.Many2one(related="operation_id.currency_id")
+    rate = fields.Float(digits=(12, 4), required=True, help="Per the operation's basis: per piece, per 1,000, per sq ft ...")
+    min_charge = fields.Monetary("Minimum charge", help="The line is never costed below this amount (standard rate only).")
+    partner_id = fields.Many2one("res.partner", string="Supplier", help="For outsourced work.")
+    note = fields.Char()
