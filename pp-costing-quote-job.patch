+
+    @api.onchange("operation_id")
+    def _onchange_operation(self):
+        if self.operation_id and not self.name:
+            self.name = self.operation_id.name
+
+    @api.onchange("page_id")
+    def _onchange_page(self):
+        p = self.page_id
+        if p and p.print_width_in and p.print_height_in and not (self.piece_width_in or self.piece_height_in):
+            self.piece_width_in, self.piece_height_in = p.print_width_in, p.print_height_in
+
+    @api.onchange("count")
+    def _onchange_count(self):
+        self.count_typed = bool(self.count)
+
+    @api.onchange("rate")
+    def _onchange_rate(self):
+        self.rate_typed = True
+
+    @api.model
+    def _typed_flags(self, vals):
+        if self.env.context.get("print_skip_calc"):
+            return vals
+        vals = dict(vals)
+        if "count" in vals and "count_typed" not in vals:
+            vals["count_typed"] = bool(vals["count"])
+        if "rate" in vals and "rate_typed" not in vals:
+            vals["rate_typed"] = True
+        return vals
+
+    def _cost(self, qty):
+        """Cost this line for a quantity. Pure: returns dict(vals, amount, how, warnings)."""
+        self.ensure_one()
+        est, op = self.estimate_id, self.operation_id
+        label = self.name or op.name
+        ordered = est.run_qty or 1
+        warnings = []
+        if self.count_typed and self.count:
+            if qty == ordered:
+                count, count_how = self.count, f"{self.count:g} typed"
+            else:
+                count = self.count * qty / ordered
+                count_how = f"{count:g} (typed {self.count:g} for {ordered:,} copies, scaled to {qty:,})"
+        else:
+            count, count_how = float(qty), f"{qty:,} copies ordered"
+        pieces = count + self.extra_qty
+        pieces_how = f"{count_how} + {self.extra_qty:g} extra = {pieces:g} pieces" if self.extra_qty else f"{count_how}"
+        w, h = self.piece_width_in, self.piece_height_in
+        basis = op.basis
+        if basis == "copy":
+            basis_qty, qty_how = pieces, pieces_how
+        elif basis == "thousand":
+            basis_qty = pieces / 1000.0
+            qty_how = f"{pieces_how} / 1,000"
+            if op.round_up_thousand:
+                basis_qty = float(max(1, math.ceil(basis_qty - 1e-9)))
+                qty_how += ", rounded up to whole thousands"
+        elif basis in ("sqft", "sqin"):
+            if not (w and h):
+                warnings.append(f"{label}: set the piece size (W x H) to cost it per {BASIS_UNIT[basis]}.")
+            area = w * h / (144.0 if basis == "sqft" else 1.0)
+            basis_qty = pieces * area
+            qty_how = (f"{pieces_how} x {w:g} x {h:g} in" + (" / 144" if basis == "sqft" else "")
+                       + f" = {basis_qty:,.2f} {BASIS_UNIT[basis]}")
+        elif basis == "hour":
+            if not self.hours:
+                warnings.append(f"{label}: enter the hours.")
+            basis_qty, qty_how = self.hours, f"{self.hours:g} hours"
+        else:
+            basis_qty, qty_how = 1.0, "fixed amount"
+        std, min_charge, std_src = op.standard_on(est.date)
+        if self.rate_typed:
+            rate = self.rate
+            rate_how = f"typed {rate:g}" + (f"; standard {std:g}" if std else "")
+        else:
+            rate = std
+            rate_how = f"{std:g} ({std_src})"
+            if not std:
+                warnings.append(f"{label}: no rate valid on {est.date}; add one on the operation or type a rate on the line.")
+        amount = basis_qty * rate
+        how = f"{qty_how} x {rate_how}"
+        if not self.rate_typed and min_charge and amount < min_charge:
+            how += f"; minimum charge {min_charge:g} applied"
+            amount = min_charge
+        vals = {"rate_std": std, "basis_qty": basis_qty, "basis_unit": BASIS_UNIT[basis], "amount": amount, "how": how,
+                "warning": " ".join(warnings) or False}
+        if not self.count_typed:
+            vals["count"] = float(qty)
+        if not self.rate_typed:
+            vals["rate"] = std
+        return {"vals": vals, "amount": amount, "how": how, "warnings": warnings, "basis_qty": basis_qty, "rate": rate}
+
+    @api.model_create_multi
+    def create(self, vals_list):
+        vals_list = [self._typed_flags(vals) for vals in vals_list]
+        for vals in vals_list:
+            if not vals.get("name") and vals.get("operation_id"):
+                vals["name"] = self.env["print.operation"].browse(vals["operation_id"]).name
+        recs = super().create(vals_list)
+        if not self.env.context.get("print_skip_calc"):
+            recs.mapped("estimate_id")._run_calculation()
+        return recs
+
+    def write(self, vals):
+        res = super().write(self._typed_flags(vals))
+        if not self.env.context.get("print_skip_calc"):
+            self.mapped("estimate_id")._run_calculation()
+        return res
+
+    def unlink(self):
+        estimates = self.mapped("estimate_id")
+        res = super().unlink()
+        if not self.env.context.get("print_skip_calc"):
+            estimates.exists()._run_calculation()
+        return res
+
+    @api.constrains("count", "extra_qty", "hours", "piece_width_in", "piece_height_in")
+    def _check_numbers(self):
+        for rec in self:
+            if min(rec.count, rec.extra_qty, rec.hours, rec.piece_width_in, rec.piece_height_in) < 0:
+                raise UserError(f"{rec.name or rec.operation_id.name}: count, extra qty, hours and size cannot be negative.")
